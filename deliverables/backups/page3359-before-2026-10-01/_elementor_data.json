[{"id":"2d3d2cd4","elType":"container","settings":[],"elements":[{"id":"58656509","elType":"widget","settings":{"html":"<style>\n\/* === CHINA MAIN PAGE CSS === *\/\n.fade-in{opacity:1!important;transform:none!important}\n.main-hero{background:linear-gradient(135deg,#0D1B2A 0%,#1a3a5c 50%,#0D1B2A 100%);color:#fff;padding:60px 24px 50px;text-align:center;position:relative;overflow:hidden;min-height:auto}\n.hero-deco,.orb,.lantern{display:none}\n.hero-content{max-width:800px;margin:0 auto;position:relative;z-index:1}\n.hero-flag{display:inline-flex;align-items:center;gap:8px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.2);border-radius:50px;padding:6px 16px;font-size:.85rem;margin-bottom:16px}\n.hero-flag .flag{font-size:1.2rem}\n.main-hero h1{font-size:clamp(1.6rem,4vw,2.4rem);font-weight:900;line-height:1.3;margin-bottom:14px;color:#ffffff}\n.main-hero h1 .gold{color:#C9A84C}\n.main-hero > .hero-content > p{color:rgba(255,255,255,.85);font-size:1rem;line-height:1.7;max-width:640px;margin:0 auto 20px}\n.hero-btns{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;margin-bottom:24px}\n.btn-red{background:#C8102E;color:#fff;padding:12px 28px;border-radius:50px;text-decoration:none;font-weight:700;font-size:.95rem}\n.btn-outline{background:transparent;color:#fff;border:2px solid rgba(255,255,255,.5);padding:12px 28px;border-radius:50px;text-decoration:none;font-weight:700;font-size:.95rem}\n.hero-stats{display:flex;justify-content:center;gap:32px;flex-wrap:wrap;border-top:1px solid rgba(255,255,255,.15);padding-top:20px}\n.hero-stat{text-align:center}\n.hero-stat .num{display:block;font-size:1.6rem;font-weight:900;color:#C9A84C}\n.hero-stat .label{font-size:.8rem;color:rgba(255,255,255,.7)}\n.scroll-hint{display:none}\n\/* === ABOUT === *\/\n.about{padding:48px 24px;background:#fff}\n.about .container{max-width:1100px;margin:0 auto}\n.about-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center}\n@media(max-width:768px