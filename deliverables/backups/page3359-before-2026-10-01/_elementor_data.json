om:10px}\n.why-item h4{font-size:.95rem;font-weight:800;color:#0D1B2A;margin-bottom:6px}\n.why-item p{font-size:.82rem;color:#666;line-height:1.6}\n.contact-bar-inner,.contact-info{display:flex;flex-wrap:wrap;gap:12px;justify-content:center;background:#0D1B2A;border-radius:12px;padding:16px 24px;margin-top:8px}\n.contact-item{display:flex;align-items:center;gap:8px;color:#fff;font-size:.9rem}\n.contact-item a{color:#C9A84C;text-decoration:none}\n.c-icon{font-size:1rem}\n\/* === CARDS === *\/\n.cards-section{padding:40px 20px 60px;background:#fff}\n.cards-title{text-align:center;font-size:1.6rem;font-weight:900;margin-bottom:32px;color:#0D1B2A}\n.cards-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:24px;max-width:1100px;margin:0 auto}\n.card{background:#fff;border-radius:16px;overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,.08);transition:all .4s;text-decoration:none;color:inherit;display:block}\n.card:hover{transform:translateY(-6px);box-shadow:0 16px 40px rgba(0,0,0,.14)}\n.card-img{height:180px;overflow:hidden;position:relative}\n.card-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s}\n.card:hover .card-img img{transform:scale(1.05)}\n.card-num{position:absolute;top:10px;right:10px;width:28px;height:28px;border-radius:50%;background:#C9A84C;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:.8rem}\n.card-body{padding:16px}\n.card-body h3{font-size:1rem;font-weight:800;color:#0D1B2A;margin-bottom:6px}\n.card-body p{color:#666;font-size:.85rem;line-height:1.6;margin-bottom:12px}\n.card-link{color:#C9A84C;font-weight:700;font-size:.85rem}\n\/* === CTA === *\/\n.cta{padding:50px 20px;text-align:center;background:linear-gradient(135deg,#1a5276,#0D1B2A)}\n.cta-box{max-width:580px;margin:0 auto}\n.cta-box h2{color:#fff;font-size:1.6rem;font-weight:900;margin-bottom:12px}\n.cta-box p{color:rgba(255,255,255,.85);margin-bottom:24px;font-size:.95rem}\n.whatsapp-btn{display:inline-flex;align-items:center;gap:10px;background:#25D366;color:#fff;padding:13px 28px;border-radius:50px;font-weight:800;text-decoration:none;font-size:.95rem;box-shadow:0 4px 20px rgba(37,211,102,.4)}\n<\/style>\n\n\n<section class=\"main-hero\" style=\"background-image:linear-gradient(rgba(20,15,10,.6),rgba(20,15,10,.6)),url('https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/06\/arcadia-china-greatwall-1.jpg');background-size:cover;background-position:center;background-repeat:no-repeat;\">\n<div class=\"hero-deco\">\n<div class=\"orb orb-1\"><\/div>\n<div class=\"orb orb-2\"><\/div>\n<div class=\"orb orb-3\"><\/div>\n<\/div>\n<div class=\"lantern lantern-1\">\ud83c\udfee<\/div>\n<div class=\"lantern lantern-2\">\ud83c\udfee<\/div>\n<div class=\"lantern lantern-3\">\ud83c\udfee<\/div>\n<div class=\"hero-content\">\n<div class=\"hero-flag\">\n            <span class=\"flag\">\ud83c\udde8\ud83c\uddf3<\/span><br \/>\n            \u0648\u062c\u0647\u0629 \u062c\u062f\u064a\u062f\u0629 \u0644\u0639\u0627\u0645 2026 \u0645\u0639 \u0623\u0631\u0643\u0627\u062f\u064a\u0627\n        <\/div>\n<h1>\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a <span class=\"gold\">\u0627\u0644\u0635\u064a\u0646<\/span> <br \/>\u0627\u0643\u062a\u0634\u0641 \u062d\u0636\u0627\u0631\u0629 \u0627\u0644\u062e\u0645\u0633\u0629 \u0622\u0644\u0627\u0641 \u0639\u0627\u0645<\/h1>\n<p>\u0645\u0646 \u0633\u0648\u0631 \u0627\u0644\u0635\u064a\u0646 \u0627\u0644\u0639\u0638\u064a\u0645 \u0625\u0644\u0649 \u0646\u0627\u0637\u062d\u0627\u062a \u0633\u062d\u0627\u0628 \u0634\u0646\u063a\u0647\u0627\u064a\u060c \u0648\u0645\u0646 \u0645\u0639\u0627\u0631\u0636 \u0642\u0648\u0627\u0646\u063a\u062a\u0634\u0648 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629 \u0625\u0644\u0649 \u0645\u0639\u0627\u0628\u062f \u0634\u064a\u0622\u0646 \u0627\u0644\u0639\u0631\u064a\u0642\u0629 \u2014 \u0628\u0631\u0627\u0645\u062c \u0633\u064a\u0627\u062d\u064a\u0629 \u0648\u062a\u062c\u0627\u0631\u064a\u0629 \u0645\u062a\u0643\u0627\u0645\u0644\u0629 \u0645\u0639 \u0645\u0631\u0634\u062f\u064a\u0646 \u064a\u062a\u062d\u062f\u062b\u0648\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629<\/p>\n<div class=\"hero-btns\">\n            <a href=\"#contact\" class=\"btn btn-red\">\ud83d\udcde \u0627\u062d\u062c\u0632 \u0631\u062d\u0644\u062a\u0643 \u0627\u0644\u0622\u0646<\/a>\n            <a href=\"#explore\" class=\"btn btn-outline\">\ud83d\uddfa\ufe0f \u0627\u0633\u062a\u0643\u0634\u0641 \u0627\u0644\u0648\u062c\u0647\u0627\u062a<\/a>\n        <\/div>\n<div class=\"hero-stats\">\n<div class=\"hero-stat\">\n                <span class=\"num\">+56<\/span><br \/>\n                <span class=\"label\">\u0645\u0648\u0642\u0639 \u062a\u0631\u0627\u062b \u0639\u0627\u0644\u0645\u064a<\/span>\n            <\/div>\n<div class=\"hero-stat\">\n                <span class=\"num\">5000+<\/span><br \/>\n                <span class=\"label\">\u0639\u0627\u0645 \u0645\u0646 \u0627\u0644\u062d\u0636\u0627\u0631\u0629<\/span>\n            <\/div>\n<div class=\"hero-stat\">\n                <span class=\"num\">350<\/span><br \/>\n                <span class=\"label\">\u0643\u0645\/\u0633\u0627\u0639\u0629 \u0642\u0637\u0627\u0631\u0627\u062a<\/span>\n            <\/div>\n<\/div>\n<\/div>\n<div class=\"scroll-hint\"><span><\/span><\/div>\n<\/section>\n\n<section class=\"about\">\n<div class=\"container\">\n<div class=\"about-grid\">\n<div class=\"about-text fade-in\">\n<div class=\"section-tag\">\ud83d\udc09 \u0639\u0646 \u0627\u0644\u0648\u062c\u0647\u0629<\/div>\n<h2>\u0644\u0645\u0627\u0630\u0627 <span class=\"red\">\u0627\u0644\u0635\u064a\u0646<\/span> \u0648\u062c\u0647\u062a\u0643 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0627\u0644\u0642\u0627\u062f\u0645\u0629\u061f<\/h2>\n<p>\u062a\u064f\u0639\u062f \u0627\u0644\u0635\u064a\u0646 \u0648\u0627\u062d\u062f\u0629 \u0645\u0646 \u0623\u0639\u0638\u0645 \u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645. \u062f\u0648\u0644\u0629 \u062a\u062c\u0645\u0639 \u0628\u064a\u0646 \u062a\u0627\u0631\u064a\u062e \u0639\u0631\u064a\u0642 \u064a\u0645\u062a\u062f \u0644\u062e\u0645\u0633\u0629 \u0622\u0644\u0627\u0641 \u0639\u0627\u0645 \u0648\u062d\u062f\u0627\u062b\u0629 \u0645\u0630\u0647\u0644\u0629 \u062a\u062a\u062c\u0644\u0649 \u0641\u064a \u0645\u062f\u0646\u0647\u0627 \u0627\u0644\u0639\u0635\u0631\u064a\u0629 \u0648\u0628\u0646\u064a\u062a\u0647\u0627 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0627\u0644\u0645\u062a\u0637\u0648\u0631\u0629. \u062a\u0636\u0645 \u0627\u0644\u0635\u064a\u0646 \u0623\u0643\u062b\u0631 \u0645\u0646 56 \u0645\u0648\u0642\u0639\u0627\u064b \u0645\u0633\u062c\u0644\u0627\u064b \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u062a\u0631\u0627\u062b \u0627\u0644\u0639\u0627\u0644\u0645\u064a \u0644\u0644\u064a\u0648\u0646\u0633\u0643\u0648\u060c \u0648\u062a\u0645\u062a\u0644\u0643 \u0623\u0643\u0628\u0631 \u0634\u0628\u0643\u0629 \u0642\u0637\u0627\u0631\u0627\u062a \u0641\u0627\u0626\u0642\u0629 \u0627\u0644\u0633\u0631\u0639\u0629 \u0641\u064a \u0627\u0644\u0639\u0627\u0644\u0645.<\/p>\n<p>\u0648\u062a\u0642\u062f\u0651\u0645 \u0634\u0631\u0643\u0629 \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0628\u0631\u0627\u0645\u062c \u0633\u064a\u0627\u062d\u064a\u0629 \u0648\u062a\u062c\u0627\u0631\u064a\u0629 \u0645\u062a\u0643\u0627\u0645\u0644\u0629 \u0641\u064a \u0627\u0644\u0635\u064a\u0646 \u062a\u0634\u0645\u0644 \u0627\u0644\u0625\u0642\u0627\u0645\u0629 \u0641\u064a \u0641\u0646\u0627\u062f\u0642 \u0645\u062e\u062a\u0627\u0631\u0629\u060c \u0627\u0644\u062c\u0648\u0644\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0645\u0639 \u0645\u0631\u0634\u062f\u064a\u0646 \u064a\u062a\u062d\u062f\u062b\u0648\u0646 \u0627\u0644\u0639\u0631\u0628\u064a\u0629\u060c \u0648\u0627\u0644\u062a\u0646\u0642\u0644 \u0628\u064a\u0646 