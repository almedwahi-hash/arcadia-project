{"content": "<div class=\"ukraine-notice\" style=\"background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%); border-right: 5px solid #ff9800; border-radius: 12px; padding: 20px 25px; margin-bottom: 30px; direction: ltr;\">\n  <div style=\"display: flex; align-items: center; gap: 12px; margin-bottom: 10px;\">\n    <span style=\"font-size: 24px;\">⚠️</span>\n    <strong style=\"font-size: 17px; color: #e65100;\">Important alert</strong>\n  </div>\n  <p style=\"margin: 0; color: #4e342e; font-size: 15px; line-height: 1.8;\">\n    Tourist trips to Ukraine <strong>Temporarily suspended</strong> Due to current circumstances. We are closely following developments and will announce the resumption of our flights as soon as conditions improve.\n    <br>To inquire about our other currently available destinations, <a href=\"https://wa.me/77064007561?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%D8%8C%20%D8%A3%D8%B1%D9%8A%D8%AF%20%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%81%D8%B3%D8%A7%D8%B1%20%D8%B9%D9%86%20%D8%A7%D9%84%D9%88%D8%AC%D9%87%D8%A7%D8%AA%20%D8%A7%D9%84%D9%85%D8%AA%D8%A7%D8%AD%D8%A9\" style=\"color: #e65100; font-weight: 700; text-decoration: underline;\">Contact us via WhatsApp</a>.\n  </p>\n</div>\n\n<style>\n.entry-content,.post-content,article,.site-main,main{background:#f5f7fa !important}\n.wp-block-group,.is-layout-flow{background:#f5f7fa !important}\nbody.page-id-600{background:#f5f7fa !important}\n.ast-separate-container .ast-article-single{background:#f5f7fa !important;padding:0 !important}\n.ast-separate-container .entry-content{padding:0 !important}\n.ast-separate-container .ast-article-post, .ast-separate-container .ast-article-single{background:transparent !important}\n</style>\n<link href=\"https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;900&display=swap\" rel=\"stylesheet\">\n<style>\n:root{--blue:#003878;--blue2:#0055a5;--gold:#FFD700;--dark:#00D1B2A;--white:#fff;--gray :#f5f5f5;--text:#2C3E50;--red:#DC2626;--green:#16A34A;--teal:#0891B2;--purple:#8B5CF6}\n*{margin:0;padding:0;box-sizing:border-box}\n.prog-page{font-family:'Tajawal',sans-serif;direction:rtl;color:var(--text);background:#f5f5f5}\n\n/* HERO */\n.prog-hero{position:relative;min-height:40vh;display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden;padding:70px 20px}\n.prog-hero::before{content:'';position:absolute;inset:0;background:url('https://arcadia-tour.com/wp-content/uploads/2026/03/p03-sophia-cathedral.jpg') center/cover no-repeat}\n.prog-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(0,56,120,0.92),rgba(0,85,165,0.85))}\n.prog-hero-inner{position:relative;z-index:2;max-width:700px}\n.prog-hero h1{font-size:clamp(1.8rem,4vw,3rem);font-weight:900;color:var(--white);margin-bottom:12px}\n.prog-hero p{font-size:1.15rem;color:rgba(255,255,255,0.85);line-height:1.8}\n.prog-hero .hero-count{display:inline-block;margin-top:18px;background:rgba(255,215,0,0.15);border:1px solid rgba(255,215,0,0.4);color:var(--gold);padding:6px 24px;border-radius:50px;font-size:14px;font-weight:700}\n\n/* GRID */\n.prog-grid-wrap{max-width:1240px;margin:0 auto;padding:30px 20px 50px;background:#f5f5f5}\n.prog-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px}\n\n/* CARD */\n.prog-card{background:var(--white);border-radius:16px;overflow:hidden;box-shadow:0 2px 16px rgba(0,0,0,0.07);transition:all .35s;display:flex;flex-direction:column}\n.prog-card:hover{transform:translateY(-6px);box-shadow:0 12px 36px rgba(0,0,0,0.13)}\n.prog-card-img{position:relative;height:220px;overflow:hidden}\n.prog-card-img img{width:100%;height:100%;object-fit:cover;transition:transform .4s}\n.prog-card:hover .prog-card-img img{transform:scale(1.06)}\n.prog-badge{position:absolute;top:12px;right:12px;color:#fff;padding:5px 14px;border-radius:8px;font-size:.8rem;font-weight:700;letter-spacing:.3px}\n.prog-card-body{padding:20px;flex:1;display:flex;flex-direction:column}\n.prog-card-body h3{font-size:1.05rem;font-weight:800;color:var(--dark);margin-bottom:10px;line-height:1.5}\n.prog-meta{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:14px;font-size:.88rem;color:#666}\n.prog-meta span{display:flex;align-items:center;gap:4px}\n.prog-price-row{display:flex;align-items:center;gap:10px;margin-bottom:16px;flex-wrap:wrap}\n.prog-price-old{font-size:.95rem;color:#999;text-decoration:line-through}\n.prog-price{font-size:1.4rem;font-weight:900}\n.prog-price.sale{color:var(--red)}\n.prog-price.normal{color:var(--blue)}\n.prog-wa{display:inline-flex;align-items:center;justify-content:center;gap:8px;background:var(--green);color:#fff;padding:10px 0;border-radius:10px;font-size:.9rem;font-weight:700;text-decoration:none;transition:.3s;margin-top:auto;text-align:center}\n.prog-wa:hover{background:#15803d;transform:translateY(-1px)}\n.prog-wa svg{width:18px;height:18px;fill:currentColor;flex-shrink:0}\n\n/* CTA */\n.prog-cta{padding:60px 20px;text-align:center;background:#f5f5f5}\n.prog-cta-box{max-width:700px;margin:0 auto;background:linear-gradient(135deg,var(--dark),#1A3A5C);border-radius:20px;padding:50px 36px;color:var(--white)}\n.prog-cta-box h2{font-size:1.8rem;font-weight:900;margin-bottom:12px}\n.prog-cta-box p{color:rgba(255,255,255,0.7);margin-bottom:24px;font-size:1.05rem}\n.prog-cta-btn{background:var(--green);color:#fff;padding:14px 36px;border-radius:50px;font-size:1rem;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:10px;transition:.3s}\n.prog-cta-btn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(37,211,102,0.4)}\n.prog-cta-btn svg{width:22px;height:22px;fill:currentColor}\n\n@media(max-width:640px){.prog-grid{grid-template-columns:1fr}.prog-cta-box{padding:36px 20px}}\n</style>\n\n<div class=\"prog-page\" style=\"background:#f5f7fa !important;margin:0;padding:0;\">\n\n<!-- HERO -->\n<section class=\"prog-hero\">\n  <div class=\"prog-hero-inner\">\n    <h1>&#x1F30D; Tourism programs to Ukraine</h1>\n    <p>The best tourist programs and trips in Ukraine - from Kiev, Lviv and Odessa to the Carpathian Mountains and Bucaville</p>\n    <span class=\"hero-count\">9 programs and excursions available</span>\n  </div>\n</section>\n\n<!-- CARDS GRID -->\n<div class=\"prog-grid-wrap\" style=\"background:#f5f7fa !important;\">\n  <div class=\"prog-grid\">\n\n    <!-- 1 -->\n    <div class=\"prog-card\">\n      <div class=\"prog-card-img\">\n        <img src=\"https://arcadia-tour.com/wp-content/uploads/2026/03/p01-bukovel-ski.jpg\" alt=\"Kyiv Lviv Bucaville trip\" loading=\"lazy\">\n        <span class=\"prog-badge\" style=\"background:#8B5CF6\">⛷️ Including Bucaville</span>\n      </div>\n      <div class=\"prog-card-body\">\n        <h3>Tourist trip Kyiv - Lviv - Bucaville</h3>\n        <div class=\"prog-meta\">\n          <span>&#x1F4CD; Kyiv, Lviv, Bucaville</span>\n          <span>&#x1F319; 12 days / 11 nights</span>\n        </div>\n        <div class=\"prog-price-row\">\n          <span class=\"prog-price normal\">$1,120</span>\n        </div>\n        <a href=\"https://wa.me/77064007561?text=%D8%A3%D8%B1%D9%8A%D8%AF%20%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%81%D8%B3%D8%A7%D8%B1%20%D8%B9%D9%86%20%D8%B1%D8%AD%D9%84%D8%A9%20%D9%83%D9%8A%D9%8A%D9%81%20%D9%84%D9%81%D9%8A%D9%81%20%D8%A8%D9%88%D9%83%D8%A7%D9%81%D9%8A%D9%84%2012%20%D9%8A%D9%88%D9%85\" class=\"prog-wa\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"/></svg>\n          Book via WhatsApp\n        </a>\n      </div>\n    </div>\n\n    <!-- 2 -->\n    <div class=\"prog-card\">\n      <div class=\"prog-card-img\">\n        <img src=\"https://arcadia-tour.com/wp-content/uploads/2026/03/p02-kyiv-lviv-street.jpg\" alt=\"Tourist program Kyiv Lviv\" loading=\"lazy\">\n        <span class=\"prog-badge\" style=\"background:#003878\">&#x1F3D9;️ Kyiv – Lviv</span>\n      </div>\n      <div class=\"prog-card-body\">\n        <h3>Tourist program 7 days / 6 nights</h3>\n        <div class=\"prog-meta\">\n          <span>&#x1F4CD; Kyiv, Lviv</span>\n          <span>&#x1F319; 7 days / 6 nights</span>\n        </div>\n        <div class=\"prog-price-row\">\n          <span class=\"prog-price-old\">$800</span>\n          <span class=\"prog-price sale\">$799</span>\n        </div>\n        <a href=\"https://wa.me/77064007561?text=%D8%A3%D8%B1%D9%8A%D8%AF%20%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%81%D8%B3%D8%A7%D8%B1%20%D8%B9%D9%86%20%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%207%20%D8%A3%D9%8A%D8%A7%D9%85%20%D9%83%D9%8A%D9%8A%D9%81%20%D9%84%D9%81%D9%8A%D9%81\" class=\"prog-wa\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z\"/></svg>\n          Book via WhatsApp\n        </a>\n      </div>\n    </div>\n\n    <!-- 3 -->\n    <div class=\"prog-card\">\n      <div class=\"prog-card-img\">\n        <img src=\"https://arcadia-tour.com/wp-content/uploads/2026/03/p03-sophia-cathedral.jpg\" alt=\"Kyiv tourist program\" loading=\"lazy\">\n        <span class=\"prog-badge\" style=\"background:#0055a5\">&#x1F3DB;️ Kyiv</span>\n      </div>\n      <div class=\"prog-card-body\">\n        <h3>A tourist program to Kyiv 5 days / 4 nights</h3>\n        <div class=\"prog-meta\">\n          <span>&#x1F4CD; Kyiv</span>\n          <span>&#x1F319; 5 days / 4 nights</span>\n        </div>\n        <div class=\"prog-price-row\">\n          <span class=\"prog-price normal\">$465</span>\n        </div>\n        <a href=\"https://wa.me/77064007561?text=%D8%A3%D8%B1%D9%8A%D8%AF%20%D8%A7%D9%84%D8%A7%D8%B3%D8%AA%D9%81%D8%B3%D8%A7%D8%B1%20%D8%B9%D9%86%20%D8%A8%D8%B1%D9%86%D8%A7%D9%85%D8%AC%20%D9%83%D9%8A%D9%8A%D9%81%205%20%D8%A3%D9%8A%D8%A7%D9%85\" class=\"prog-wa\">\n          <svg viewBox=\"0 0 24 24\"><path d=\"M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.1