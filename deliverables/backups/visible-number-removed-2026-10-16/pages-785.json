{"content": "<!-- wp:html -->\n<!-- Hero -->\n  <h1 style=\"color: rgb(255, 255, 255); font-size: 42px; margin-bottom: 20px; font-weight: 700; text-shadow: rgba(0, 0, 0, 0.4) 0px 2px 12px;\">🏷️ العروض والحجوزات</h1>\n  <p style=\"color: rgb(241, 244, 248); font-size: 18px; margin: 14px auto 0px; max-width: 720px;\">احجز رحلتك الآن بأفضل الأسعار مع خدمات متكاملة</p>\n<!-- Destinations Grid -->\n  <h2 style=\"text-align: center; font-size: 32px; margin-bottom: 40px; color: #1a1a2e;\">📍 الوجهات السياحية</h2>\n    <!-- كازاخستان -->\n      <img src=\"https://arcadia-tour.com/wp-content/uploads/2026/06/arcadia-astana-kazakhstan.jpg\" alt=\"كازاخستان\" style=\"width: 100%; height: 200px; object-fit: cover;\">\n        <h3 style=\"color: #1a1a2e; font-size: 22px; margin-bottom: 15px;\">🇰🇿 كازاخستان</h3>\n        <ul style=\"list-style: none; padding: 0; margin-bottom: 20px; color: #666;\">\n          <li style=\"margin-bottom: 8px;\">✓ برامج سياحية متنوعة</li>\n          <li style=\"margin-bottom: 8px;\">✓ حجز فنادق 4 نجوم</li>\n          <li style=\"margin-bottom: 8px;\">✓ استخراج تأشيرة</li>\n          <li style=\"margin-bottom: 8px;\">✓ جولات سياحية</li>\n        </ul>\n        <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D9%83%D8%A7%D8%B2%D8%A7%D8%AE%D8%B3%D8%AA%D8%A7%D9%86/\" style=\"display: block; background: #0ea5e9; color: #ffffff; text-align: center; padding: 12px 20px; border-radius: 8px; font-weight: 600; text-decoration: none;\">استكشف العروض</a>\n    <!-- روسيا -->\n      <img src=\"https://arcadia-tour.com/wp-content/uploads/2026/06/arcadia-moscow-red-square.jpg\" alt=\"روسيا\" style=\"width: 100%; height: 200px; object-fit: cover;\">\n        <h3 style=\"color: #1a1a2e; font-size: 22px; margin-bottom: 15px;\">🇷🇺 روسيا</h3>\n        <ul style=\"list-style: none; padding: 0; margin-bottom: 20px; color: #666;\">\n          <li style=\"margin-bottom: 8px;\">✓ برامج موسكو السياحية</li>\n          <li style=\"margin-bottom: 8px;\">✓ حجز فنادق فاخرة</li>\n          <li style=\"margin-bottom: 8px;\">✓ جولات ثقافية</li>\n          <li style=\"margin-bottom: 8px;\">✓ دعم عربي كامل</li>\n        </ul>\n        <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D8%B1%D9%88%D8%B3%D9%8A%D8%A7/\" style=\"display: block; background: #0ea5e9; color: #ffffff; text-align: center; padding: 12px 20px; border-radius: 8px; font-weight: 600; text-decoration: none;\">استكشف العروض</a>\n    <!-- بولندا -->\n      <img src=\"https://arcadia-tour.com/wp-content/uploads/2026/06/arcadia-poland-krakow-1.jpg\" alt=\"بولندا\" style=\"width: 100%; height: 200px; object-fit: cover;\">\n        <h3 style=\"color: #1a1a2e; font-size: 22px; margin-bottom: 15px;\">🇵🇱 بولندا</h3>\n        <ul style=\"list-style: none; padding: 0; margin-bottom: 20px; color: #666;\">\n          <li style=\"margin-bottom: 8px;\">✓ برامج وارسو وكراكوف</li>\n          <li style=\"margin-bottom: 8px;\">✓ سياحة شتوية في زاكوباني</li>\n          <li style=\"margin-bottom: 8px;\">✓ جولات تاريخية</li>\n          <li style=\"margin-bottom: 8px;\">✓ أسعار تنافسية</li>\n        </ul>\n        <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D8%A8%D9%88%D9%84%D9%86%D8%AF%D8%A7/\" style=\"display: block; background: #0ea5e9; color: #ffffff; text-align: center; padding: 12px 20px; border-radius: 8px; font-weight: 600; text-decoration: none;\">استكشف العروض</a>\n    <!-- أوزبكستان -->\n      <img src=\"https://arcadia-tour.com/wp-content/uploads/2026/06/arcadia-uzbekistan-registan-samarkand.jpg\" alt=\"أوزبكستان\" style=\"width: 100%; height: 200px; object-fit: cover;\">\n        <h3 style=\"color: #1a1a2e; font-size: 22px; margin-bottom: 15px;\">🇺🇿 أوزبكستان</h3>\n        <ul style=\"list-style: none; padding: 0; margin-bottom: 20px; color: #666;\">\n          <li style=\"margin-bottom: 8px;\">✓ سمرقند وبخارى وخيفا</li>\n          <li style=\"margin-bottom: 8px;\">✓ طريق الحرير التاريخي</li>\n          <li style=\"margin-bottom: 8px;\">✓ مهرجانات ثقافية</li>\n          <li style=\"margin-bottom: 8px;\">✓ أسعار مميزة</li>\n        </ul>\n        <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D8%A3%D9%88%D8%B2%D8%A8%D9%83%D8%B3%D8%AA%D8%A7%D9%86/\" style=\"display: block; background: #0ea5e9; color: #ffffff; text-align: center; padding: 12px 20px; border-radius: 8px; font-weight: 600; text-decoration: none;\">استكشف العروض</a>\n    <!-- الصين -->\n      <img src=\"https://arcadia-tour.com/wp-content/uploads/2026/06/arcadia-china-greatwall-1.jpg\" alt=\"الصين\" style=\"width: 100%; height: 200px; object-fit: cover;\">\n        <h3 style=\"color: #1a1a2e; font-size: 22px; margin-bottom: 15px;\">🇨🇳 الصين</h3>\n        <ul style=\"list-style: none; padding: 0; margin-bottom: 20px; color: #666;\">\n          <li style=\"margin-bottom: 8px;\">✓ برامج سياحية مع مرافق عربي</li>\n          <li style=\"margin-bottom: 8px;\">✓ مكتب أركاديا في قوانزو</li>\n          <li style=\"margin-bottom: 8px;\">✓ فنادق ومطاعم حلال</li>\n          <li style=\"margin-bottom: 8px;\">✓ مساعدة كاملة في التأشيرة</li>\n        </ul>\n        <a href=\"https://arcadia-tour.com/china-main/\" style=\"display: block; background: #0ea5e9; color: #ffffff; text-align: center; padding: 12px 20px; border-radius: 8px; font-weight: 600; text-decoration: none;\">استكشف العروض</a>\n<!-- العروض المميزة -->\n    <h2 style=\"text-align: center; font-size: 32px; margin-bottom: 40px; color: #1a1a2e;\">🔥 العروض المميزة</h2>\n        الأكثر طلباً\n        <h3 style=\"color: #1a1a2e; font-size: 22px; margin: 0;\">برنامج كازاخستان 7 أيام</h3>\n        📅 المدة: 7 أيام / 6 ليالي\n        🏨 فنادق 4 نجوم\n        🍳 الإفطار اليومي\n        🚗 المواصلات الداخلية\n        🎯 جولات سياحية\n          السعر يبدأ من<br>\n          $620\n           / للشخص\n        <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D9%83%D8%A7%D8%B2%D8%A7%D8%AE%D8%B3%D8%AA%D8%A7%D9%86/\" style=\"background: #C9A84C; color: white; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: 700;\">احجز الآن</a>\n        روسيا الشاملة\n        <h3 style=\"color: #1a1a2e; font-size: 22px; margin: 0;\">موسكو + سانت بطرسبرغ 10 أيام</h3>\n        📅 المدة: 10 أيام / 9 ليالي\n        🏙️ مدينتان\n        🗣️ مرشد عربي\n        🏨 فنادق 4 نجوم\n        ✈️ تنقلات داخلية\n          السعر يبدأ من<br>\n          $1,066\n           / للشخص\n        <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D8%B1%D9%88%D8%B3%D9%8A%D8%A7/\" style=\"background: #C9A84C; color: white; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: 700;\">احجز الآن</a>\n    <!-- بولندا -->\n        🇵🇱 بولندا المميزة\n        <h3 style=\"color: #1a1a2e; font-size: 22px; margin: 0;\">كراكوف + زاكوباني 7 أيام</h3>\n        📅 المدة: 7 أيام / 6 ليالي\n        🏰 مدينة تاريخية + جبال\n        🛖 أكواخ زاكوباني الفريدة\n        🏨 فنادق مختارة\n        🗣️ مرشد عربي\n          السعر يبدأ من<br>\n          $850\n           / للشخص\n        <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D8%A8%D9%88%D9%84%D9%86%D8%AF%D8%A7/\" style=\"background: #C9A84C; color: white; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: 700;\">احجز الآن</a>\n    <!-- أوزبكستان -->\n        🇺🇿 طريق الحرير\n        <h3 style=\"color: #1a1a2e; font-size: 22px; margin: 0;\">سمرقند + بخارى + طشقند 8 أيام</h3>\n        📅 المدة: 8 أيام / 7 ليالي\n        🕌 3 مدن تاريخية\n        🐪 تجربة طريق الحرير\n        🏨 فنادق 4 نجوم\n        🍽️ مطابخ حلال مضمون\n          السعر يبدأ من<br>\n          $750\n           / للشخص\n        <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D8%A3%D9%88%D8%B2%D8%A8%D9%83%D8%B3%D8%AA%D8%A7%D9%86/\" style=\"background: #C9A84C; color: white; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: 700;\">احجز الآن</a>\n    <!-- الصين -->\n        🇨🇳 الصين الحضارة\n        <h3 style=\"color: #1a1a2e; font-size: 22px; margin: 0;\">بكين + شنغهاي + شيآن 9 أيام</h3>\n        📅 المدة: 9 أيام / 8 ليالي\n        🏯 سور الصين العظيم\n        🚄 قطار فائق السرعة\n        🏨 فنادق 4-5 نجوم\n        🕌 مطاعم حلال مضمون\n          السعر يبدأ من<br>\n          $1,200\n           / للشخص\n        <a href=\"https://arcadia-tour.com/china-main/\" style=\"background: #C9A84C; color: white; padding: 12px 30px; border-radius: 8px; text-decoration: none; font-weight: 700;\">احجز الآن</a>\n<!-- CTA تواصل -->\n  <!-- ARCADIA SEO CONTENT 2026-10-01: START -->\n<style>\n  .ar-seo{max-width:960px;margin:0 auto;padding:56px 20px;line-height:1.95;color:#2C3E50}\n  .ar-seo h2{font-size:clamp(1.5rem,3vw,2.1rem);font-weight:900;color:#0D1B2A;margin:40px 0 14px}\n  .ar-seo h3{font-size:1.15rem;font-weight:800;color:#1A2E42;margin:22px 0 8px}\n  .ar-seo p{margin:0 0 14px;font-size:1.05rem}\n  .ar-seo ul{margin:0 0 16px;padding-right:22px}\n  .ar-seo li{margin:6px 0}\n  .ar-seo table{width:100%;border-collapse:collapse;margin:12px 0 22px;font-size:.98rem}\n  .ar-seo th,.ar-seo td{border:1px solid #e3e8ee;padding:10px 12px;text-align:right;vertical-align:top}\n  .ar-seo th{background:#F4F6F8;color:#0D1B2A;font-weight:800}\n  .ar-seo .note{background:#FFF8E6;border-right:4px solid #C9A84C;padding:14px 18px;border-radius:10px;margin:14px 0 22px}\n  .ar-seo details{background:#F4F6F8;border-radius:12px;padding:14px 18px;margin:10px 0}\n  .ar-seo summary{font-weight:800;color:#0D1B2A;cursor:pointer}\n  .ar-seo a{color:#9a7520;font-weight:700}\n  .ar-seo .cta-inline{display:inline-block;background:#25D366;color:#fff;padding:12px 28px;border-radius:50px;font-weight:800;text-decoration:none;margin-top:6px}\n</style>\n<section class=\"ar-seo\" dir=\"rtl\">\n  <h2>كل برامج أركاديا في جدول واحد</h2>\n  <p>اختر الوجهة والمدة، واطلب عرض السعر على واتساب. الأسعار التالية تقديرية للشخص في غرفة مزدوجة، وتشمل الإقامة والنقل الخاص والمرشد أو المرافق العربي والجولات المذكورة، ولا تشمل الطيران الدولي. كل برنامج قابل للتعديل حسب عدد الأيام والأفراد ومستوى الفندق.</p>\n  <table>\n    <tr><th>الوجهة</th><th>البرنامج</th><th>المدة</th><th>السعر التقريبي</th></tr>\n    <tr><td rowspan=\"3\"><a href=\"/السياحة-في-كازاخستان/\">كازاخستان</a></td><td><a href=\"/السياحة-في-كازاخستان/kazakhstan-6-days/\">ألماتي كلاسيك</a></td><td>6 أيام</td><td>من 650 دولاراً</td></tr>\n    <tr><td><a href=\"/السياحة-في-كازاخستان/kazakhstan-7-days-2/\">ألماتي وأستانا</a></td><td>7 أيام</td><td>من 850 دولاراً</td></tr>\n    <tr><td><a href=\"/السياحة-في-كازاخستان/kazakhstan-10-days/\">كازاخستان الشاملة</a></td><td>10 أيام</td><td>من 1,250 دولاراً</td></tr>\n    <tr><td rowspan=\"3\"><a href=\"/السياحة-في-روسيا/\">روسيا</a></td><td><a href=\"/السياحة-في-روسيا/russia-7-days/\">موسكو الشاملة</a></td><td>7 أيام</td><td>من 900 دولار</td></tr>\n    <tr><td><a href=\"/السياحة-في-روسيا/russia-10-days/\">موسكو وسانت بطرسبرغ</a></td><td>10 أيام</td><td>من 1,350 دولاراً</td></tr>\n    <tr><td><a href=\"/السياحة-في-روسيا/russia-12-days/\">الجولة الكاملة</a></td><td>12 يوماً</td><td>من 1,650 دولاراً</td></tr>\n    <tr><td rowspan=\"2\"><a href=\"/السياحة-في-بولندا/\">بولندا</a></td><td><a href=\"/السياحة-في-بولندا/برامج-سياحيه-في-بولندا/\">كراكوف وزاكوباني</a></td><td>6 أيام</td><td>من 800 دولار</td></tr>\n    <tr><td>وارسو وكراكوف وزاكوباني</td><td>8 أيام</td><td>من 1,100 دولار</td></tr>\n    <tr><td rowspan=\"2\"><a href=\"/السياحة-في-أوزبكستان/\">أوزبكستان</a></td><td><a href=\"/uzbekistan-7-days-itinerary/\">طريق الحرير الكلاسيكي</a></td><td>7 أيام</td><td>من 750 دولاراً</td></tr>\n    <tr><td>كازاخستان وأوزبكستان</td><td>10 أيام</td><td>من 1,300 دولار</td></tr>\n    <tr><td rowspan=\"2\"><a href=\"/china-main/\">الصين</a></td><td><a href=\"/china-programs/\">بكين وشنغهاي</a></td><td>8 أيام</td><td>من 1,200 دولار</td></tr>\n    <tr><td><a href=\"/china-business/\">قوانزو للتجار</a></td><td>6 أيام</td><td>من 800 دولار</td></tr>\n  </table>\n\n  <h2>عروض الموسم حسب الوقت</h2>\n  <ul>\n    <li><strong>الصيف (يونيو – أغسطس):</strong> كازاخستان وبولندا للهروب من الحر، والليالي البيضاء في سانت بطرسبرغ. احجزوا قبل شهرين لأن الفنادق تمتلئ.</li>\n    <li><strong>إجازة منتصف العام والشتاء (ديسمبر – فبراير):</strong> ثلوج شيمبولاك في ألماتي، أسواق الكريسماس في كراكوف، وموسكو الثلجية بأسعار أقل من الصيف.</li>\n    <li><strong>الربيع والخريف:</strong> أوزبكستان في أفضل حالاتها (نوروز في مارس)، والصين في أبريل وأكتوبر مع معرض كانتون للتجار.</li>\n    <li><strong>العيدين:</strong> برامج قصيرة من 5 أيام في ألماتي أو طشقند بدون تأشيرة؛ تُحجز قبل 6 أسابيع.</li>\n  </ul>\n  <p>تفاصيل كل موسم في <a href=\"/best-time-family-travel/\">أفضل وقت للسفر للعوائل 2026</a>، وتكلفة كل وجهة في أدلة الأسعار: <a href=\"/kazakhstan-family-trip-cost-2026/\">كازاخستان</a>، <a href=\"/russia-family-trip-cost-2026/\">روسيا</a>، <a href=\"/poland-family-trip-cost/\">بولندا</a>، <a href=\"/uzbekistan-family-trip-cost-2026/\">أوزبكستان</a>، <a href=\"/china-family-trip-cost-2026/\">الصين</a>.</p>\n\n  <h2>ماذا تشمل برامجنا؟</h2>\n  <ul>\n    <li><strong>الإقامة:</strong> فنادق 3 إلى 5 نجوم مجرّبة، مع غرف عائلية عند الطلب.</li>\n    <li><strong>النقل:</strong> استقبال وتوديع في المطار، وسيارة خاصة مع سائق طوال البرنامج.</li>\n    <li><strong>المرشد:</strong> مرشد أو مرافق ناطق بالعربية في كل الجولات.</li>\n    <li><strong>الجولات:</strong> كل المعالم المذكورة في البرنامج مع تذاكر الدخول.</li>\n    <li><strong>الدعم:</strong> رقم واتساب مباشر مع فريقنا 24 ساعة أثناء الرحلة.</li>\n    <li><strong>لا تشمل:</strong> الطيران الدولي، التأشيرة، الوجبات غير المذكورة، والمصاريف الشخصية.</li>\n  </ul>\n\n  <h2>كيف تختار البرنامج المناسب؟</h2>\n  <p>العائلات مع أطفال صغار: 6 إلى 7 أيام في وجهة واحدة (ألماتي، موسكو، أو كراكوف). المسافر الأول إلى آسيا الوسطى: كازاخستان أو أوزبكستان بدون تأشيرة. من يريد أوروبا بميزانية معقولة: بولندا. من يريد التاريخ والمدن الكبيرة: روسيا. من يجمع السياحة بالتجارة: الصين. مقارنة مفصلة في <a href=\"/choose-tour-program-family-guide/\">كيف تختار برنامجك السياحي العائلي</a> و<a href=\"/private-driver-vs-tour-package/\">سائق خاص أم برنامج شامل؟</a>، وأخطاء يجب تجنبها في <a href=\"/tour-booking-mistakes-family/\">أخطاء شائعة عند حجز برنامج سياحي</a>.</p>\n\n  <h2>خطوات الحجز</h2>\n  <ul>\n    <li><strong>1. أرسل على واتساب:</strong> الوجهة، التاريخ التقريبي، عدد الكبار والأطفال وأعمارهم، ومستوى الفندق المطلوب. (ماذا ترسل بالضبط؟ راجع <a href=\"/request-tour-program-info/\">دليل طلب البرنامج</a>.)</li>\n    <li><strong>2. خلال 24 ساعة:</strong> نرسل برنامجاً يوماً بيوم مع السعر النهائي.</li>\n    <li><strong>3. التأكيد:</strong> عربون بسيط، ثم تأكيدات الفنادق وبيانات السائق والمرشد.</li>\n    <li><strong>4. قبل السفر:</strong> مساعدة في التأشيرة إن لزم، وتعليمات الوصول.</li>\n  </ul>\n  <p><a class=\"cta-inline\" href=\"https://wa.me/77064007561?text=%D9%85%D8%B1%D8%AD%D8%A8%D8%A7%D9%8B%20%D8%A3%D8%B1%D9%83%D8%A7%D8%AF%D9%8A%D8%A7%D8%8C%20%D8%A3%D8%B1%D9%8A%D8%AF%20%D8%B9%D8%B1%D8%B6%20%D8%B3%D8%B9%D8%B1\" rel=\"noopener\">اطلب عرض سعر على واتساب +7 706 400 7561</a></p>\n\n  <h2>أسئلة شائعة عن الحجز</h2>\n  <details><summary>هل يمكن تعديل البرنامج؟</summary><p>نعم، كل البرامج قابلة للتعديل في الأيام والفنادق والجولات قبل التأكيد.</p></details>\n  <details><summary>كيف أدفع؟</summary><p>عربون للتأكيد عبر تحويل بنكي، والباقي حسب الاتفاق قبل السفر أو عند الوصول.</p></details>\n  <details><summary>هل الأسعار تشمل الطيران؟</summary><p>لا، ونساعدكم في اختيار أفضل الرحلات المباشرة من مدينتكم.</p></details>\n  <details><summary>متى أحجز؟</summary><p>قبل 3 إلى 4 أسابيع للوجهات بدون تأشيرة، وقبل 6 أسابيع لبولندا والصين لإنهاء التأشيرة.</p></details>\n  <details><summary>هل تنظمون رحلات للمجموعات والشركات؟</summary><p>نعم، باصات خاصة وبرامج مخصصة للقروبات من 10 أفراد فأكثر.</p></details>\n\n</section>\n<!-- ARCADIA SEO CONTENT 2026-10-01: END -->\n<h2 style=\"color: #ffffff; font-size: 32px; margin-bot