 border-radius: 50px; font-size: 1rem; font-weight: 700; text-decoration: none; border: 2px solid rgba(255,255,255,0.4); transition: all 0.3s; }\r\n  .btn-outline:hover { border-color: var(--gold); color: var(--gold); }\r\n  .intro { padding: 80px 20px; max-width: 900px; margin: 0 auto; text-align: center; }\r\n  .section-tag { display: inline-block; color: var(--gold); font-size: 14px; font-weight: 700; letter-spacing: 3px; margin-bottom: 12px; }\r\n  .intro h2 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 900; color: var(--dark); margin-bottom: 20px; }\r\n  .intro p { color: #555; font-size: 1.05rem; line-height: 1.9; }\r\n  .cards-section { padding: 20px 20px 80px; background: var(--gray); }\r\n  .cards-title { text-align: center; font-size: clamp(1.5rem, 3vw, 2.2rem); font-weight: 900; color: var(--dark); margin-bottom: 48px; }\r\n  .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px; max-width: 1200px; margin: 0 auto; }\r\n  .card { background: var(--white); border-radius: 20px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08); transition: all 0.4s; text-decoration: none; color: inherit; display: block; }\r\n  .card:hover { transform: translateY(-8px); box-shadow: 0 20px 50px rgba(0,0,0,0.15); }\r\n  .card-img { height: 200px; overflow: hidden; position: relative; }\r\n  .card-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s; }\r\n  .card:hover .card-img img { transform: scale(1.05); }\r\n  .card-num { position: absolute; top: 16px; right: 16px; background: var(--poland-red); color: white; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 900; font-size: 1rem; }\r\n  .card-body { padding: 24px; }\r\n  .card-body h3 { font-size: 1.15rem; font-weight: 800; color: var(--dark); margin-bottom: 10px; line-height: 1.4; }\r\n  .card-body p { color: #666; font-size: 0.95rem; line-height: 1.7; margin-bottom: 20px; }\r\n  .card-link { color: var(--gold); font-weight: 700; font-size: 0.95rem; }\r\n  .cta { padding: 80px 20px; text-align: center; }\r\n  .cta-box { max-width: 700px; margin: 0 auto; background: linear-gradient(135deg, var(--poland-dark) 0%, #3D0010 100%); border-radius: 24px; padding: 60px 40px; color: white; }\r\n  .cta-box h2 { font-size: 2rem; font-weight: 900; margin-bottom: 16px; }\r\n  .cta-box p { color: rgba(255,255,255,0.7); margin-bottom: 32px; font-size: 1.05rem; }\r\n  .whatsapp-btn { background: #25D366; color: white; padding: 14px 36px; border-radius: 50px; font-size: 1rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; transition: all 0.3s; }\r\n  .whatsapp-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(37,211,102,0.4); }\r\n  @media (max-width: 768px) { .cards-grid { grid-template-columns: 1fr; } .cta-box { padding: 40px 24px; } }\r\n<\/style>\r\n\r\n<section class=\"hero\" style=\"background-image:linear-gradient(rgba(15,23,42,.6),rgba(15,23,42,.6)),url('https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/06\/arcadia-poland-krakow-1.jpg');background-size:cover;background-position:center;background-repeat:no-repeat;\">\r\n  <div class=\"hero-content\">\r\n    <div class=\"hero-badge\">\ud83c\uddf5\ud83c\uddf1 \u062c\u0648\u0647\u0631\u0629 \u0623\u0648\u0631\u0648\u0628\u0627 \u0627\u0644\u0648\u0633\u0637\u0649<\/div>\r\n    <h1>\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0628\u0648\u0644\u0646\u062f\u0627<\/h1>\r\n    <p>\u0645\u0646 \u062a\u0627\u0631\u064a\u062e\u0647\u0627 \u0627\u0644\u063a\u0646\u064a \u0648\u062a\u0631\u0627\u062b\u0647\u0627 \u0627\u0644\u062b\u0642\u0627\u0641\u064a \u0625\u0644\u0649 \u0645\u0646\u0627\u0638\u0631\u0647\u0627 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629 \u0627\u0644\u062e\u0644\u0627\u0628\u0629 \u2014 \u0627\u0643\u062a\u0634\u0641 \u0648\u0627\u0631\u0633\u0648 \u0648\u0643\u0631\u0627\u0643\u0648\u0641 \u0648\u0632\u0627\u0643\u0648\u0628\u0627\u0646\u064a \u0645\u0639 \u062e\u062f\u0645\u0627\u062a\u0646\u0627 \u0627\u0644\u0645\u062a\u0645\u064a\u0632\u0629<\/p>\r\n    <div class=\"hero-btns\">\r\n      <a href=\"https:\/\/wa.me\/77064007561\" class=\"btn-gold\">\ud83d\udcac \u0627\u062d\u062c\u0632 \u0631\u062d\u0644\u062a\u0643 \u0627\u0644\u0622\u0646<\/a>\r\n      <a href=\"\/\u0627\u0644\u0639\u0631\u0648\u0636-\u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a\" class=\"btn-outline\">\ud83c\udf0d \u0627\u0633\u062a\u0639\u0631\u0636 \u0627\u0644\u0639\u0631\u0648\u0636<\/a>\r\n    <\/div>\r\n  <\/div>\r\n<\/section>\r\n\r\n<section class=\"intro\">\r\n  <span class=\"section-tag\">\u0639\u0646 \u0627\u0644\u0648\u062c\u0647\u0629<\/span>\r\n  <h2>\u0644\u0645\u0627\u0630\u0627 \u0628\u0648\u0644\u0646\u062f\u0627\u061f<\/h2>\r\n  <p>\u0645\u0631\u062d\u0628\u0627\u064b \u0628\u0643\u0645 \u0641\u064a \u0648\u062c\u0647\u062a\u0643\u0645 \u0627\u0644\u0645\u062b\u0627\u0644\u064a\u0629 \u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u062c\u0645\u0627\u0644 \u0648\u0631\u0648\u0639\u0629 \u0628\u0648\u0644\u0646\u062f\u0627. \u0646\u0647\u062f\u0641 \u0644\u062a\u0642\u062f\u064a\u0645 \u0623\u0641\u0636\u0644 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u062a\u064a\u062d \u0644\u0643\u0645 \u062a\u062c\u0631\u0628\u0629 \u0641\u0631\u064a\u062f\u0629 \u0648\u0645\u0645\u062a\u0639\u0629 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0628\u0644\u0627\u062f \u0627\u0644\u0631\u0627\u0626\u0639\u0629. \u0627\u0643\u062a\u0634\u0641\u0648\u0627 \u0645\u0639\u0646\u0627 \u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u0633\u0627\u062d\u0631\u0629 \u0645\u062b\u0644 \u0648\u0627\u0631\u0633\u0648 \u0648\u0643\u0631\u0627\u0643\u0648\u0641 \u0648\u0632\u0627\u0643\u0648\u0628\u0627\u0646\u064a\u060c \u0648\u0627\u0633\u062a\u0645\u062a\u0639\u0648\u0627 \u0628\u0627\u0644\u0645\u0646\u0627\u0638\u0631 \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629 \u0641\u064a \u062c\u0628\u0627\u0644 \u062a\u0627\u062a\u0631\u0627 \u0648\u0628\u062d\u064a\u0631\u0629 \u0645\u0627\u0633\u0648\u0631\u064a\u0627.<\/p>\r\n<\/section>\r\n\r\n<section class=\"cards-section\">\r\n  <h2 class=\"cards-title\">\u0627\u0643\u062a\u0634\u0641 \u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u0647 \u0639\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0628\u0648\u0644\u0646\u062f\u0627<\/h2>\r\n  <div class=\"cards-grid\">\r\n\r\n    <a href=\"\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0628\u0648\u0644\u0646\u062f\u0627-1\/\u0628\u0648\u0644\u0646\u062f\u0627\" class=\"card\">\r\n      <div class=\"card-img\">\r\n        <img src=\"https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/03\/pl-warsaw.jpg\" alt=\"\u0628\u0648\u0644\u0646\u062f\u0627\" loading=\"lazy\">\r\n        <div class=\"card-num\">1<\/div>\r\n      <\/div>\r\n      <div class=\"card-body\">\r\n        <h3>\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0628\u0648\u0644\u0646\u062f\u0627<\/h3>\r\n        <p>\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0628\u0648\u0644\u0646\u062f\u0627 \u0641\u0631\u0635\u0629 \u0631\u0627\u0626\u0639\u0629 \u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0625\u062d\u062f\u0649 \u0627\u0644\u062f\u0648\u0644 \u0627\u0644\u0623\u0648\u0631\u0648\u0628\u064a\u0629 \u0627\u0644\u0633\u0627\u062d\u0631\u0629 \u0630\u0627\u062a \u0627\u0644\u062c\u0645\u0627\u0644 \u0627\u0644\u0645\u062e\u0641\u064a \u0639\u0646 \u0627\u0644\u0639\u064a\u0648\u0646 \u0641\u064a \u0623\u0648\u0631\u0648\u0628\u0627 \u0627\u0644\u0648\u0633\u0637\u0649<\/p>\r\n        <span class=\"card-link\">\u0627\u0639\u0631\u0641 \u0623\u0643\u062b\u0631 \u2190<\/span>\r\n      <\/div>\r\n    <\/a>\r\n\r\n    <a href=\"\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0628\u0648\u0644\u0646\u062f\u0627-1\/\u0627\u0644\u0645\u062f\u0646-\u