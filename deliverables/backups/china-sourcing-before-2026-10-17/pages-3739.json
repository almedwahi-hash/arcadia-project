div class=\\\"step-text\\\"><strong>\ud83d\udea2<\/strong> \u0627\u0644\u0634\u062d\u0646 \u0648\u0627\u0644\u062c\u0645\u0627\u0631\u0643<\/div><\/div>\\n<div class=\\\"step\\\"><div class=\\\"step-num\\\">4<\/div><div class=\\\"step-text\\\"><strong>\ud83d\udce6<\/strong> \u0627\u0644\u062a\u0633\u0644\u064a\u0645 \u0644\u0628\u0627\u0628 \u0645\u0646\u0632\u0644\u0643<\/div><\/div>\\n<div class=\\\"step\\\"><div class=\\\"step-num\\\">5<\/div><div class=\\\"step-text\\\"><strong>\ud83e\udd1d<\/strong> \u062f\u0639\u0645 \u0645\u0627 \u0628\u0639\u062f \u0627\u0644\u0627\u0633\u062a\u0644\u0627\u0645<\/div><\/div><\/div>\\n<\/div>\\n<div class=\\\"cta-box\\\">\\n<h2>\u0627\u0628\u062f\u0623 \u0631\u062d\u0644\u0629 \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0627\u0644\u0622\u0646 \ud83d\ude80<\/h2>\\n<p>\u0623\u0631\u0633\u0644 \u0644\u0646\u0627 \u0648\u0627\u062a\u0633\u0627\u0628 \u0648\u0633\u0646\u0648\u0635\u0651\u0644\u0643 \u0628\u0627\u0644\u0645\u0648\u0631\u0651\u062f \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u062e\u0644\u0627\u0644 24 \u0633\u0627\u0639\u0629<\/p>\\n<a href=\\\"https:\/\/wa.me\/77064007561?text=\u0645\u0631\u062d\u0628\u0627\u064b%D8%8C%20\u0623\u0631\u064a\u062f%20\u0627\u0644\u0627\u0633\u062a\u0641\u0633\u0627\u0631%20\u0639\u0646%20\u062e\u062f\u0645\u0629%20\u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f%20\u0645\u0646%20\u0627\u0644\u0635\u064a\u0646\\\" class=\\\"btn-wa\\\" target=\\\"_blank\\\">\ud83d\udcac \u062a\u0648\u0627\u0635\u0644 \u0639\u0628\u0631 \u0648\u0627\u062a\u0633\u0627\u0628<\/a>\\n<\/div>\\n<\/div>\\n<!-- \/wp:html -->\"},\"elements\":[],\"widgetType\":\"text-editor\"}],\"isInner\":false}]","_elementor_page_settings":[]}}