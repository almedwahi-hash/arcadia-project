135deg,#1a1a1a,#001a0a);color:#fff;text-align:center;padding:60px 20px;}\\n.cta-box h2{color:#c9a84c;font-size:1.8rem;font-weight:800;margin-bottom:12px;}\\n.cta-box p{color:#ddd;margin-bottom:24px;}\\n<\/style>\\n<div class=\\\"arcadia-sourcing\\\">\\n<div class=\\\"hero-sourcing\\\" style=\\\"background-image:linear-gradient(rgba(10,18,33,.7),rgba(10,18,33,.7)),url('https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/07\/arcadia-sourcing-appliances.jpg');background-size:cover;background-position:center;background-repeat:no-repeat;\\\">\\n<h1>\ud83c\udfe0 \u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0623\u062f\u0648\u0627\u062a \u0645\u0646\u0632\u0644\u064a\u0629 \u0648\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0627\u062a \u0645\u0646 \u0627\u0644\u0635\u064a\u0646<\/h1>\\n<p>\u0623\u062c\u0647\u0632\u0629 \u0645\u0646\u0632\u0644\u064a\u0629 \u0648\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0627\u062a \u0645\u0646 \u0623\u0643\u0628\u0631 \u0645\u0635\u0627\u0646\u0639 \u0627\u0644\u0635\u064a\u0646 \u2014 \u062c\u0648\u062f\u0629 \u0639\u0627\u0644\u064a\u0629\u060c \u0636\u0645\u0627\u0646 \u0641\u062d\u0635 \u0645\u064a\u062f\u0627\u0646\u064a\u060c \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u062c\u0645\u0644\u0629<\/p>\\n<a href=\\\"https:\/\/wa.me\/77064007561?text=\u0645\u0631\u062d\u0628\u0627\u064b%D8%8C%20\u0623\u0631\u064a\u062f%20\u0627\u0644\u0627\u0633\u062a\u0641\u0633\u0627\u0631%20\u0639\u0646%20\u0627\u0633\u062a\u064a\u0631\u0627\u062f%20\u0627\u0644\u0623\u062f\u0648\u0627\u062a%20\u0627\u0644\u0645\u0646\u0632\u0644\u064a\u0629%20\u0645\u0646%20\u0627\u0644\u0635\u064a\u0646\\\" class=\\\"btn-wa\\\" target=\\\"_blank\\\">\ud83d\udcac \u062a\u0648\u0627\u0635\u0644 \u0639\u0628\u0631 \u0648\u0627\u062a\u0633\u0627\u0628<\/a><span class=\\\"arc-local-office-phone\\\" style=\\\"display:block;margin-top:12px;font-size:15px;\\\">\u0647\u0627\u062a\u0641 \u0645\u0643\u062a\u0628 \u0627\u0644\u0635\u064a\u0646:<\/span>\\n<\/div>\\n<div class=\\\"section\\\">\\n<h2 class=\\\"section-title\\\">\u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a <span>\u0627\u0644\u0645\u062a\u0627\u062d\u0629<\/span><\/h2>\\n<div class=\\\"products-grid\\\">\\n<div class=\\\"product-card\\\"><h3>\u2744\ufe0f \u062a\u0643\u064a\u064a\u0641 \u0648\u062a\u0628\u0631\u064a\u062f<\/h3><p>\u0645\u0643\u064a\u0651\u0641\u0627\u062a \u0633\u0628\u0644\u064a\u062a\u060c \u0645\u0631\u0627\u0648\u062d\u060c \u0645\u0628\u0631\u062f\u0627\u062a \u0647\u0648\u0627\u0621<\/p><\/div>\\n<div class=\\\"product-card\\\"><h3>\ud83c\udf73 \u0645\u0637\u0628\u062e \u0648\u0637\u0628\u062e<\/h3><p>\u0637\u0646\u0627\u062c\u0631\u060c \u0623\u062f\u0648\u0627\u062a \u0637\u0628\u062e\u060c \u0623\u062c\u0647\u0632\u0629 \u0645\u0637\u0628\u062e \u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629<\/p><\/div>\\n<div class=\\\"product-card\\\"><h3>\ud83d\udd0c \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0627\u062a \u0645\u0646\u0632\u0644\u064a\u0629<\/h3><p>\u0634\u0648\u0627\u062d\u0646\u060c \u0628\u0627\u0646\u0644 \u0643\u0647\u0631\u0628\u0627\u0626\u064a\u060c \u0648\u0635\u0644\u0627\u062a\u060c UPS<\/p><\/div>\\n<div class=\\\"product-card\\\"><h3>\ud83d\udca1 \u0625\u0636\u0627\u0621\u0629 LED<\/h3><p>\u0645\u0635\u0627\u0628\u064a\u062d LED\u060c \u0628\u0627\u0646\u0644 LED\u060c \u0634\u0631\u0627\u0626\u0637 \u0625\u0636\u0627\u0621\u0629<\/p><\/div>\\n<div class=\\\"product-card\\\"><h3>\ud83d\udecb\ufe0f \u0623\u062b\u0627\u062b \u0645\u0646\u0632\u0644\u064a<\/h3><p>\u0643\u0631\u0627\u0633\u064a\u060c \u0637\u0627\u0648\u0644\u0627\u062a\u060c \u0631\u0641\u0648\u0641\u060c \u062f\u064a\u0643\u0648\u0631\u0627\u062a \u0645\u0646\u0632\u0644\u064a\u0629<\/p><\/div>\\n<div class=\\\"product-card\\\"><h3>\ud83c\udfd7\ufe0f \u0623\u062f\u0648\u0627\u062a \u0628\u0646\u0627\u0621<\/h3><p>\u0633\u064a\u0631\u0627\u0645\u064a\u0643\u060c \u0623\u062f\u0648\u0627\u062a \u062d\u0645\u0627\u0645\u060c \u0645\u0648\u0627\u062f \u0628\u0646\u0627\u0621 \u0628\u0627\u0644\u062c\u0645\u0644\u0629<\/p><\/div>\\n<\/div>\\n<\/div>\\n<div class=\\\"section\\\">\\n<h2 class=\\\"section-title\\\">\u0623\u0633\u0639\u0627\u0631 <span>\u062a\u0642\u0631\u064a\u0628\u064a\u0629<\/span><\/h2>\\n<table class=\\\"price-table\\\">\\n<tr><th>\u0627\u0644\u0645\u0646\u062a\u062c<\/th><th>\u0627\u0644\u0643\u0645\u064a\u0629 \u0627\u0644\u062f\u0646\u064a\u0627<\/th><th>\u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u062a\u0642\u0631\u064a\u0628\u064a<\/th><th>\u0645\u0644\u0627\u062d\u0638\u0627\u062a<\/th><\/tr>\\n<tr><td>\u0645\u0635\u0627\u0628\u064a\u062d LED 9W<\/td><td>200 \u0642\u0637\u0639\u0629<\/td><td>$0.8\u2013$1.5\/\u0642\u0637\u0639\u0629<\/td><td>E27\/B22<\/td><\/tr>\\n<tr><td>\u0645\u0631\u0627\u0648\u062d \u0633\u0642\u0641<\/td><td>30 \u0642\u0637\u0639\u0629<\/td><td>$18\u2013$45\/\u0642\u0637\u0639\u0629<\/td><td>\u0645\u0639 \u0631\u064a\u0645\u0648\u062a \u0623\u0648 \u0628\u062f\u0648\u0646<\/td><\/tr>\\n<tr><td>\u0637\u0646\u0627\u062c\u0631 \u0633\u062a\u064a\u0644 \u0645\u0631\u0622\u0629<\/td><td>50 \u0637\u0642\u0645<\/td><td>$12\u2013$30\/\u0637\u0642\u0645<\/td><td>5\u20137 \u0642\u0637\u0639\/\u0637\u0642\u0645<\/td><\/tr>\\n<tr><td>\u0634\u0648\u0627\u062d\u0646 USB \u0645\u062a\u0639\u062f\u062f\u0629<\/td><td>100 \u0642\u0637\u0639\u0629<\/td><td>$2\u2013$6\/\u0642\u0637\u0639\u0629<\/td><td>PD\/QC3<\/td><\/tr>\\n<\/table>\\n<\/div>\\n<div class=\\\"section\\\">\\n<h2 class=\\\"section-title\\\">\u0623\u0633\u0626\u0644\u0629 <span>\u0634\u0627\u0626\u0639\u0629<\/span><\/h2>\\n<div class=\\\"faq\\\">\\n<div class=\\\"faq-item\\\"><div class=\\\"faq-q\\\">\u0647\u0644 \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u062a\u062f\u0639\u0645 \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0639\u0631\u0628\u064a (220V)\u061f<\/div><div class=\\\"faq-a\\\">\u0646\u0639\u0645\u060c \u0646\u062d\u062f\u0651\u062f \u0644\u0644\u0645\u0648\u0631\u0651\u062f \u0627\u0644\u062c\u0647\u062f \u0627\u0644\u0645\u0637\u0644\u0648\u0628 (220V\/50Hz) \u0648\u0643\u0644 \u0627\u0644\u0628\u0636\u0627\u0639\u0629 \u062a\u0623\u062a\u064a \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0645\u0646\u0637\u0642\u062a\u0643.<\/div><\/div>\\n<div class=\\\"faq-item\\\"><div class=\\\"faq-q\\\">\u0647\u0644 \u0647\u0646\u0627\u0643 \u0636\u0645\u0627\u0646 \u0639\u0644\u0649 \u0627\u0644\u0623\u062c\u0647\u0632\u0629\u061f<\/div><div class=\\\"faq-a\\\">\u0646\u0641\u062d\u0635 \u0627\u0644\u0628\u0636\u0627\u0639\u0629 \u0645\u064a\u062f\u0627\u0646\u064a\u0627\u064b \u0642\u0628\u0644 \u0627\u0644\u0634\u062d\u0646. \u0636\u0645\u0627\u0646 \u0627\u0644\u0645\u0635\u0646\u0639 \u064a\u062a\u0631\u0627\u0648\u062d \u0628\u064a\u0646 6\u201324 \u0634\u0647\u0631 \u062d\u0633\u0628 \u0627\u0644\u0645\u0646\u062a\u062c.<\/div><\/div>\\n<div class=\\\"faq-item\\\"><div class=\\\"faq-q\\\">\u0647\u0644 \u064a\u0645\u0643\u0646 \u0648\u0636\u0639 \u0634\u0639\u0627\u0631\u0646\u0627 \u0639\u0644\u0649 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a\u061f<\/div><div class=\\\"faq-a\\\">\u0646\u0639\u0645\u060c \u062e\u062f\u0645\u0629 Private Label \u0645\u062a\u0627\u062d\u0629 \u0644\u0645\u0639\u0638\u0645 \u0627\u0644\u0645\u0646\u062a\u062c\u0627\u062a \u0645\u0646 \u0643\u0645\u064a\u0627\u062a \u0645\u062d\u062f\u062f\u0629.<\/div><\/div>\\n<\/div>\\n<\/div>\\n<div class=\\\"cta-box\\\">\\n<h2>\u0627\u0628\u062f\u0623 \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0628\u0633\u0647\u0648\u0644\u0629 \ud83c\udfe0<\/h2>\\n<p>\u0631\u0627\u0633\u0644\u0646\u0627 \u0648\u0623\u062e\u0628\u0631\u0646\u0627 \u0628\u0627\u0644\u0645\u0646\u062a\u062c \u0648\u0627\u0644\u0643\u0645\u064a\u0629 \u0648\u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0648\u0633\u0646\u0648\u0635\u0651\u0644\u0643 \u0628\u0623\u0641\u0636\u0644 \u0645\u0648\u0631\u0651\u062f<\/p>\\n<a href=\\\"https:\/\/wa.me\/77064007561?text=\u0645\u0631\u062d\u0628\u0627\u064b%D8%8C%20\u0623\u0631\u064a\u062f%