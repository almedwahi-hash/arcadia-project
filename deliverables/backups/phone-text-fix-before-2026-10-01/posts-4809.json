a\u062d\u062f\u062b \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0628\u0634\u0643\u0644 \u062c\u064a\u062f.<\/p>\n<p>\u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0644\u062f\u0631\u062c\u0629 \u0627\u0644\u0628\u0631\u0648\u062f\u0629 \u0647\u0648 \u0623\u0645\u0631 \u0628\u0627\u0644\u063a \u0627\u0644\u0623\u0647\u0645\u064a\u0629\u060c \u0644\u0630\u0627 \u064a\u062c\u0628 \u062a\u062c\u0646\u0628 \u0627\u0644\u062a\u0642\u0644\u064a\u0644 \u0645\u0646 \u0623\u0647\u0645\u064a\u0629 \u0627\u0644\u0645\u0644\u0627\u0628\u0633 \u0627\u0644\u062f\u0627\u0641\u0626\u0629. \u064a\u0641\u0636\u0644 \u0623\u064a\u0636\u064b\u0627 \u0627\u0644\u0627\u0633\u062a\u0639\u0627\u0646\u0629 \u0628\u0645\u0631\u0634\u062f \u0645\u062d\u0644\u064a \u0639\u0646\u062f \u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0646\u0627\u0626\u064a\u0629 \u0644\u0636\u0645\u0627\u0646 \u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0648\u0627\u0644\u0627\u0633\u062a\u0645\u062a\u0627\u0639 \u0628\u0643\u0644 \u0645\u0627 \u062a\u0642\u062f\u0645\u0647 \u0627\u0644\u0637\u0628\u064a\u0639\u0629 \u0647\u0646\u0627\u0643.<\/p>\n<h2>\u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0648\u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0628\u0627\u0644\u062a\u0641\u0635\u064a\u0644<\/h2>\n<p>\u062a\u064f\u0639\u062a\u0628\u0631 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0648\u062c\u0647\u0629 \u0645\u0639\u0642\u0648\u0644\u0629 \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0644\u0633\u064a\u0627\u062d\u060c \u062d\u064a\u062b \u064a\u0645\u0643\u0646 \u062a\u0648\u0642\u0639 \u0625\u0646\u0641\u0627\u0642 \u062d\u0648\u0627\u0644\u064a 300 \u0625\u0644\u0649 500 \u062f\u0648\u0644\u0627\u0631 \u0623\u0645\u0631\u064a\u0643\u064a \u0644\u0644\u0623\u0633\u0628\u0648\u0639 \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0625\u0642\u0627\u0645\u0629 \u0648\u0627\u0644\u0637\u0639\u0627\u0645. \u062a\u062a\u0631\u0627\u0648\u062d \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0625\u0642\u0627\u0645\u0629 \u0641\u064a \u0627\u0644\u0641\u0646\u0627\u062f\u0642 \u0628\u064a\u0646 30 \u0625\u0644\u0649 100 \u062f\u0648\u0644\u0627\u0631 \u0644\u0644\u064a\u0644\u0629. \u0623\u0633\u0639\u0627\u0631 \u0645\u0639\u062f\u0627\u062a \u0627\u0644\u062a\u0632\u0644\u062c \u0648\u062a\u0623\u062c\u064a\u0631\u0647\u0627 \u062a\u062a\u0645\u064a\u0632 \u0643\u0630\u0644\u0643 \u0628\u0623\u0646\u0647\u0627 \u0623\u0642\u0644 \u062a\u0643\u0644\u0641\u0629 \u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u0648\u062c\u0647\u0627\u062a \u0623\u062e\u0631\u0649 \u062d\u064a\u062b \u0623\u0646\u0647\u0627 \u0642\u062f \u062a\u0628\u062f\u0623 \u0645\u0646 20 \u062f\u0648\u0644\u0627\u0631\u064b\u0627 \u0644\u0644\u064a\u0648\u0645 \u0627\u0644\u0648\u0627\u062d\u062f.<\/p>\n<p>\u0628\u0627\u0644\u0625\u0636\u0627\u0641\u0629 \u0625\u0644\u0649 \u0630\u0644\u0643\u060c \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0648\u0633\u0627\u0626\u0644 \u0627\u0644\u0646\u0642\u0644 \u0627\u0644\u0639\u0627\u0645\u0629 \u0641\u064a \u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u0643\u0628\u0631\u0649 \u0645\u062b\u0644 \u0623\u0644\u0645\u0627\u062a\u064a \u0628\u0623\u062b\u0645\u0627\u0646 \u0631\u0645\u0632\u064a\u0629\u060c \u062d\u064a\u062b \u0644\u0627 \u062a\u062a\u062c\u0627\u0648\u0632 \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u062a\u0630\u0643\u0631\u0629 \u0627\u0644\u0648\u0627\u062d\u062f\u0629 \u062f\u0648\u0644\u0627\u0631\u064b\u0627 \u0623\u0645\u0631\u064a\u0643\u064a\u064b\u0627.<\/p>\n<h2>\u0623\u0633\u0626\u0644\u0629 \u0634\u0627\u0626\u0639\u0629<\/h2>\n<ul>\n<li><strong>\u0645\u0627 \u0647\u0648 \u0623\u0641\u0636\u0644 \u0648\u0642\u062a \u0644\u0632\u064a\u0627\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0644\u0633\u064a\u0627\u062d\u0629 \u0627\u0644\u0634\u062a\u0648\u064a\u0629\u061f<\/strong><\/li>\n<p>\u064a\u064f\u0639\u062a\u0628\u0631 \u0634\u0647\u0631\u064a \u062f\u064a\u0633\u0645\u0628\u0631 \u0648\u064a\u0646\u0627\u064a\u0631 \u0647\u0645\u0627 \u0627\u0644\u0623\u0648\u0642\u0627\u062a \u0627\u0644\u0645\u062b\u0627\u0644\u064a\u0629 \u0644\u0644\u0627\u0633\u062a\u0645\u062a\u0627\u0639 \u0628\u0623\u0642\u0635\u0649 \u062a\u062c\u0627\u0631\u0628 \u0627\u0644\u062b\u0644\u062c.<\/p>\n<li><strong>\u0647\u0644 \u062a\u062a\u0637\u0644\u0628 \u0632\u064a\u0627\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u062f\u062e\u0648\u0644 \u0644\u0644\u0645\u0648\u0627\u0637\u0646\u064a\u0646 \u0627\u0644\u0639\u0631\u0628\u061f<\/strong><\/li>\n<p>\u062a\u0639\u062a\u0645\u062f \u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0639\u0644\u0649 \u0627\u0644\u062f\u0648\u0644\u0629 \u0648\u0644\u0643\u0646 \u0641\u064a \u0627\u0644\u0639\u0645\u0648\u0645\u060c \u064a\u0645\u0643\u0646 \u0627\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0639\u0646\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0623\u0648 \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0645\u0633\u0628\u0642\u064b\u0627 \u0639\u0628\u0631 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a \u0644\u0628\u0639\u0636 \u0627\u0644\u062c\u0646\u0633\u064a\u0627\u062a.<\/p>\n<li><strong>\u0645\u0627 \u0647\u064a \u0627\u0644\u0644\u063a\u0627\u062a \u0627\u0644\u062a\u064a \u064a\u062a\u062d\u062f\u062b \u0628\u0647\u0627 \u0627\u0644\u0633\u0643\u0627\u0646 \u0627\u0644\u0645\u062d\u0644\u064a\u0648\u0646\u061f<\/strong><\/li>\n<p>\u064a\u062a\u0645 \u0627\u0644\u062a\u062d\u062f\u062b \u0628\u0627\u0644\u0644\u063a\u062a\u064a\u0646 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u064a\u0629 \u0648\u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0628\u0634\u0643\u0644 \u0631\u0626\u064a\u0633\u064a. \u064a\u064f\u0641\u0636\u0644 \u062a\u