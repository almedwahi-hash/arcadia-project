{"id":527,"link":"https:\/\/arcadia-tour.com\/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3%d8%aa%d8%a7%d9%86-%d8%a7%d9%84%d9%85%d8%b3%d8%a7%d9%81%d8%b1%d9%88%d9%86-%d8%a7%d9%84%d8%b9%d8%b1%d8%a8\/","content":{"raw":"<p>\u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0647\u0630\u0647 \u0632\u064a\u0627\u0631\u062a\u0643 \u0627\u0644\u0623\u0648\u0644\u0649\u060c \u0641\u0647\u0630\u0627 \u0627\u0644\u062f\u0644\u064a\u0644 \u064a\u062e\u062a\u0635\u0631 \u0623\u0647\u0645 \u0645\u0627 \u064a\u062d\u062a\u0627\u062c\u0647 <strong>\u0627\u0644\u0645\u0633\u0627\u0641\u0631 \u0627\u0644\u0639\u0631\u0628\u064a \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/strong>: \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u062f\u064a\u0646\u0629\u060c \u0627\u0644\u0644\u063a\u0629\u060c \u0627\u0644\u0637\u0639\u0627\u0645 \u0627\u0644\u062d\u0644\u0627\u0644\u060c \u0627\u0644\u0637\u0642\u0633\u060c \u0627\u0644\u062a\u0646\u0642\u0644 \u0648\u0637\u0631\u064a\u0642\u0629 \u0628\u0646\u0627\u0621 \u0628\u0631\u0646\u0627\u0645\u062c \u0645\u0631\u064a\u062d. \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u062f\u0648\u0644\u0629 \u0648\u0627\u0633\u0639\u0629\u060c \u0648\u0644\u0630\u0644\u0643 \u062a\u0643\u0648\u0646 \u0627\u0644\u0631\u062d\u0644\u0629 \u0623\u0641\u0636\u0644 \u0639\u0646\u062f\u0645\u0627 \u062a\u062e\u062a\u0627\u0631 \u0645\u062f\u064a\u0646\u062a\u064a\u0646 \u0623\u0648 \u062b\u0644\u0627\u062b\u0627\u064b \u0628\u062f\u0644 \u0645\u062d\u0627\u0648\u0644\u0629 \u0632\u064a\u0627\u0631\u0629 \u0645\u0646\u0627\u0637\u0642 \u0645\u062a\u0628\u0627\u0639\u062f\u0629 \u062e\u0644\u0627\u0644 \u0623\u064a\u0627\u0645 \u0642\u0644\u064a\u0644\u0629.<\/p>\n\n<h2>\u0644\u0645\u0627\u0630\u0627 \u062a\u0646\u0627\u0633\u0628 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0627\u0644\u0645\u0633\u0627\u0641\u0631 \u0627\u0644\u0639\u0631\u0628\u064a\u061f<\/h2>\n<p>\u062a\u062c\u0645\u0639 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0628\u064a\u0646 \u0645\u062f\u0646 \u062d\u062f\u064a\u062b\u0629 \u0648\u0637\u0628\u064a\u0639\u0629 \u062c\u0628\u0644\u064a\u0629 \u0648\u0628\u062d\u064a\u0631\u0627\u062a \u0648\u0623\u0648\u062f\u064a\u0629\u060c \u0645\u0639 \u062e\u064a\u0627\u0631\u0627\u062a \u062a\u0646\u0627\u0633\u0628 \u0627\u0644\u0639\u0627\u0626\u0644\u0627\u062a \u0648\u0627\u0644\u0623\u0632\u0648\u0627\u062c \u0648\u0645\u062d\u0628\u064a \u0627\u0644\u0645\u063a\u0627\u0645\u0631\u0629. \u0623\u0644\u0645\u0627\u062a\u064a \u0647\u064a \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0644\u0644\u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0628\u0633\u0628\u0628 \u0642\u0631\u0628\u0647\u0627 \u0645\u0646 \u0623\u0634\u0647\u0631 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u062a\u0636\u064a\u0641 \u0623\u0633\u062a\u0627\u0646\u0627 \u062a\u062c\u0631\u0628\u0629 \u0645\u062e\u062a\u0644\u0641\u0629 \u062a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u0627\u0631\u0629 \u0648\u0627\u0644\u0645\u062a\u0627\u062d\u0641. \u0648\u064a\u0645\u0643\u0646 \u0627\u062e\u062a\u064a\u0627\u0631 \u062a\u0631\u0643\u0633\u062a\u0627\u0646 \u0644\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a \u0623\u0648 \u0623\u0643\u062a\u0627\u0648 \u0648\u0645\u0627\u0646\u063a\u064a\u0633\u062a\u0627\u0648 \u0644\u0645\u0633\u0627\u0631 \u0635\u062d\u0631\u0627\u0648\u064a \u0645\u0633\u062a\u0642\u0644.<\/p>\n<p>\u0644\u0644\u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u064a\u0646 \u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0648\u0645\u062f\u062f \u0627\u0644\u0625\u0642\u0627\u0645\u0629\u060c \u0631\u0627\u062c\u0639 <a href=\"https:\/\/arcadia-tour.com\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\/\u0627\u0644\u0645\u062f\u0646-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646-\u062a\u0639\u0631\u0641-\u0639\u0644\u0649-\u0623\u0647\u0645-9-\u0645\u062f\u0646-\u0633\u064a\u0627\u062d\u064a\u0629\/\">\u062f\u0644\u064a\u0644 \u0623\u0641\u0636\u0644 \u0645\u062f\u0646 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629<\/a>.<\/p>\n\n<h2>\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0633\u0631\u064a\u0639\u0629 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631<\/h2>\n<ul>\n  <li><strong>\u0627\u0644\u0644\u063a\u0629:<\/strong> \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u064a\u0629 \u0648\u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0647\u0645\u0627 \u0627\u0644\u0623\u0643\u062b\u0631 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0627\u064b. \u0642\u062f \u062a\u062a\u0648\u0641\u0631 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u0641\u0646\u0627\u062f\u0642 \u0648\u0627\u0644\u0623\u0645\u0627\u0643\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629\u060c \u0644\u0643\u0646 \u0644\u0627 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u064a\u0647\u0627 \u0641\u064a \u0643\u0644 \u0627\u0644\u0645\u0648\u0627\u0642\u0639.<\/li>\n  <li><strong>\u0627\u0644\u0639\u0645\u0644\u0629:<\/strong> \u0627\u0644\u062a\u0646\u063a\u064a \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a. \u062a\u062a\u063a\u064a\u0631 \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0631\u0641\u060c \u0644\u0630\u0644\u0643 \u0627\u0641\u062d\u0635 \u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0645\u0646 \u0627\u0644\u0628\u0646\u0643 \u0623\u0648 \u062a\u0637\u0628\u064a\u0642 \u0645\u0648\u062b\u0648\u0642 \u0648\u0642\u062a \u0627\u0644\u0631\u062d\u0644\u0629.<\/li>\n  <li><strong>\u0627\u0644\u0645\u0633\u0627\u0641\u0627\u062a:<\/strong> \u0628\u0639\u0636 \u0627\u0644\u0628\u062d\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0623\u0648\u062f\u064a\u0629 \u0644\u064a\u0633\u062a \u062f\u0627\u062e\u0644 \u0623\u0644\u0645\u0627\u062a\u064a\u060c \u0648\u0642\u062f \u062a\u0633\u062a\u063a\u0631\u0642 \u0627\u0644\u0631\u062d\u0644\u0629 \u0625\u0644\u064a\u0647\u0627 \u064a\u0648\u0645\u0627\u064b \u0643\u0627\u0645\u0644\u0627\u064b.<\/li>\n  <li><strong>\u0627\u0644\u0637\u0642\u0633:<\/strong> \u064a\u062e\u062a\u0644\u0641 \u0628\u0648\u0636\u0648\u062d \u0628\u064a\u0646 \u0627\u0644\u0645\u062f\u0646 \u0648\u0627\u0644\u062c\u0628\u0627\u0644\u061b \u0627\u0641\u062d\u0635 \u062a\u0648\u0642\u0639\u0627\u062a \u0643\u0644 \u0645\u0646\u0637\u0642\u0629 \u0642\u0628\u0644 \u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0645\u0644\u0627\u0628\u0633.<\/li>\n  <li><strong>\u0627\u0644\u0627\u062a\u0635\u0627\u0644:<\/strong> \u0627\u062d\u062a\u0641\u0638 \u0628\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0645\u0643\u062a\u0648\u0628\u0629 \u0628\u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0623\u0648 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u064a\u0629\u060c \u0648\u0646\u0632\u0651\u0644 \u0627\u0644\u062e\u0631\u0627\u0626\u0637 \u0644\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u064a\u0647\u0627 \u062f\u0648\u0646 \u0625\u0646\u062a\u0631\u0646\u062a.<\/li>\n<\/ul>\n\n<h2>\u0627\u0644\u0644\u063a\u0629 \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0644\u0644\u0645\u0633\u0627\u0641\u0631 \u0627\u0644\u0639\u0631\u0628\u064a<\/h2>\n<p>\u0645\u0646 \u0627\u0644\u0645\u0641\u064a\u062f \u062d\u0641\u0638 \u0639\u0628\u0627\u0631\u0627\u062a \u0628\u0633\u064a\u0637\u0629 \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0637\u0628\u064a\u0642 \u062a\u0631\u062c\u0645\u0629 \u064a\u062f\u0639\u0645 \u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u062f\u0648\u0646 \u0627\u062a\u0635\u0627\u0644. \u0639\u0646\u062f \u0637\u0644\u0628 \u0633\u064a\u0627\u0631\u0629 \u0623\u0648 \u0632\u064a\u0627\u0631\u0629 \u0645\u0646\u0637\u0642\u0629 \u0637\u0628\u064a\u0639\u064a\u0629\u060c \u0623\u0631\u0633\u0644 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a \u0644\u0644\u0633\u0627\u0626\u0642 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0646\u0637\u0642 \u0627\u0644\u0627\u0633\u0645 \u0641\u0642\u0637. \u0648\u062c\u0648\u062f \u0645\u0631\u0634\u062f \u0639\u0631\u0628\u064a \u064a\u0643\u0648\u0646 \u0645\u0641\u064a\u062f\u0627\u064b \u062e\u0635\u0648\u0635\u0627\u064b \u0644\u0644\u0639\u0627\u0626\u0644\u0627\u062a \u0648\u0641\u064a \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u062c\u0628\u0644\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0627\u062c \u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0645\u0633\u0627\u0631 \u0648\u0627\u0644\u062a\u0648\u0642\u064a\u062a.<\/p>\n\n<h2>\u0627\u0644\u0637\u0639\u0627\u0645 \u0627\u0644\u062d\u0644\u0627\u0644 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/h2>\n<p>\u062a\u0648\u062c\u062f \u0645\u0637\u0627\u0639\u0645 \u062a\u0642\u062f\u0645 \u0637\u0639\u0627\u0645\u0627\u064b \u062d\u0644\u0627\u0644\u0627\u064b\u060c \u0648\u0644\u0627 \u0633\u064a\u0645\u0627 \u0641\u064a \u0623\u0644\u0645\u0627\u062a\u064a \u0648\u0623\u0633\u062a\u0627\u0646\u0627\u060c \u0644\u0643\u0646 \u0627\u0644\u0623\u0641\u0636\u0644 \u0633\u0624\u0627\u0644 \u0627\u0644\u0645\u0637\u0639\u0645 \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0646 \u0645\u0635\u062f\u0631 \u0627\u0644\u0644\u062d\u0648\u0645 \u0648\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u062d\u0636\u064a\u0631 \u0644\u0623\u0646 \u062a\u0648\u0641\u0631 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u064a\u062e\u062a\u0644\u0641 \u0645\u0646 \u0645\u0643\u0627\u0646 \u0625\u0644\u0649 \u0622\u062e\u0631. \u0627\u0628\u062d\u062b \u0639\u0646 \u0643\u0644\u0645\u0629 <strong>Halal<\/strong> \u0623\u0648 \u0627\u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0627\u0644\u0641\u0646\u062f\u0642\u060c \u0648\u0627\u062d\u062a\u0641\u0638 \u0628\u062e\u064a\u0627\u0631\u0627\u062a \u0628\u062f\u064a\u0644\u0629 \u0642\u0631\u0628 \u0645\u0643\u0627\u0646 \u0627\u0644\u0633\u0643\u0646 \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642 \u0625\u0644\u0649 \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0628\u0639\u064a\u062f\u0629.<\/p>\n<p>\u0627\u0644\u0645\u0637\u0628\u062e \u0627\u0644\u0645\u062d\u0644\u064a \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0627\u0644\u0644\u062d\u0648\u0645 \u0648\u0627\u0644\u0639\u062c\u064a\u0646 \u0648\u0627\u0644\u0623\u0631\u0632\u060c \u0648\u0645\u0646 \u0623\u0634\u0647\u0631 \u0627\u0644\u0623\u0637\u0628\u0627\u0642 \u0627\u0644\u0628\u0634\u0628\u0631\u0645\u0627\u0643 \u0648\u0627\u0644\u0628\u0644\u0648\u0641. \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0644\u062f\u064a\u0643 \u062d\u0633\u0627\u0633\u064a\u0629 \u063a\u0630\u0627\u0626\u064a\u0629 \u0623\u0648 \u062a\u0641\u0636\u064a\u0644\u0627\u062a \u062e\u0627\u0635\u0629\u060c \u0627\u0643\u062a\u0628\u0647\u0627 \u0628\u0648\u0636\u0648\u062d \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0631\u062c\u0645\u0629.<\/p>\n\n<h2>\u0623\u0641\u0636\u0644 \u0645\u062f\u0646 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0644\u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649<\/h2>\n<h3>\u0623\u0644\u0645\u0627\u062a\u064a \u0648\u0627\u0644\u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629<\/h3>\n<p>\u0623\u0644\u0645\u0627\u062a\u064a \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0644\u0639\u0627\u0626\u0644\u0627\u062a \u0648\u0645\u062d\u0628\u064a \u0627\u0644\u0637\u0628\u064a\u0639\u0629. \u064a\u0645\u0643\u0646 \u062a\u062e\u0635\u064a\u0635 \u064a\u0648\u0645 \u0644\u0644\u0645\u062f\u064a\u0646\u0629\u060c \u062b\u0645 \u0623\u064a\u0627\u0645 \u0645\u0646\u0641\u0635\u0644\u0629 \u0644\u0648\u062c\u0647\u0627\u062a \u0645\u062b\u0644 \u0648\u0627\u062f\u064a \u0634\u0627\u0631\u064a\u0646 \u0623\u0648 \u0628\u062d\u064a\u0631\u0627\u062a \u0643\u0648\u0644\u0633\u0627\u064a \u0648\u0643\u0627\u064a\u0646\u062f\u064a \u0648\u0641\u0642 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0631\u064a\u0642 \u0648\u0627\u0644\u0645\u0648\u0633\u0645. \u0644\u0627 \u062a\u062c\u0645\u0639 \u0631\u062d\u0644\u062a\u064a\u0646 \u0637\u0628\u064a\u0639\u064a\u062a\u064a\u0646 \u0628\u0639\u064a\u062f\u062a\u064a\u0646 \u0641\u064a \u064a\u0648\u0645 \u0648\u0627\u062d\u062f.<\/p>\n<h3>\u0623\u0633\u062a\u0627\u0646\u0627<\/h3>\n<p>\u0623\u0633\u062a\u0627\u0646\u0627 \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0625\u0642\u0627\u0645\u0629 \u0642\u0635\u064a\u0631\u0629 \u0645\u0646 \u0644\u064a\u0644\u062a\u064a\u0646 \u0625\u0644\u0649 \u062b\u0644\u0627\u062b \u0644\u064a\u0627\u0644\u064d\u060c \u0648\u062a\u062e\u062a\u0644\u0641 \u0623\u062c\u0648\u0627\u0624\u0647\u0627 \u0639\u0646 \u0623\u0644\u0645\u0627\u062a\u064a \u0628\u0639\u0645\u0627\u0631\u062a\u0647\u0627 \u0627\u0644\u062d\u062f\u064a\u062b\u0629 \u0648\u0645\u062a\u0627\u062d\u0641\u0647\u0627. \u0627\u0644\u0631\u064a\u0627\u062d \u0648\u0627\u0644\u0628\u0631\u062f \u0639\u0627\u0645\u0644\u0627\u0646 \u0645\u0647\u0645\u0627\u0646 \u0639\u0646\u062f \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0645\u0634\u064a \u0641\u064a \u0627\u0644\u0634\u062a\u0627\u0621.<\/p>\n<h3>\u062a\u0631\u0643\u0633\u062a\u0627\u0646 \u0623\u0648 \u0623\u0643\u062a\u0627\u0648<\/h3>\n<p>\u0627\u062e\u062a\u0631 \u062a\u0631\u0643\u0633\u062a\u0627\u0646 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0647\u062a\u0645\u0627\u0645\u0643 \u0628\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0648\u0637\u0631\u064a\u0642 \u0627\u0644\u062d\u0631\u064a\u0631\u060c \u0648\u0627\u062e\u062a\u0631 \u0623\u0643\u062a\u0627\u0648 \u0648\u0645\u0627\u0646\u063a\u064a\u0633\u062a\u0627\u0648 \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0631\u064a\u062f \u0631\u062d\u0644\u0629 \u0635\u062d\u0631\u0627\u0648\u064a\u0629 \u0648\u0633\u0627\u062d\u0644\u064a\u0629 \u0645\u0633\u062a\u0642\u0644\u0629. \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a \u062a\u062d\u062a\u0627\u062c \u0648\u0642\u062a\u0627\u064b \u0648\u062a\u0646\u0642\u0644\u0627\u064b \u062e\u0627\u0635\u0627\u064b \u0648\u0644\u0627 \u062a\u064f\u0636\u0627\u0641 \u0633\u0631\u064a\u0639\u0627\u064b \u0625\u0644\u0649 \u0628\u0631\u0646\u0627\u0645\u062c \u0623\u0644\u0645\u0627\u062a\u064a.<\/p>\n\n<h2>\u0645\u062a\u0649 \u062a\u0633\u0627\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h2>\n<p><strong>\u0627\u0644\u0635\u064a\u0641<\/strong> \u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u062c\u0628\u0627\u0644 \u0648\u0627\u0644\u0628\u062d\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0639\u0627\u0626\u0644\u064a\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u0645\u0646\u062d <strong>\u0627\u0644\u0631\u0628\u064a\u0639 \u0648\u0627\u0644\u062e\u0631\u064a\u0641<\/strong> \u0623\u062c\u0648\u0627\u0621 \u0623\u0644\u0637\u0641 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062f\u0646 \u0645\u0639 \u0636\u0631\u0648\u0631\u0629 \u0627\u0644\u0627\u0633\u062a\u0639\u062f\u0627\u062f \u0644\u062a\u063a\u064a\u0631 \u0627\u0644\u0637\u0642\u0633. \u0623\u0645\u0627 <strong>\u0627\u0644\u0634\u062a\u0627\u0621<\/strong> \u0641\u064a\u0646\u0627\u0633\u0628 \u0627\u0644\u062b\u0644\u0648\u062c \u0648\u0627\u0644\u062a\u0632\u0644\u062c\u060c \u0644\u0643\u0646\u0647 \u064a\u062d\u062a\u0627\u062c \u0645\u0644\u0627\u0628\u0633 \u0648\u062a\u062c\u0647\u064a\u0632\u0627\u064b \u0645\u0646\u0627\u0633\u0628\u0627\u064b \u0648\u0645\u0631\u0648\u0646\u0629 \u0639\u0646\u062f \u062a\u063a\u064a\u0631 \u0627\u0644\u0623\u062d\u0648\u0627\u0644 \u0627\u0644\u062c\u0648\u064a\u0629.<\/p>\n<p>\u0644\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0648\u0633\u0645\u064a\u0629 \u0648\u0627\u0644\u0648\u062c\u0647\u0627\u062a\u060c \u0627\u0642\u0631\u0623 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-tourism-overview\/\">\u062f\u0644\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 2026<\/a>.<\/p>\n\n<h2>\u0627\u0644\u062a\u0646\u0642\u0644 \u0648\u0627\u0644\u0633\u0643\u0646<\/h2>\n<p>\u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062f\u0646\u060c \u0627\u0633\u062a\u062e\u062f\u0645 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0646\u0642\u0644 \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u0629 \u0623\u0648 \u0633\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0641\u0646\u062f\u0642\u060c \u0648\u062a\u0623\u0643\u062f \u0645\u0646 \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0642\u0628\u0644 \u0627\u0644\u0635\u0639\u0648\u062f. \u0623\u0645\u0627 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u062c\u0628\u0644\u064a\u0629 \u0648\u0627\u0644\u0637\u0631\u0642 \u0627\u0644\u0637\u0648\u064a\u0644\u0629 \u0641\u062a\u062d\u062a\u0627\u062c \u0633\u064a\u0627\u0631\u0629 \u0645\u0646\u0627\u0633\u0628\u0629 \u0648\u0633\u0627\u0626\u0642\u0627\u064b \u064a\u0639\u0631\u0641 \u0627\u0644\u0645\u0646\u0637\u0642\u0629. \u0627\u062e\u062a\u0631 \u0627\u0644\u0633\u0643\u0646 \u0628\u062d\u0633\u0628 \u0628\u0631\u0646\u0627\u0645\u062c\u0643: \u0648\u0633\u0637 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u0645\u0637\u0627\u0639\u0645 \u0648\u0627\u0644\u062a\u0633\u0648\u0642\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u0633\u0643\u0646 \u0627\u0644\u0628\u0639\u064a\u062f \u0642\u062f \u064a\u0632\u064a\u062f \u0648\u0642\u062a \u0627\u0644\u062a\u0646\u0642\u0644 \u0627\u0644\u064a\u0648\u0645\u064a.<\/p>\n\n<h2>\u0646\u0635\u0627\u0626\u062d \u0644\u0644\u0639\u0627\u0626\u0644\u0627\u062a<\/h2>\n<ul>\n  <li>\u0627\u062a\u0631\u0643 \u0648\u0642\u062a\u0627\u064b \u0644\u0644\u0631\u0627\u062d\u0629 \u0628\u064a\u0646 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0637\u0648\u064a\u0644\u0629\u060c \u062e\u0627\u0635\u0629 \u0645\u0639 \u0627\u0644\u0623\u0637\u0641\u0627\u0644.<\/li>\n  <li>\u0644\u0627 \u062a\u062c\u0639\u0644 \u064a\u0648\u0645 \u0627\u0644\u0648\u0635\u0648\u0644 \u064a\u0648\u0645\u0627\u064b \u0644\u0631\u062d\u0644\u0629 \u062c\u0628\u0644\u064a\u0629 \u0628\u0639\u064a\u062f\u0629.<\/li>\n  <li>\u0627\u062d\u0645\u0644 \u0645\u0627\u0621\u064b \u0648\u0648\u062c\u0628\u0629 \u062e\u0641\u064a\u0641\u0629 \u0648\u0645\u0644\u0627\u0628\u0633 \u0625\u0636\u0627\u0641\u064a\u0629 \u0639\u0646\u062f \u0627\u0644\u062e\u0631\u0648\u062c \u0644\u0644\u0637\u0628\u064a\u0639\u0629.<\/li>\n  <li>\u062b\u0628\u0651\u062a \u0646\u0642\u0637\u0629 \u062a\u062c\u0645\u0639 \u0648\u0627\u0636\u062d\u0629 \u0648\u0627\u062d\u0641\u0638 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0641\u0646\u062f\u0642 \u0639\u0644\u0649 \u0647\u0648\u0627\u062a\u0641 \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0639\u0627\u0626\u0644\u0629.<\/li>\n  <li>\u0641\u064a \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0637\u0627\u0631\u0626\u0629 \u062f\u0627\u062e\u0644 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u060c \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0647\u0648 <a href=\"https:\/\/www.gov.kz\/situations\/729\/1519?lang=ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span dir=\"ltr\">112<\/span><\/a>.<\/li>\n<\/ul>\n\n<h2>\u0628\u0631\u0646\u0627\u0645\u062c \u0645\u0642\u062a\u0631\u062d \u0644\u0623\u0648\u0644 \u0631\u062d\u0644\u0629<\/h2>\n<p>\u0644\u0631\u062d\u0644\u0629 \u0645\u0646 \u0633\u0628\u0639\u0629 \u0625\u0644\u0649 \u062a\u0633\u0639\u0629 \u0623\u064a\u0627\u0645\u060c \u0627\u062c\u0639\u0644 \u0623\u0644\u0645\u0627\u062a\u064a \u0642\u0627\u0639\u062f\u0629 \u0631\u0626\u064a\u0633\u064a\u0629 \u0645\u0639 \u064a\u0648\u0645 \u0644\u0644\u0645\u062f\u064a\u0646\u0629 \u0648\u064a\u0648\u0645\u064a\u0646 \u0623\u0648 \u062b\u0644\u0627\u062b\u0629 \u0644\u0644\u0637\u0628\u064a\u0639\u0629\u060c \u062b\u0645 \u0623\u0636\u0641 \u0623\u0633\u062a\u0627\u0646\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0648\u0627\u0644\u0648\u0642\u062a \u0645\u0646\u0627\u0633\u0628\u064a\u0646. \u0623\u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0644\u0644\u0631\u0627\u062d\u0629\u060c \u0641\u0627\u0628\u0642\u064e \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \u0623\u0644\u0645\u0627\u062a\u064a \u0648\u0627\u062e\u062a\u0631 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0628\u0639\u0646\u0627\u064a\u0629. \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-7-days-2\/\">\u0628\u0631\u0646\u0627\u0645\u062c \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0645\u062f\u0629 7 \u0623\u064a\u0627\u0645<\/a> \u0643\u0646\u0642\u0637\u0629 \u0628\u062f\u0627\u064a\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0639\u062f\u064a\u0644.<\/p>\n\n<h2>\u062e\u0637\u0637 \u0631\u062d\u0644\u062a\u0643 \u0645\u0639 \u0623\u0631\u0643\u0627\u062f\u064a\u0627<\/h2>\n<p>\u0623\u0631\u0633\u0644 \u0644\u0646\u0627 \u0639\u062f\u062f \u0627\u0644\u0645\u0633\u0627\u0641\u0631\u064a\u0646\u060c \u0623\u0639\u0645\u0627\u0631 \u0627\u0644\u0623\u0637\u0641\u0627\u0644\u060c \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0648\u0635\u0648\u0644 \u0648\u0639\u062f\u062f \u0627\u0644\u0644\u064a\u0627\u0644\u064a\u060c \u0648\u0633\u0646\u0642\u062a\u0631\u062d \u0628\u0631\u0646\u0627\u0645\u062c\u0627\u064b \u0633\u064a\u0627\u062d\u064a\u0627\u064b \u0645\u062a\u0648\u0627\u0632\u0646\u0627\u064b \u062f\u0648\u0646 \u062d\u0634\u0648 \u064a\u0648\u0645\u0643 \u0628\u0645\u0633\u0627\u0641\u0627\u062a \u063a\u064a\u0631 \u0648\u0627\u0642\u0639\u064a\u0629. \u0634\u0627\u0647\u062f <a href=\"https:\/\/arcadia-tour.com\/offers-bookings\/\">\u0627\u0644\u0639\u0631\u0648\u0636 \u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a<\/a> \u0623\u0648 \u062a\u0648\u0627\u0635\u0644 \u0639\u0628\u0631 \u0648\u0627\u062a\u0633\u0627\u0628 \u0639\u0644\u0649 <a href=\"https:\/\/wa.me\/77064007561\"><span dir=\"ltr\">+7 705 118 1845<\/span><\/a>.<\/p>","rendered":"<p>\u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0647\u0630\u0647 \u0632\u064a\u0627\u0631\u062a\u0643 \u0627\u0644\u0623\u0648\u0644\u0649\u060c \u0641\u0647\u0630\u0627 \u0627\u0644\u062f\u0644\u064a\u0644 \u064a\u062e\u062a\u0635\u0631 \u0623\u0647\u0645 \u0645\u0627 \u064a\u062d\u062a\u0627\u062c\u0647 <strong>\u0627\u0644\u0645\u0633\u0627\u0641\u0631 \u0627\u0644\u0639\u0631\u0628\u064a \u0625\u0644\u0649 <a href=\"https:\/\/arcadia-tour.com\/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3%d8%aa%d8%a7%d9%86\/\">\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/a><\/strong>: \u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u062f\u064a\u0646\u0629\u060c \u0627\u0644\u0644\u063a\u0629\u060c \u0627\u0644\u0637\u0639\u0627\u0645 \u0627\u0644\u062d\u0644\u0627\u0644\u060c \u0627\u0644\u0637\u0642\u0633\u060c \u0627\u0644\u062a\u0646\u0642\u0644 \u0648\u0637\u0631\u064a\u0642\u0629 \u0628\u0646\u0627\u0621 \u0628\u0631\u0646\u0627\u0645\u062c \u0645\u0631\u064a\u062d. \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u062f\u0648\u0644\u0629 \u0648\u0627\u0633\u0639\u0629\u060c \u0648\u0644\u0630\u0644\u0643 \u062a\u0643\u0648\u0646 \u0627\u0644\u0631\u062d\u0644\u0629 \u0623\u0641\u0636\u0644 \u0639\u0646\u062f\u0645\u0627 \u062a\u062e\u062a\u0627\u0631 \u0645\u062f\u064a\u0646\u062a\u064a\u0646 \u0623\u0648 \u062b\u0644\u0627\u062b\u0627\u064b \u0628\u062f\u0644 \u0645\u062d\u0627\u0648\u0644\u0629 \u0632\u064a\u0627\u0631\u0629 \u0645\u0646\u0627\u0637\u0642 \u0645\u062a\u0628\u0627\u0639\u062f\u0629 \u062e\u0644\u0627\u0644 \u0623\u064a\u0627\u0645 \u0642\u0644\u064a\u0644\u0629.<\/p>\n<h2>\u0644\u0645\u0627\u0630\u0627 \u062a\u0646\u0627\u0633\u0628 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0627\u0644\u0645\u0633\u0627\u0641\u0631 \u0627\u0644\u0639\u0631\u0628\u064a\u061f<\/h2>\n<p>\u062a\u062c\u0645\u0639 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0628\u064a\u0646 \u0645\u062f\u0646 \u062d\u062f\u064a\u062b\u0629 \u0648\u0637\u0628\u064a\u0639\u0629 \u062c\u0628\u0644\u064a\u0629 \u0648\u0628\u062d\u064a\u0631\u0627\u062a \u0648\u0623\u0648\u062f\u064a\u0629\u060c \u0645\u0639 \u062e\u064a\u0627\u0631\u0627\u062a \u062a\u0646\u0627\u0633\u0628 \u0627\u0644\u0639\u0627\u0626\u0644\u0627\u062a \u0648\u0627\u0644\u0623\u0632\u0648\u0627\u062c \u0648\u0645\u062d\u0628\u064a \u0627\u0644\u0645\u063a\u0627\u0645\u0631\u0629. \u0623\u0644\u0645\u0627\u062a\u064a \u0647\u064a \u0627\u0644\u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0644\u0644\u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u0628\u0633\u0628\u0628 \u0642\u0631\u0628\u0647\u0627 \u0645\u0646 \u0623\u0634\u0647\u0631 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u062a\u0636\u064a\u0641 \u0623\u0633\u062a\u0627\u0646\u0627 \u062a\u062c\u0631\u0628\u0629 \u0645\u062e\u062a\u0644\u0641\u0629 \u062a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u0627\u0631\u0629 \u0648\u0627\u0644\u0645\u062a\u0627\u062d\u0641. \u0648\u064a\u0645\u0643\u0646 \u0627\u062e\u062a\u064a\u0627\u0631 \u062a\u0631\u0643\u0633\u062a\u0627\u0646 \u0644\u0644\u062c\u0627\u0646\u0628 \u0627\u0644\u062a\u0627\u0631\u064a\u062e\u064a \u0623\u0648 \u0623\u0643\u062a\u0627\u0648 \u0648\u0645\u0627\u0646\u063a\u064a\u0633\u062a\u0627\u0648 \u0644\u0645\u0633\u0627\u0631 \u0635\u062d\u0631\u0627\u0648\u064a \u0645\u0633\u062a\u0642\u0644.<\/p>\n<p>\u0644\u0644\u0645\u0642\u0627\u0631\u0646\u0629 \u0628\u064a\u0646 \u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0648\u0645\u062f\u062f \u0627\u0644\u0625\u0642\u0627\u0645\u0629\u060c \u0631\u0627\u062c\u0639 <a href=\"https:\/\/arcadia-tour.com\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\/\u0627\u0644\u0645\u062f\u0646-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646-\u062a\u0639\u0631\u0641-\u0639\u0644\u0649-\u0623\u0647\u0645-9-\u0645\u062f\u0646-\u0633\u064a\u0627\u062d\u064a\u0629\/\">\u062f\u0644\u064a\u0644 \u0623\u0641\u0636\u0644 \u0645\u062f\u0646 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629<\/a>.<\/p>\n<h2>\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0633\u0631\u064a\u0639\u0629 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631<\/h2>\n<ul>\n<li><strong>\u0627\u0644\u0644\u063a\u0629:<\/strong> \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u064a\u0629 \u0648\u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0647\u0645\u0627 \u0627\u0644\u0623\u0643\u062b\u0631 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0627\u064b. \u0642\u062f \u062a\u062a\u0648\u0641\u0631 \u0627\u0644\u0625\u0646\u062c\u0644\u064a\u0632\u064a\u0629 \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u0641\u0646\u0627\u062f\u0642 \u0648\u0627\u0644\u0623\u0645\u0627\u0643\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629\u060c \u0644\u0643\u0646 \u0644\u0627 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u064a\u0647\u0627 \u0641\u064a \u0643\u0644 \u0627\u0644\u0645\u0648\u0627\u0642\u0639.<\/li>\n<li><strong>\u0627\u0644\u0639\u0645\u0644\u0629:<\/strong> \u0627\u0644\u062a\u0646\u063a\u064a \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a. \u062a\u062a\u063a\u064a\u0631 \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0631\u0641\u060c \u0644\u0630\u0644\u0643 \u0627\u0641\u062d\u0635 \u0627\u0644\u0633\u0639\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0645\u0646 \u0627\u0644\u0628\u0646\u0643 \u0623\u0648 \u062a\u0637\u0628\u064a\u0642 \u0645\u0648\u062b\u0648\u0642 \u0648\u0642\u062a \u0627\u0644\u0631\u062d\u0644\u0629.<\/li>\n<li><strong>\u0627\u0644\u0645\u0633\u0627\u0641\u0627\u062a:<\/strong> \u0628\u0639\u0636 \u0627\u0644\u0628\u062d\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0623\u0648\u062f\u064a\u0629 \u0644\u064a\u0633\u062a \u062f\u0627\u062e\u0644 \u0623\u0644\u0645\u0627\u062a\u064a\u060c \u0648\u0642\u062f \u062a\u0633\u062a\u063a\u0631\u0642 \u0627\u0644\u0631\u062d\u0644\u0629 \u0625\u0644\u064a\u0647\u0627 \u064a\u0648\u0645\u0627\u064b \u0643\u0627\u0645\u0644\u0627\u064b.<\/li>\n<li><strong>\u0627\u0644\u0637\u0642\u0633:<\/strong> \u064a\u062e\u062a\u0644\u0641 \u0628\u0648\u0636\u0648\u062d \u0628\u064a\u0646 \u0627\u0644\u0645\u062f\u0646 \u0648\u0627\u0644\u062c\u0628\u0627\u0644\u061b \u0627\u0641\u062d\u0635 \u062a\u0648\u0642\u0639\u0627\u062a \u0643\u0644 \u0645\u0646\u0637\u0642\u0629 \u0642\u0628\u0644 \u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0645\u0644\u0627\u0628\u0633.<\/li>\n<li><strong>\u0627\u0644\u0627\u062a\u0635\u0627\u0644:<\/strong> \u0627\u062d\u062a\u0641\u0638 \u0628\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0645\u0643\u062a\u0648\u0628\u0629 \u0628\u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0623\u0648 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u064a\u0629\u060c \u0648\u0646\u0632\u0651\u0644 \u0627\u0644\u062e\u0631\u0627\u0626\u0637 \u0644\u0644\u0631\u062c\u0648\u0639 \u0625\u0644\u064a\u0647\u0627 \u062f\u0648\u0646 \u0625\u0646\u062a\u0631\u0646\u062a.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u0644\u063a\u0629 \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0644\u0644\u0645\u0633\u0627\u0641\u0631 \u0627\u0644\u0639\u0631\u0628\u064a<\/h2>\n<p>\u0645\u0646 \u0627\u0644\u0645\u0641\u064a\u062f \u062d\u0641\u0638 \u0639\u0628\u0627\u0631\u0627\u062a \u0628\u0633\u064a\u0637\u0629 \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0637\u0628\u064a\u0642 \u062a\u0631\u062c\u0645\u0629 \u064a\u062f\u0639\u0645 \u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u062f\u0648\u0646 \u0627\u062a\u0635\u0627\u0644. \u0639\u0646\u062f \u0637\u0644\u0628 \u0633\u064a\u0627\u0631\u0629 \u0623\u0648 \u0632\u064a\u0627\u0631\u0629 \u0645\u0646\u0637\u0642\u0629 \u0637\u0628\u064a\u0639\u064a\u0629\u060c \u0623\u0631\u0633\u0644 \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a \u0644\u0644\u0633\u0627\u0626\u0642 \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0646\u0637\u0642 \u0627\u0644\u0627\u0633\u0645 \u0641\u0642\u0637. \u0648\u062c\u0648\u062f \u0645\u0631\u0634\u062f \u0639\u0631\u0628\u064a \u064a\u0643\u0648\u0646 \u0645\u0641\u064a\u062f\u0627\u064b \u062e\u0635\u0648\u0635\u0627\u064b \u0644\u0644\u0639\u0627\u0626\u0644\u0627\u062a \u0648\u0641\u064a \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u062c\u0628\u0644\u064a\u0629 \u0627\u0644\u062a\u064a \u062a\u062d\u062a\u0627\u062c \u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0645\u0633\u0627\u0631 \u0648\u0627\u0644\u062a\u0648\u0642\u064a\u062a.<\/p>\n<h2>\u0627\u0644\u0637\u0639\u0627\u0645 \u0627\u0644\u062d\u0644\u0627\u0644 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/h2>\n<p>\u062a\u0648\u062c\u062f \u0645\u0637\u0627\u0639\u0645 \u062a\u0642\u062f\u0645 \u0637\u0639\u0627\u0645\u0627\u064b \u062d\u0644\u0627\u0644\u0627\u064b\u060c \u0648\u0644\u0627 \u0633\u064a\u0645\u0627 \u0641\u064a \u0623\u0644\u0645\u0627\u062a\u064a \u0648\u0623\u0633\u062a\u0627\u0646\u0627\u060c \u0644\u0643\u0646 \u0627\u0644\u0623\u0641\u0636\u0644 \u0633\u0624\u0627\u0644 \u0627\u0644\u0645\u0637\u0639\u0645 \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0646 \u0645\u0635\u062f\u0631 \u0627\u0644\u0644\u062d\u0648\u0645 \u0648\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u062d\u0636\u064a\u0631 \u0644\u0623\u0646 \u062a\u0648\u0641\u0631 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u064a\u062e\u062a\u0644\u0641 \u0645\u0646 \u0645\u0643\u0627\u0646 \u0625\u0644\u0649 \u0622\u062e\u0631. \u0627\u0628\u062d\u062b \u0639\u0646 \u0643\u0644\u0645\u0629 <strong>Halal<\/strong> \u0623\u0648 \u0627\u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0645\u0646 \u0627\u0644\u0641\u0646\u062f\u0642\u060c \u0648\u0627\u062d\u062a\u0641\u0638 \u0628\u062e\u064a\u0627\u0631\u0627\u062a \u0628\u062f\u064a\u0644\u0629 \u0642\u0631\u0628 \u0645\u0643\u0627\u0646 \u0627\u0644\u0633\u0643\u0646 \u0642\u0628\u0644 \u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642 \u0625\u0644\u0649 \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0628\u0639\u064a\u062f\u0629.<\/p>\n<p>\u0627\u0644\u0645\u0637\u0628\u062e \u0627\u0644\u0645\u062d\u0644\u064a \u064a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0627\u0644\u0644\u062d\u0648\u0645 \u0648\u0627\u0644\u0639\u062c\u064a\u0646 \u0648\u0627\u0644\u0623\u0631\u0632\u060c \u0648\u0645\u0646 \u0623\u0634\u0647\u0631 \u0627\u0644\u0623\u0637\u0628\u0627\u0642 \u0627\u0644\u0628\u0634\u0628\u0631\u0645\u0627\u0643 \u0648\u0627\u0644\u0628\u0644\u0648\u0641. \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0644\u062f\u064a\u0643 \u062d\u0633\u0627\u0633\u064a\u0629 \u063a\u0630\u0627\u0626\u064a\u0629 \u0623\u0648 \u062a\u0641\u0636\u064a\u0644\u0627\u062a \u062e\u0627\u0635\u0629\u060c \u0627\u0643\u062a\u0628\u0647\u0627 \u0628\u0648\u0636\u0648\u062d \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0631\u062c\u0645\u0629.<\/p>\n<h2>\u0623\u0641\u0636\u0644 \u0645\u062f\u0646 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0644\u0632\u064a\u0627\u0631\u0629 \u0627\u0644\u0623\u0648\u0644\u0649<\/h2>\n<h3>\u0623\u0644\u0645\u0627\u062a\u064a \u0648\u0627\u0644\u0637\u0628\u064a\u0639\u0629 \u0627\u0644\u0645\u062d\u064a\u0637\u0629<\/h3>\n<p>\u0623\u0644\u0645\u0627\u062a\u064a \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0644\u0639\u0627\u0626\u0644\u0627\u062a \u0648\u0645\u062d\u0628\u064a \u0627\u0644\u0637\u0628\u064a\u0639\u0629. \u064a\u0645\u0643\u0646 \u062a\u062e\u0635\u064a\u0635 \u064a\u0648\u0645 \u0644\u0644\u0645\u062f\u064a\u0646\u0629\u060c \u062b\u0645 \u0623\u064a\u0627\u0645 \u0645\u0646\u0641\u0635\u0644\u0629 \u0644\u0648\u062c\u0647\u0627\u062a \u0645\u062b\u0644 \u0648\u0627\u062f\u064a \u0634\u0627\u0631\u064a\u0646 \u0623\u0648 \u0628\u062d\u064a\u0631\u0627\u062a \u0643\u0648\u0644\u0633\u0627\u064a \u0648\u0643\u0627\u064a\u0646\u062f\u064a \u0648\u0641\u0642 \u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0631\u064a\u0642 \u0648\u0627\u0644\u0645\u0648\u0633\u0645. \u0644\u0627 \u062a\u062c\u0645\u0639 \u0631\u062d\u0644\u062a\u064a\u0646 \u0637\u0628\u064a\u0639\u064a\u062a\u064a\u0646 \u0628\u0639\u064a\u062f\u062a\u064a\u0646 \u0641\u064a \u064a\u0648\u0645 \u0648\u0627\u062d\u062f.<\/p>\n<h3>\u0623\u0633\u062a\u0627\u0646\u0627<\/h3>\n<p>\u0623\u0633\u062a\u0627\u0646\u0627 \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0625\u0642\u0627\u0645\u0629 \u0642\u0635\u064a\u0631\u0629 \u0645\u0646 \u0644\u064a\u0644\u062a\u064a\u0646 \u0625\u0644\u0649 \u062b\u0644\u0627\u062b \u0644\u064a\u0627\u0644\u064d\u060c \u0648\u062a\u062e\u062a\u0644\u0641 \u0623\u062c\u0648\u0627\u0624\u0647\u0627 \u0639\u0646 \u0623\u0644\u0645\u0627\u062a\u064a \u0628\u0639\u0645\u0627\u0631\u062a\u0647\u0627 \u0627\u0644\u062d\u062f\u064a\u062b\u0629 \u0648\u0645\u062a\u0627\u062d\u0641\u0647\u0627. \u0627\u0644\u0631\u064a\u0627\u062d \u0648\u0627\u0644\u0628\u0631\u062f \u0639\u0627\u0645\u0644\u0627\u0646 \u0645\u0647\u0645\u0627\u0646 \u0639\u0646\u062f \u062a\u062e\u0637\u064a\u0637 \u0627\u0644\u0645\u0634\u064a \u0641\u064a \u0627\u0644\u0634\u062a\u0627\u0621.<\/p>\n<h3>\u062a\u0631\u0643\u0633\u062a\u0627\u0646 \u0623\u0648 \u0623\u0643\u062a\u0627\u0648<\/h3>\n<p>\u0627\u062e\u062a\u0631 \u062a\u0631\u0643\u0633\u062a\u0627\u0646 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0647\u062a\u0645\u0627\u0645\u0643 \u0628\u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0648\u0637\u0631\u064a\u0642 \u0627\u0644\u062d\u0631\u064a\u0631\u060c \u0648\u0627\u062e\u062a\u0631 \u0623\u0643\u062a\u0627\u0648 \u0648\u0645\u0627\u0646\u063a\u064a\u0633\u062a\u0627\u0648 \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0631\u064a\u062f \u0631\u062d\u0644\u0629 \u0635\u062d\u0631\u0627\u0648\u064a\u0629 \u0648\u0633\u0627\u062d\u0644\u064a\u0629 \u0645\u0633\u062a\u0642\u0644\u0629. \u0647\u0630\u0647 \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a \u062a\u062d\u062a\u0627\u062c \u0648\u0642\u062a\u0627\u064b \u0648\u062a\u0646\u0642\u0644\u0627\u064b \u062e\u0627\u0635\u0627\u064b \u0648\u0644\u0627 \u062a\u064f\u0636\u0627\u0641 \u0633\u0631\u064a\u0639\u0627\u064b \u0625\u0644\u0649 \u0628\u0631\u0646\u0627\u0645\u062c \u0623\u0644\u0645\u0627\u062a\u064a.<\/p>\n<h2>\u0645\u062a\u0649 \u062a\u0633\u0627\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h2>\n<p><strong>\u0627\u0644\u0635\u064a\u0641<\/strong> \u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u062c\u0628\u0627\u0644 \u0648\u0627\u0644\u0628\u062d\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0639\u0627\u0626\u0644\u064a\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u0645\u0646\u062d <strong>\u0627\u0644\u0631\u0628\u064a\u0639 \u0648\u0627\u0644\u062e\u0631\u064a\u0641<\/strong> \u0623\u062c\u0648\u0627\u0621 \u0623\u0644\u0637\u0641 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062f\u0646 \u0645\u0639 \u0636\u0631\u0648\u0631\u0629 \u0627\u0644\u0627\u0633\u062a\u0639\u062f\u0627\u062f \u0644\u062a\u063a\u064a\u0631 \u0627\u0644\u0637\u0642\u0633. \u0623\u0645\u0627 <strong>\u0627\u0644\u0634\u062a\u0627\u0621<\/strong> \u0641\u064a\u0646\u0627\u0633\u0628 \u0627\u0644\u062b\u0644\u0648\u062c \u0648\u0627\u0644\u062a\u0632\u0644\u062c\u060c \u0644\u0643\u0646\u0647 \u064a\u062d\u062a\u0627\u062c \u0645\u0644\u0627\u0628\u0633 \u0648\u062a\u062c\u0647\u064a\u0632\u0627\u064b \u0645\u0646\u0627\u0633\u0628\u0627\u064b \u0648\u0645\u0631\u0648\u0646\u0629 \u0639\u0646\u062f \u062a\u063a\u064a\u0631 \u0627\u0644\u0623\u062d\u0648\u0627\u0644 \u0627\u0644\u062c\u0648\u064a\u0629.<\/p>\n<p>\u0644\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u0645\u0648\u0633\u0645\u064a\u0629 \u0648\u0627\u0644\u0648\u062c\u0647\u0627\u062a\u060c \u0627\u0642\u0631\u0623 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-tourism-overview\/\">\u062f\u0644\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 2026<\/a>.<\/p>\n<h2>\u0627\u0644\u062a\u0646\u0642\u0644 \u0648\u0627\u0644\u0633\u0643\u0646<\/h2>\n<p>\u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062f\u0646\u060c \u0627\u0633\u062a\u062e\u062f\u0645 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0646\u0642\u0644 \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u0629 \u0623\u0648 \u0633\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u0641\u0646\u062f\u0642\u060c \u0648\u062a\u0623\u0643\u062f \u0645\u0646 \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u0631\u0643\u0628\u0629 \u0642\u0628\u0644 \u0627\u0644\u0635\u0639\u0648\u062f. \u0623\u0645\u0627 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u062c\u0628\u0644\u064a\u0629 \u0648\u0627\u0644\u0637\u0631\u0642 \u0627\u0644\u0637\u0648\u064a\u0644\u0629 \u0641\u062a\u062d\u062a\u0627\u062c \u0633\u064a\u0627\u0631\u0629 \u0645\u0646\u0627\u0633\u0628\u0629 \u0648\u0633\u0627\u0626\u0642\u0627\u064b \u064a\u0639\u0631\u0641 \u0627\u0644\u0645\u0646\u0637\u0642\u0629. \u0627\u062e\u062a\u0631 \u0627\u0644\u0633\u0643\u0646 \u0628\u062d\u0633\u0628 \u0628\u0631\u0646\u0627\u0645\u062c\u0643: \u0648\u0633\u0637 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u0645\u0637\u0627\u0639\u0645 \u0648\u0627\u0644\u062a\u0633\u0648\u0642\u060c \u0628\u064a\u0646\u0645\u0627 \u0627\u0644\u0633\u0643\u0646 \u0627\u0644\u0628\u0639\u064a\u062f \u0642\u062f \u064a\u0632\u064a\u062f \u0648\u0642\u062a \u0627\u0644\u062a\u0646\u0642\u0644 \u0627\u0644\u064a\u0648\u0645\u064a.<\/p>\n<h2>\u0646\u0635\u0627\u0626\u062d \u0644\u0644\u0639\u0627\u0626\u0644\u0627\u062a<\/h2>\n<ul>\n<li>\u0627\u062a\u0631\u0643 \u0648\u0642\u062a\u0627\u064b \u0644\u0644\u0631\u0627\u062d\u0629 \u0628\u064a\u0646 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0637\u0648\u064a\u0644\u0629\u060c \u062e\u0627\u0635\u0629 \u0645\u0639 \u0627\u0644\u0623\u0637\u0641\u0627\u0644.<\/li>\n<li>\u0644\u0627 \u062a\u062c\u0639\u0644 \u064a\u0648\u0645 \u0627\u0644\u0648\u0635\u0648\u0644 \u064a\u0648\u0645\u0627\u064b \u0644\u0631\u062d\u0644\u0629 \u062c\u0628\u0644\u064a\u0629 \u0628\u0639\u064a\u062f\u0629.<\/li>\n<li>\u0627\u062d\u0645\u0644 \u0645\u0627\u0621\u064b \u0648\u0648\u062c\u0628\u0629 \u062e\u0641\u064a\u0641\u0629 \u0648\u0645\u0644\u0627\u0628\u0633 \u0625\u0636\u0627\u0641\u064a\u0629 \u0639\u0646\u062f \u0627\u0644\u062e\u0631\u0648\u062c \u0644\u0644\u0637\u0628\u064a\u0639\u0629.<\/li>\n<li>\u062b\u0628\u0651\u062a \u0646\u0642\u0637\u0629 \u062a\u062c\u0645\u0639 \u0648\u0627\u0636\u062d\u0629 \u0648\u0627\u062d\u0641\u0638 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0641\u0646\u062f\u0642 \u0639\u0644\u0649 \u0647\u0648\u0627\u062a\u0641 \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0639\u0627\u0626\u0644\u0629.<\/li>\n<li>\u0641\u064a \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u0627\u0644\u0637\u0627\u0631\u0626\u0629 \u062f\u0627\u062e\u0644 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u060c \u0627\u0644\u0631\u0642\u0645 \u0627\u0644\u0645\u0648\u062d\u062f \u0647\u0648 <a href=\"https:\/\/www.gov.kz\/situations\/729\/1519?lang=ru\" rel=\"noopener noreferrer\" target=\"_blank\"><span dir=\"ltr\">112<\/span><\/a>.<\/li>\n<\/ul>\n<h2>\u0628\u0631\u0646\u0627\u0645\u062c \u0645\u0642\u062a\u0631\u062d \u0644\u0623\u0648\u0644 \u0631\u062d\u0644\u0629<\/h2>\n<p>\u0644\u0631\u062d\u0644\u0629 \u0645\u0646 \u0633\u0628\u0639\u0629 \u0625\u0644\u0649 \u062a\u0633\u0639\u0629 \u0623\u064a\u0627\u0645\u060c \u0627\u062c\u0639\u0644 \u0623\u0644\u0645\u0627\u062a\u064a \u0642\u0627\u0639\u062f\u0629 \u0631\u0626\u064a\u0633\u064a\u0629 \u0645\u0639 \u064a\u0648\u0645 \u0644\u0644\u0645\u062f\u064a\u0646\u0629 \u0648\u064a\u0648\u0645\u064a\u0646 \u0623\u0648 \u062b\u0644\u0627\u062b\u0629 \u0644\u0644\u0637\u0628\u064a\u0639\u0629\u060c \u062b\u0645 \u0623\u0636\u0641 \u0623\u0633\u062a\u0627\u0646\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0627\u0644\u062f\u0627\u062e\u0644\u064a \u0648\u0627\u0644\u0648\u0642\u062a \u0645\u0646\u0627\u0633\u0628\u064a\u0646. \u0623\u0645\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0644\u0644\u0631\u0627\u062d\u0629\u060c \u0641\u0627\u0628\u0642\u064e \u0641\u064a \u0645\u0646\u0637\u0642\u0629 \u0623\u0644\u0645\u0627\u062a\u064a \u0648\u0627\u062e\u062a\u0631 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u064a\u0648\u0645\u064a\u0629 \u0628\u0639\u0646\u0627\u064a\u0629. \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0627\u0637\u0644\u0627\u0639 \u0639\u0644\u0649 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-7-days-2\/\">\u0628\u0631\u0646\u0627\u0645\u062c \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0645\u062f\u0629 7 \u0623\u064a\u0627\u0645<\/a> \u0643\u0646\u0642\u0637\u0629 \u0628\u062f\u0627\u064a\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u0639\u062f\u064a\u0644.<\/p>\n<h2>\u062e\u0637\u0637 \u0631\u062d\u0644\u062a\u0643 \u0645\u0639 \u0623\u0631\u0643\u0627\u062f\u064a\u0627<\/h2>\n<p>\u0623\u0631\u0633\u0644 \u0644\u0646\u0627 \u0639\u062f\u062f \u0627\u0644\u0645\u0633\u0627\u0641\u0631\u064a\u0646\u060c \u0623\u0639\u0645\u0627\u0631 \u0627\u0644\u0623\u0637\u0641\u0627\u0644\u060c \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0648\u0635\u0648\u0644 \u0648\u0639\u062f\u062f \u0627\u0644\u0644\u064a\u0627\u0644\u064a\u060c \u0648\u0633\u0646\u0642\u062a\u0631\u062d \u0628\u0631\u0646\u0627\u0645\u062c\u0627\u064b \u0633\u064a\u0627\u062d\u064a\u0627\u064b \u0645\u062a\u0648\u0627\u0632\u0646\u0627\u064b \u062f\u0648\u0646 \u062d\u0634\u0648 \u064a\u0648\u0645\u0643 \u0628\u0645\u0633\u0627\u0641\u0627\u062a \u063a\u064a\u0631 \u0648\u0627\u0642\u0639\u064a\u0629. \u0634\u0627\u0647\u062f <a href=\"https:\/\/arcadia-tour.com\/offers-bookings\/\">\u0627\u0644\u0639\u0631\u0648\u0636 \u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a<\/a> \u0623\u0648 \u062a\u0648\u0627\u0635\u0644 \u0639\u0628\u0631 \u0648\u0627\u062a\u0633\u0627\u0628 \u0639\u0644\u0649 <a href=\"https:\/\/wa.me\/77064007561\"><span dir=\"ltr\">+7 705 118 1845<\/span><\/a>.<\/p>\n","protected":false,"block_version":0}}