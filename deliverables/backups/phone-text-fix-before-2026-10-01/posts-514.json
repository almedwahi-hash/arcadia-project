{"id":514,"link":"https:\/\/arcadia-tour.com\/%d8%af%d9%84%d9%8a%d9%84-%d8%b4%d8%a7%d9%85%d9%84-%d8%ad%d9%88%d9%84-%d8%a5%d8%ac%d8%b1%d8%a7%d8%a1%d8%a7%d8%aa-%d8%a7%d9%84%d8%b3%d9%81%d8%b1-%d8%a5%d9%84%d9%89-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3\/","content":{"raw":"<p>\u062a\u0628\u062f\u0623 \u0631\u062d\u0644\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0627\u0644\u0646\u0627\u062c\u062d\u0629 \u0642\u0628\u0644 \u0645\u0648\u0639\u062f \u0627\u0644\u0637\u064a\u0631\u0627\u0646: \u062c\u0648\u0627\u0632 \u0635\u0627\u0644\u062d\u060c \u062d\u062c\u0648\u0632\u0627\u062a \u0648\u0627\u0636\u062d\u0629\u060c \u0628\u0631\u0646\u0627\u0645\u062c \u064a\u0646\u0627\u0633\u0628 \u0627\u0644\u0645\u0633\u0627\u0641\u0627\u062a \u0648\u0627\u0644\u0637\u0642\u0633\u060c \u0648\u062e\u0637\u0629 \u0644\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0648\u0627\u0644\u062a\u0646\u0642\u0644. \u0647\u0630\u0647 <strong>\u0642\u0627\u0626\u0645\u0629 \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 2026<\/strong> \u062a\u0633\u0627\u0639\u062f\u0643 \u0639\u0644\u0649 \u062a\u062c\u0647\u064a\u0632 \u0631\u062d\u0644\u062a\u0643 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629 \u062f\u0648\u0646 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0642\u062f\u064a\u0645\u0629 \u0623\u0648 \u0645\u064a\u0632\u0627\u0646\u064a\u0627\u062a \u0639\u0627\u0645\u0629 \u0644\u0627 \u062a\u0646\u0627\u0633\u0628 \u0627\u0644\u062c\u0645\u064a\u0639.<\/p>\n\n<h2>\u0642\u0627\u0626\u0645\u0629 \u0633\u0631\u064a\u0639\u0629 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/h2>\n<ul>\n  <li>\u062a\u062d\u0642\u0642 \u0645\u0646 \u0635\u0644\u0627\u062d\u064a\u0629 \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631 \u0648\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0634\u0631\u0643\u0629 \u0627\u0644\u0637\u064a\u0631\u0627\u0646.<\/li>\n  <li>\u0631\u0627\u062c\u0639 \u0646\u0638\u0627\u0645 \u0627\u0644\u062f\u062e\u0648\u0644 \u0627\u0644\u0631\u0633\u0645\u064a \u0648\u0641\u0642 \u062c\u0646\u0633\u064a\u062a\u0643 \u0648\u0645\u062f\u0629 \u0627\u0644\u0625\u0642\u0627\u0645\u0629.<\/li>\n  <li>\u0627\u062d\u062a\u0641\u0638 \u0628\u062d\u062c\u0648\u0632\u0627\u062a \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0648\u0627\u0644\u0633\u0643\u0646 \u0648\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0625\u0642\u0627\u0645\u0629.<\/li>\n  <li>\u0627\u062e\u062a\u0631 \u0645\u062f\u064a\u0646\u062a\u064a\u0646 \u0623\u0648 \u062b\u0644\u0627\u062b\u0627\u064b \u062d\u0633\u0628 \u0639\u062f\u062f \u0627\u0644\u0623\u064a\u0627\u0645\u060c \u0648\u0644\u0627 \u062a\u062c\u0645\u0639 \u0645\u0633\u0627\u0641\u0627\u062a \u0628\u0639\u064a\u062f\u0629 \u0641\u064a \u064a\u0648\u0645 \u0648\u0627\u062d\u062f.<\/li>\n  <li>\u0631\u062a\u0628 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0631 \u0648\u0627\u0644\u062a\u0646\u0642\u0644\u0627\u062a \u0648\u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629 \u0645\u0633\u0628\u0642\u0627\u064b.<\/li>\n  <li>\u0627\u0634\u062a\u0631\u0650 \u062a\u0623\u0645\u064a\u0646 \u0633\u0641\u0631 \u0645\u0646\u0627\u0633\u0628\u0627\u064b \u0648\u0627\u062d\u062a\u0641\u0638 \u0628\u0646\u0633\u062e \u0631\u0642\u0645\u064a\u0629 \u0645\u0646 \u0645\u0633\u062a\u0646\u062f\u0627\u062a\u0643.<\/li>\n  <li>\u0627\u0641\u062d\u0635 \u0627\u0644\u0637\u0642\u0633 \u0644\u0643\u0644 \u0645\u062f\u064a\u0646\u0629 \u0648\u0645\u0646\u0637\u0642\u0629 \u062c\u0628\u0644\u064a\u0629 \u0642\u0628\u0644 \u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0645\u0644\u0627\u0628\u0633.<\/li>\n<\/ul>\n\n<h2>\u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631 \u0648\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062f\u062e\u0648\u0644<\/h2>\n<p>\u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631 \u0635\u0627\u0644\u062d\u0627\u064b \u0644\u0644\u0631\u062d\u0644\u0629 \u0648\u0623\u0646 \u062a\u062a\u0637\u0627\u0628\u0642 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u062c\u0632 \u0645\u0639\u0647. \u0645\u062f\u0629 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0648\u0634\u0631\u0648\u0637 \u0627\u0644\u062f\u062e\u0648\u0644 \u0642\u062f \u062a\u062e\u062a\u0644\u0641 \u0628\u062d\u0633\u0628 \u0627\u0644\u062c\u0646\u0633\u064a\u0629 \u0648\u0634\u0631\u0643\u0629 \u0627\u0644\u0637\u064a\u0631\u0627\u0646\u060c \u0644\u0630\u0644\u0643 \u062a\u062d\u0642\u0642 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631 \u0645\u0646 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0648\u0645\u0646 \u0627\u0644\u0646\u0627\u0642\u0644 \u0627\u0644\u062c\u0648\u064a\u060c \u0648\u0644\u0627 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u062a\u062c\u0631\u0628\u0629 \u0645\u0633\u0627\u0641\u0631 \u0622\u062e\u0631.<\/p>\n<p>\u0628\u062d\u0633\u0628 <a href=\"https:\/\/www.gov.kz\/memleket\/entities\/mfa\/activities\/34747?lang=en&amp;parentId=3053\" target=\"_blank\" rel=\"noopener noreferrer\">\u062c\u062f\u0648\u0644 \u0648\u0632\u0627\u0631\u0629 \u062e\u0627\u0631\u062c\u064a\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/a>\u060c \u064a\u0633\u062a\u0637\u064a\u0639 \u062d\u0627\u0645\u0644\u0648 \u0627\u0644\u062c\u0648\u0627\u0632\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0645\u0646 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0643\u0648\u064a\u062a \u0648\u0642\u0637\u0631 \u0648\u0627\u0644\u0628\u062d\u0631\u064a\u0646 \u0648\u0639\u064f\u0645\u0627\u0646 \u0627\u0644\u062f\u062e\u0648\u0644 \u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0644\u0644\u0625\u0642\u0627\u0645\u0629 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0627\u0644\u0642\u0635\u064a\u0631\u0629 \u062d\u062a\u0649 30 \u064a\u0648\u0645\u0627\u064b\u060c \u0645\u0639 \u0645\u0631\u0627\u0639\u0627\u0629 \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0646\u0638\u0627\u0645\u064a\u0629 \u0627\u0644\u0645\u062d\u062f\u062b\u0629 \u0648\u0642\u062a \u0627\u0644\u0633\u0641\u0631.<\/p>\n<div class=\"arcadia-info-note\" style=\"border-right:4px solid #c9a227;padding:14px 16px;margin:20px 0;background:#faf8f1\"><strong>\u0645\u0647\u0645:<\/strong> \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0644\u0627 \u062a\u0633\u062a\u062e\u0631\u062c \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0644\u0627 \u062e\u0637\u0627\u0628\u0627\u062a \u0627\u0644\u062f\u0639\u0648\u0629. \u0646\u0642\u062f\u0645 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u062c\u0647\u0629 \u0641\u0642\u0637.<\/div>\n\n<h2>\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0648\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062d\u0645\u0644\u0647\u0627<\/h2>\n<p>\u0627\u062d\u062a\u0641\u0638 \u0639\u0644\u0649 \u0647\u0627\u062a\u0641\u0643 \u0648\u0646\u0633\u062e\u0629 \u0633\u062d\u0627\u0628\u064a\u0629 \u0628\u0635\u0648\u0631\u0629 \u0627\u0644\u062c\u0648\u0627\u0632\u060c \u062a\u0630\u0643\u0631\u0629 \u0627\u0644\u0639\u0648\u062f\u0629 \u0623\u0648 \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629\u060c \u062d\u062c\u0632 \u0627\u0644\u0633\u0643\u0646\u060c \u0648\u062b\u064a\u0642\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0648\u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u062a\u0648\u0627\u0635\u0644. \u0642\u062f \u062a\u0637\u0644\u0628 \u062c\u0647\u0629 \u0627\u0644\u0633\u0641\u0631 \u0623\u0648 \u0627\u0644\u062d\u062f\u0648\u062f \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629 \u0648\u0641\u0642 \u062d\u0627\u0644\u062a\u0643\u060c \u0644\u0630\u0627 \u0631\u0627\u062c\u0639 \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0642\u0628\u0644 \u0645\u0648\u0639\u062f \u0627\u0644\u0631\u062d\u0644\u0629.<\/p>\n<p>\u0627\u0643\u062a\u0628 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u0631\u0642\u0645 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u062a\u064a \u064a\u0638\u0647\u0631 \u0628\u0647\u0627 \u0641\u064a \u0627\u0644\u062d\u062c\u0632\u060c \u0641\u0647\u0630\u0627 \u064a\u0633\u0627\u0639\u062f \u0639\u0646\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0633\u064a\u0627\u0631\u0629 \u0627\u0644\u0623\u062c\u0631\u0629.<\/p>\n\n<h2>\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u062f\u0646 \u0648\u0645\u062f\u0629 \u0627\u0644\u0631\u062d\u0644\u0629<\/h2>\n<p>\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0648\u0627\u0633\u0639\u0629\u060c \u0648\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u062f\u0629 \u0648\u0627\u062d\u062f\u0629 \u0645\u062b\u0627\u0644\u064a\u0629 \u0644\u0644\u062c\u0645\u064a\u0639. \u0631\u062d\u0644\u0629 \u0645\u0646 7 \u0625\u0644\u0649 9 \u0623\u064a\u0627\u0645 \u062a\u0633\u0645\u062d \u063a\u0627\u0644\u0628\u0627\u064b \u0628\u062c\u0639\u0644 \u0623\u0644\u0645\u0627\u062a\u064a \u0642\u0627\u0639\u062f\u0629 \u0631\u0626\u064a\u0633\u064a\u0629 \u0645\u0639 \u0631\u062d\u0644\u0627\u062a \u0637\u0628\u064a\u0639\u064a\u0629\u060c \u0648\u064a\u0645\u0643\u0646 \u0625\u0636\u0627\u0641\u0629 \u0623\u0633\u062a\u0627\u0646\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u062c\u062f\u0648\u0644 \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0645\u0646\u0627\u0633\u0628\u0627\u064b. \u0623\u0645\u0627 \u0623\u0643\u062a\u0627\u0648 \u0648\u0645\u0627\u0646\u063a\u064a\u0633\u062a\u0627\u0648 \u0623\u0648 \u062a\u0631\u0643\u0633\u062a\u0627\u0646 \u0648\u0627\u0644\u062c\u0646\u0648\u0628 \u0641\u062a\u062d\u062a\u0627\u062c \u0645\u0633\u0627\u0631\u0627\u064b \u0645\u0633\u062a\u0642\u0644\u0627\u064b \u0623\u0648 \u0623\u064a\u0627\u0645\u0627\u064b \u0625\u0636\u0627\u0641\u064a\u0629.<\/p>\n<p>\u0642\u0627\u0631\u0646 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\/\u0627\u0644\u0645\u062f\u0646-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646-\u062a\u0639\u0631\u0641-\u0639\u0644\u0649-\u0623\u0647\u0645-9-\u0645\u062f\u0646-\u0633\u064a\u0627\u062d\u064a\u0629\/\">\u062f\u0644\u064a\u0644 \u0645\u062f\u0646 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629<\/a>\u060c \u0623\u0648 \u0627\u0628\u062f\u0623 \u0645\u0646 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-7-days-2\/\">\u0628\u0631\u0646\u0627\u0645\u062c \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0645\u062f\u0629 7 \u0623\u064a\u0627\u0645<\/a>.<\/p>\n\n<h2>\u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0648\u0627\u0644\u062a\u0646\u0642\u0644<\/h2>\n<p>\u0631\u062a\u0628 \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0648\u0635\u0648\u0644 \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0631 \u0642\u0628\u0644 \u0627\u0644\u0625\u0642\u0644\u0627\u0639\u060c \u062e\u0627\u0635\u0629 \u0639\u0646\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0644\u064a\u0644\u0627\u064b \u0623\u0648 \u0645\u0639 \u0627\u0644\u0623\u0637\u0641\u0627\u0644. \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062f\u0646 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0646\u0642\u0644 \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u0629 \u0623\u0648 \u0633\u064a\u0627\u0631\u0629 \u0627\u0644\u0641\u0646\u062f\u0642\u060c \u0623\u0645\u0627 \u0627\u0644\u0628\u062d\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0623\u0648\u062f\u064a\u0629 \u0648\u0627\u0644\u0637\u0631\u0642 \u0627\u0644\u062c\u0628\u0644\u064a\u0629 \u0641\u062a\u062d\u062a\u0627\u062c \u0633\u064a\u0627\u0631\u0629 \u0645\u0646\u0627\u0633\u0628\u0629 \u0648\u0633\u0627\u0626\u0642\u0627\u064b \u064a\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u0627\u0631.<\/p>\n<p>\u062a\u0623\u0643\u062f \u0645\u0646 \u0648\u0642\u062a \u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642 \u0648\u0627\u0644\u0639\u0648\u062f\u0629 \u0648\u0645\u0627 \u064a\u0634\u0645\u0644\u0647 \u0627\u0644\u0633\u0639\u0631\u060c \u0648\u0644\u0627 \u062a\u0636\u0639 \u0631\u062d\u0644\u062a\u064a\u0646 \u0637\u0628\u064a\u0639\u064a\u062a\u064a\u0646 \u0628\u0639\u064a\u062f\u062a\u064a\u0646 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0646\u0641\u0633\u0647. \u0628\u0639\u0636 \u0627\u0644\u0648\u062c\u0647\u0627\u062a \u062a\u062a\u0623\u062b\u0631 \u0628\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0631\u064a\u0642 \u0648\u0627\u0644\u0637\u0642\u0633 \u0648\u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u0648\u0633\u0645\u064a.<\/p>\n\n<h2>\u0627\u0644\u0633\u0643\u0646 \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u0639\u0627\u0626\u0644\u0629<\/h2>\n<p>\u0627\u062e\u062a\u0631 \u0627\u0644\u0633\u0643\u0646 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0628\u0631\u0646\u0627\u0645\u062c\u0643 \u0644\u0627 \u0639\u0644\u0649 \u0627\u0644\u0633\u0639\u0631 \u0648\u062d\u062f\u0647. \u0642\u0631\u0628 \u0627\u0644\u0641\u0646\u062f\u0642 \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0639\u0645 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0646\u0642\u0627\u0637 \u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642 \u0642\u062f \u064a\u0648\u0641\u0631 \u0648\u0642\u062a\u0627\u064b \u064a\u0648\u0645\u064a\u0627\u064b \u0643\u0628\u064a\u0631\u0627\u064b. \u0642\u0628\u0644 \u0627\u0644\u062f\u0641\u0639\u060c \u062a\u062d\u0642\u0642 \u0645\u0646 \u0646\u0648\u0639 \u0627\u0644\u063a\u0631\u0641\u0629\u060c \u0639\u062f\u062f \u0627\u0644\u0623\u0633\u0631\u0651\u0629\u060c \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0625\u0644\u063a\u0627\u0621\u060c \u0627\u0644\u0625\u0641\u0637\u0627\u0631\u060c \u0627\u0644\u0645\u0635\u0639\u062f \u0648\u0627\u0644\u062a\u062f\u0641\u0626\u0629 \u0623\u0648 \u0627\u0644\u062a\u0643\u064a\u064a\u0641 \u062d\u0633\u0628 \u0627\u0644\u0645\u0648\u0633\u0645.<\/p>\n\n<h2>\u0627\u0644\u0645\u0627\u0644 \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0644<\/h2>\n<p>\u0639\u0645\u0644\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0647\u064a \u0627\u0644\u062a\u0646\u063a\u064a. \u062a\u062a\u063a\u064a\u0631 \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0631\u0641\u060c \u0644\u0630\u0644\u0643 \u0627\u0633\u062a\u062e\u062f\u0645 \u0633\u0639\u0631\u0627\u064b \u0645\u0628\u0627\u0634\u0631\u0627\u064b \u0648\u0642\u062a \u0627\u0644\u0633\u0641\u0631 \u0648\u0644\u0627 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0631\u0642\u0645 \u0645\u0646\u0634\u0648\u0631 \u0641\u064a \u0645\u0642\u0627\u0644 \u0642\u062f\u064a\u0645. \u0627\u062d\u062a\u0641\u0638 \u0628\u0648\u0633\u064a\u0644\u0629 \u062f\u0641\u0639 \u0628\u062f\u064a\u0644\u0629 \u0648\u0645\u0628\u0644\u063a \u0646\u0642\u062f\u064a \u0645\u062d\u062f\u0648\u062f \u0644\u0644\u0645\u0648\u0627\u0642\u0641 \u0627\u0644\u062a\u064a \u0644\u0627 \u062a\u0642\u0628\u0644 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a.<\/p>\n<p>\u062c\u0647\u0632 \u0634\u0631\u064a\u062d\u0629 \u0627\u062a\u0635\u0627\u0644 \u0623\u0648 \u062a\u062c\u0648\u0627\u0644\u0627\u064b \u0645\u0646\u0627\u0633\u0628\u0627\u064b\u060c \u0648\u0646\u0632\u0651\u0644 \u0627\u0644\u062e\u0631\u0627\u0626\u0637 \u0648\u0627\u0644\u062a\u0631\u062c\u0645\u0629 \u0644\u0644\u0639\u0645\u0644 \u062f\u0648\u0646 \u0625\u0646\u062a\u0631\u0646\u062a. \u062d\u0641\u0638 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u064a\u0642\u0644\u0644 \u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u062a\u0648\u0627\u0635\u0644.<\/p>\n\n<h2>\u0627\u0644\u0637\u0642\u0633 \u0648\u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0645\u0644\u0627\u0628\u0633<\/h2>\n<p>\u0642\u062f \u064a\u062e\u062a\u0644\u0641 \u0627\u0644\u0637\u0642\u0633 \u0628\u064a\u0646 \u0645\u0631\u0643\u0632 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0648\u0627\u0644\u062c\u0628\u0627\u0644 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0646\u0641\u0633\u0647. \u0627\u0644\u0635\u064a\u0641 \u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0634\u062a\u0627\u0621 \u062a\u062c\u0647\u064a\u0632\u0627\u064b \u062d\u0642\u064a\u0642\u064a\u0627\u064b \u0644\u0644\u0628\u0631\u062f \u0648\u0627\u0644\u062b\u0644\u0648\u062c. \u0641\u064a \u0627\u0644\u0631\u0628\u064a\u0639 \u0648\u0627\u0644\u062e\u0631\u064a\u0641 \u0627\u062d\u0645\u0644 \u0637\u0628\u0642\u0627\u062a \u0645\u0644\u0627\u0628\u0633 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0625\u0636\u0627\u0641\u0629 \u0645\u0639 \u0633\u062a\u0631\u0629 \u0645\u0642\u0627\u0648\u0645\u0629 \u0644\u0644\u0645\u0637\u0631 \u0623\u0648 \u0627\u0644\u0631\u064a\u0627\u062d.<\/p>\n<p>\u0631\u0627\u062c\u0639 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-tourism-overview\/\">\u062f\u0644\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 2026<\/a> \u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0648\u0633\u0645 \u0648\u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629.<\/p>\n\n<h2>\u0627\u0644\u0637\u0639\u0627\u0645 \u0648\u0627\u0644\u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u063a\u0630\u0627\u0626\u064a\u0629<\/h2>\n<p>\u062a\u062a\u0648\u0641\u0631 \u062e\u064a\u0627\u0631\u0627\u062a \u062d\u0644\u0627\u0644\u060c \u062e\u0627\u0635\u0629 \u0641\u064a \u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u0643\u0628\u0631\u0649\u060c \u0644\u0643\u0646 \u0627\u0633\u0623\u0644 \u0627\u0644\u0645\u0637\u0639\u0645 \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0646 \u0645\u0635\u062f\u0631 \u0627\u0644\u0644\u062d\u0648\u0645 \u0648\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u062d\u0636\u064a\u0631. \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0644\u062f\u064a\u0643 \u062d\u0633\u0627\u0633\u064a\u0629\u060c \u0627\u0643\u062a\u0628 \u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u0645\u0645\u0646\u0648\u0639\u0629 \u0628\u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0623\u0648 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u064a\u0629 \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u062a\u0631\u062c\u0645\u0629\u060c \u0648\u0644\u0627 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0627\u0644\u0648\u0635\u0641 \u0627\u0644\u0634\u0641\u0647\u064a \u0641\u0642\u0637.<\/p>\n\n<h2>\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0648\u0627\u0644\u0633\u0644\u0627\u0645\u0629<\/h2>\n<p>\u0627\u062e\u062a\u0631 \u062a\u0623\u0645\u064a\u0646\u0627\u064b \u064a\u063a\u0637\u064a \u0645\u062f\u0629 \u0627\u0644\u0631\u062d\u0644\u0629 \u0648\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u064a \u0633\u062a\u0642\u0648\u0645 \u0628\u0647\u0627\u060c \u0648\u0627\u0642\u0631\u0623 \u0627\u0644\u0627\u0633\u062a\u062b\u0646\u0627\u0621\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0631\u064a\u0627\u0636\u0627\u062a \u0648\u0627\u0644\u062c\u0628\u0627\u0644. \u0634\u0627\u0631\u0643 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0633\u0643\u0646 \u0645\u0639 \u0623\u062d\u062f \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0639\u0627\u0626\u0644\u0629\u060c \u0648\u0627\u062d\u0641\u0638 \u0631\u0642\u0645 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u0648\u062d\u062f \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 <span dir=\"ltr\">112<\/span>.<\/p>\n\n<h2>\u0627\u062d\u062c\u0632 \u062e\u062f\u0645\u0627\u062a\u0643 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0645\u0639 \u0623\u0631\u0643\u0627\u062f\u064a\u0627<\/h2>\n<p>\u062a\u0633\u0627\u0639\u062f\u0643 \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0641\u064a \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u060c \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0631\u060c \u0627\u0644\u0633\u0643\u0646\u060c \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0648\u0627\u0644\u0645\u0631\u0634\u062f \u0648\u0627\u0644\u062c\u0648\u0644\u0627\u062a \u062f\u0627\u062e\u0644 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646. \u0644\u0627 \u0646\u0642\u062f\u0645 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629. \u0623\u0631\u0633\u0644 \u0639\u062f\u062f \u0627\u0644\u0645\u0633\u0627\u0641\u0631\u064a\u0646\u060c \u0623\u0639\u0645\u0627\u0631 \u0627\u0644\u0623\u0637\u0641\u0627\u0644\u060c \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0648\u0635\u0648\u0644 \u0648\u0639\u062f\u062f \u0627\u0644\u0644\u064a\u0627\u0644\u064a \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0628\u0631\u0646\u0627\u0645\u062c \u0648\u0627\u0642\u0639\u064a \u064a\u0646\u0627\u0633\u0628 \u0631\u062d\u0644\u062a\u0643.<\/p>\n<p>\u0634\u0627\u0647\u062f <a href=\"https:\/\/arcadia-tour.com\/offers-bookings\/\">\u0627\u0644\u0639\u0631\u0648\u0636 \u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a<\/a> \u0623\u0648 \u062a\u0648\u0627\u0635\u0644 \u0639\u0628\u0631 \u0648\u0627\u062a\u0633\u0627\u0628 \u0639\u0644\u0649 <a href=\"https:\/\/wa.me\/77064007561\"><span dir=\"ltr\">+7 705 118 1845<\/span><\/a>.<\/p>\n\n<h2>\u0623\u0633\u0626\u0644\u0629 \u0634\u0627\u0626\u0639\u0629<\/h2>\n<h3>\u0643\u0645 \u064a\u0648\u0645\u0627\u064b \u062a\u0643\u0641\u064a \u0644\u0623\u0648\u0644 \u0631\u062d\u0644\u0629\u061f<\/h3>\n<p>\u0633\u0628\u0639\u0629 \u0625\u0644\u0649 \u062a\u0633\u0639\u0629 \u0623\u064a\u0627\u0645 \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0645\u0631\u064a\u062d \u064a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0623\u0644\u0645\u0627\u062a\u064a \u0648\u0627\u0644\u0637\u0628\u064a\u0639\u0629\u060c \u0645\u0639 \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0625\u0636\u0627\u0641\u0629 \u0623\u0633\u062a\u0627\u0646\u0627 \u0648\u0641\u0642 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u062c\u0648\u064a\u0629.<\/p>\n<h3>\u0647\u0644 \u064a\u062d\u062a\u0627\u062c \u0645\u0648\u0627\u0637\u0646\u0648 \u0627\u0644\u062e\u0644\u064a\u062c \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629\u061f<\/h3>\n<p>\u0627\u0644\u062c\u0648\u0627\u0632\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0644\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0643\u0648\u064a\u062a \u0648\u0642\u0637\u0631 \u0648\u0627\u0644\u0628\u062d\u0631\u064a\u0646 \u0648\u0639\u064f\u0645\u0627\u0646 \u0645\u062f\u0631\u062c\u0629 \u0636\u0645\u0646 \u0627\u0644\u0625\u0639\u0641\u0627\u0621 \u062d\u062a\u0649 30 \u064a\u0648\u0645\u0627\u064b \u0641\u064a \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0631\u0633\u0645\u064a \u0627\u0644\u062d\u0627\u0644\u064a. \u062a\u062d\u0642\u0642 \u0645\u062c\u062f\u062f\u0627\u064b \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631 \u0644\u0623\u0646 \u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u062d\u062f\u064a\u062b.<\/p>\n<h3>\u0647\u0644 \u062a\u0633\u062a\u062e\u0631\u062c \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629\u061f<\/h3>\n<p>\u0644\u0627. \u062e\u062f\u0645\u0627\u062a \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0633\u064a\u0627\u062d\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u062c\u0647\u0629 \u0648\u062a\u0634\u0645\u0644 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0648\u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0648\u0627\u0644\u0633\u0643\u0646 \u0648\u0627\u0644\u062a\u0646\u0642\u0644 \u0648\u0627\u0644\u062c\u0648\u0644\u0627\u062a.<\/p>","rendered":"<p>\u062a\u0628\u062f\u0623 \u0631\u062d\u0644\u0629 <a href=\"https:\/\/arcadia-tour.com\/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3%d8%aa%d8%a7%d9%86\/\">\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/a> \u0627\u0644\u0646\u0627\u062c\u062d\u0629 \u0642\u0628\u0644 \u0645\u0648\u0639\u062f \u0627\u0644\u0637\u064a\u0631\u0627\u0646: \u062c\u0648\u0627\u0632 \u0635\u0627\u0644\u062d\u060c \u062d\u062c\u0648\u0632\u0627\u062a \u0648\u0627\u0636\u062d\u0629\u060c \u0628\u0631\u0646\u0627\u0645\u062c \u064a\u0646\u0627\u0633\u0628 \u0627\u0644\u0645\u0633\u0627\u0641\u0627\u062a \u0648\u0627\u0644\u0637\u0642\u0633\u060c \u0648\u062e\u0637\u0629 \u0644\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0648\u0627\u0644\u062a\u0646\u0642\u0644. \u0647\u0630\u0647 <strong>\u0642\u0627\u0626\u0645\u0629 \u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 2026<\/strong> \u062a\u0633\u0627\u0639\u062f\u0643 \u0639\u0644\u0649 \u062a\u062c\u0647\u064a\u0632 \u0631\u062d\u0644\u062a\u0643 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u062e\u0637\u0648\u0629 \u0628\u062e\u0637\u0648\u0629 \u062f\u0648\u0646 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0639\u0644\u0649 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0642\u062f\u064a\u0645\u0629 \u0623\u0648 \u0645\u064a\u0632\u0627\u0646\u064a\u0627\u062a \u0639\u0627\u0645\u0629 \u0644\u0627 \u062a\u0646\u0627\u0633\u0628 \u0627\u0644\u062c\u0645\u064a\u0639.<\/p>\n<h2>\u0642\u0627\u0626\u0645\u0629 \u0633\u0631\u064a\u0639\u0629 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/h2>\n<ul>\n<li>\u062a\u062d\u0642\u0642 \u0645\u0646 \u0635\u0644\u0627\u062d\u064a\u0629 \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631 \u0648\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0634\u0631\u0643\u0629 \u0627\u0644\u0637\u064a\u0631\u0627\u0646.<\/li>\n<li>\u0631\u0627\u062c\u0639 \u0646\u0638\u0627\u0645 \u0627\u0644\u062f\u062e\u0648\u0644 \u0627\u0644\u0631\u0633\u0645\u064a \u0648\u0641\u0642 \u062c\u0646\u0633\u064a\u062a\u0643 \u0648\u0645\u062f\u0629 \u0627\u0644\u0625\u0642\u0627\u0645\u0629.<\/li>\n<li>\u0627\u062d\u062a\u0641\u0638 \u0628\u062d\u062c\u0648\u0632\u0627\u062a \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0648\u0627\u0644\u0633\u0643\u0646 \u0648\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0625\u0642\u0627\u0645\u0629.<\/li>\n<li>\u0627\u062e\u062a\u0631 \u0645\u062f\u064a\u0646\u062a\u064a\u0646 \u0623\u0648 \u062b\u0644\u0627\u062b\u0627\u064b \u062d\u0633\u0628 \u0639\u062f\u062f \u0627\u0644\u0623\u064a\u0627\u0645\u060c \u0648\u0644\u0627 \u062a\u062c\u0645\u0639 \u0645\u0633\u0627\u0641\u0627\u062a \u0628\u0639\u064a\u062f\u0629 \u0641\u064a \u064a\u0648\u0645 \u0648\u0627\u062d\u062f.<\/li>\n<li>\u0631\u062a\u0628 \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0631 \u0648\u0627\u0644\u062a\u0646\u0642\u0644\u0627\u062a \u0648\u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629 \u0645\u0633\u0628\u0642\u0627\u064b.<\/li>\n<li>\u0627\u0634\u062a\u0631\u0650 \u062a\u0623\u0645\u064a\u0646 \u0633\u0641\u0631 \u0645\u0646\u0627\u0633\u0628\u0627\u064b \u0648\u0627\u062d\u062a\u0641\u0638 \u0628\u0646\u0633\u062e \u0631\u0642\u0645\u064a\u0629 \u0645\u0646 \u0645\u0633\u062a\u0646\u062f\u0627\u062a\u0643.<\/li>\n<li>\u0627\u0641\u062d\u0635 \u0627\u0644\u0637\u0642\u0633 \u0644\u0643\u0644 \u0645\u062f\u064a\u0646\u0629 \u0648\u0645\u0646\u0637\u0642\u0629 \u062c\u0628\u0644\u064a\u0629 \u0642\u0628\u0644 \u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0645\u0644\u0627\u0628\u0633.<\/li>\n<\/ul>\n<h2>\u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631 \u0648\u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u062f\u062e\u0648\u0644<\/h2>\n<p>\u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631 \u0635\u0627\u0644\u062d\u0627\u064b \u0644\u0644\u0631\u062d\u0644\u0629 \u0648\u0623\u0646 \u062a\u062a\u0637\u0627\u0628\u0642 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062d\u062c\u0632 \u0645\u0639\u0647. \u0645\u062f\u0629 \u0627\u0644\u0635\u0644\u0627\u062d\u064a\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0648\u0634\u0631\u0648\u0637 \u0627\u0644\u062f\u062e\u0648\u0644 \u0642\u062f \u062a\u062e\u062a\u0644\u0641 \u0628\u062d\u0633\u0628 \u0627\u0644\u062c\u0646\u0633\u064a\u0629 \u0648\u0634\u0631\u0643\u0629 \u0627\u0644\u0637\u064a\u0631\u0627\u0646\u060c \u0644\u0630\u0644\u0643 \u062a\u062d\u0642\u0642 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631 \u0645\u0646 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0648\u0645\u0646 \u0627\u0644\u0646\u0627\u0642\u0644 \u0627\u0644\u062c\u0648\u064a\u060c \u0648\u0644\u0627 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u062a\u062c\u0631\u0628\u0629 \u0645\u0633\u0627\u0641\u0631 \u0622\u062e\u0631.<\/p>\n<p>\u0628\u062d\u0633\u0628 <a href=\"https:\/\/www.gov.kz\/memleket\/entities\/mfa\/activities\/34747?lang=en&amp;parentId=3053\" target=\"_blank\" rel=\"noopener noreferrer\">\u062c\u062f\u0648\u0644 \u0648\u0632\u0627\u0631\u0629 \u062e\u0627\u0631\u062c\u064a\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/a>\u060c \u064a\u0633\u062a\u0637\u064a\u0639 \u062d\u0627\u0645\u0644\u0648 \u0627\u0644\u062c\u0648\u0627\u0632\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0645\u0646 \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0643\u0648\u064a\u062a \u0648\u0642\u0637\u0631 \u0648\u0627\u0644\u0628\u062d\u0631\u064a\u0646 \u0648\u0639\u064f\u0645\u0627\u0646 \u0627\u0644\u062f\u062e\u0648\u0644 \u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0644\u0644\u0625\u0642\u0627\u0645\u0629 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0627\u0644\u0642\u0635\u064a\u0631\u0629 \u062d\u062a\u0649 30 \u064a\u0648\u0645\u0627\u064b\u060c \u0645\u0639 \u0645\u0631\u0627\u0639\u0627\u0629 \u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0646\u0638\u0627\u0645\u064a\u0629 \u0627\u0644\u0645\u062d\u062f\u062b\u0629 \u0648\u0642\u062a \u0627\u0644\u0633\u0641\u0631.<\/p>\n<div class=\"arcadia-info-note\" style=\"border-right:4px solid #c9a227;padding:14px 16px;margin:20px 0;background:#faf8f1\"><strong>\u0645\u0647\u0645:<\/strong> \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0644\u0627 \u062a\u0633\u062a\u062e\u0631\u062c \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0644\u0627 \u062e\u0637\u0627\u0628\u0627\u062a \u0627\u0644\u062f\u0639\u0648\u0629. \u0646\u0642\u062f\u0645 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u062c\u0647\u0629 \u0641\u0642\u0637.<\/div>\n<h2>\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0648\u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062d\u0645\u0644\u0647\u0627<\/h2>\n<p>\u0627\u062d\u062a\u0641\u0638 \u0639\u0644\u0649 \u0647\u0627\u062a\u0641\u0643 \u0648\u0646\u0633\u062e\u0629 \u0633\u062d\u0627\u0628\u064a\u0629 \u0628\u0635\u0648\u0631\u0629 \u0627\u0644\u062c\u0648\u0627\u0632\u060c \u062a\u0630\u0643\u0631\u0629 \u0627\u0644\u0639\u0648\u062f\u0629 \u0623\u0648 \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629\u060c \u062d\u062c\u0632 \u0627\u0644\u0633\u0643\u0646\u060c \u0648\u062b\u064a\u0642\u0629 \u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0648\u0623\u0631\u0642\u0627\u0645 \u0627\u0644\u062a\u0648\u0627\u0635\u0644. \u0642\u062f \u062a\u0637\u0644\u0628 \u062c\u0647\u0629 \u0627\u0644\u0633\u0641\u0631 \u0623\u0648 \u0627\u0644\u062d\u062f\u0648\u062f \u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629 \u0648\u0641\u0642 \u062d\u0627\u0644\u062a\u0643\u060c \u0644\u0630\u0627 \u0631\u0627\u062c\u0639 \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0642\u0628\u0644 \u0645\u0648\u0639\u062f \u0627\u0644\u0631\u062d\u0644\u0629.<\/p>\n<p>\u0627\u0643\u062a\u0628 \u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u0631\u0642\u0645 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0628\u0627\u0644\u0644\u063a\u0629 \u0627\u0644\u062a\u064a \u064a\u0638\u0647\u0631 \u0628\u0647\u0627 \u0641\u064a \u0627\u0644\u062d\u062c\u0632\u060c \u0641\u0647\u0630\u0627 \u064a\u0633\u0627\u0639\u062f \u0639\u0646\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0633\u064a\u0627\u0631\u0629 \u0627\u0644\u0623\u062c\u0631\u0629.<\/p>\n<h2>\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u062f\u0646 \u0648\u0645\u062f\u0629 \u0627\u0644\u0631\u062d\u0644\u0629<\/h2>\n<p>\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0648\u0627\u0633\u0639\u0629\u060c \u0648\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u062f\u0629 \u0648\u0627\u062d\u062f\u0629 \u0645\u062b\u0627\u0644\u064a\u0629 \u0644\u0644\u062c\u0645\u064a\u0639. \u0631\u062d\u0644\u0629 \u0645\u0646 7 \u0625\u0644\u0649 9 \u0623\u064a\u0627\u0645 \u062a\u0633\u0645\u062d \u063a\u0627\u0644\u0628\u0627\u064b \u0628\u062c\u0639\u0644 \u0623\u0644\u0645\u0627\u062a\u064a \u0642\u0627\u0639\u062f\u0629 \u0631\u0626\u064a\u0633\u064a\u0629 \u0645\u0639 \u0631\u062d\u0644\u0627\u062a \u0637\u0628\u064a\u0639\u064a\u0629\u060c \u0648\u064a\u0645\u0643\u0646 \u0625\u0636\u0627\u0641\u0629 \u0623\u0633\u062a\u0627\u0646\u0627 \u0625\u0630\u0627 \u0643\u0627\u0646 \u062c\u062f\u0648\u0644 \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0645\u0646\u0627\u0633\u0628\u0627\u064b. \u0623\u0645\u0627 \u0623\u0643\u062a\u0627\u0648 \u0648\u0645\u0627\u0646\u063a\u064a\u0633\u062a\u0627\u0648 \u0623\u0648 \u062a\u0631\u0643\u0633\u062a\u0627\u0646 \u0648\u0627\u0644\u062c\u0646\u0648\u0628 \u0641\u062a\u062d\u062a\u0627\u062c \u0645\u0633\u0627\u0631\u0627\u064b \u0645\u0633\u062a\u0642\u0644\u0627\u064b \u0623\u0648 \u0623\u064a\u0627\u0645\u0627\u064b \u0625\u0636\u0627\u0641\u064a\u0629.<\/p>\n<p>\u0642\u0627\u0631\u0646 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\/\u0627\u0644\u0645\u062f\u0646-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646-\u062a\u0639\u0631\u0641-\u0639\u0644\u0649-\u0623\u0647\u0645-9-\u0645\u062f\u0646-\u0633\u064a\u0627\u062d\u064a\u0629\/\">\u062f\u0644\u064a\u0644 \u0645\u062f\u0646 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629<\/a>\u060c \u0623\u0648 \u0627\u0628\u062f\u0623 \u0645\u0646 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-7-days-2\/\">\u0628\u0631\u0646\u0627\u0645\u062c \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0645\u062f\u0629 7 \u0623\u064a\u0627\u0645<\/a>.<\/p>\n<h2>\u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0648\u0627\u0644\u062a\u0646\u0642\u0644<\/h2>\n<p>\u0631\u062a\u0628 \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0648\u0635\u0648\u0644 \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0631 \u0642\u0628\u0644 \u0627\u0644\u0625\u0642\u0644\u0627\u0639\u060c \u062e\u0627\u0635\u0629 \u0639\u0646\u062f \u0627\u0644\u0648\u0635\u0648\u0644 \u0644\u064a\u0644\u0627\u064b \u0623\u0648 \u0645\u0639 \u0627\u0644\u0623\u0637\u0641\u0627\u0644. \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062f\u0646 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0627\u0644\u0646\u0642\u0644 \u0627\u0644\u0645\u0639\u0631\u0648\u0641\u0629 \u0623\u0648 \u0633\u064a\u0627\u0631\u0629 \u0627\u0644\u0641\u0646\u062f\u0642\u060c \u0623\u0645\u0627 \u0627\u0644\u0628\u062d\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0623\u0648\u062f\u064a\u0629 \u0648\u0627\u0644\u0637\u0631\u0642 \u0627\u0644\u062c\u0628\u0644\u064a\u0629 \u0641\u062a\u062d\u062a\u0627\u062c \u0633\u064a\u0627\u0631\u0629 \u0645\u0646\u0627\u0633\u0628\u0629 \u0648\u0633\u0627\u0626\u0642\u0627\u064b \u064a\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u0627\u0631.<\/p>\n<p>\u062a\u0623\u0643\u062f \u0645\u0646 \u0648\u0642\u062a \u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642 \u0648\u0627\u0644\u0639\u0648\u062f\u0629 \u0648\u0645\u0627 \u064a\u0634\u0645\u0644\u0647 \u0627\u0644\u0633\u0639\u0631\u060c \u0648\u0644\u0627 \u062a\u0636\u0639 \u0631\u062d\u0644\u062a\u064a\u0646 \u0637\u0628\u064a\u0639\u064a\u062a\u064a\u0646 \u0628\u0639\u064a\u062f\u062a\u064a\u0646 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0646\u0641\u0633\u0647. \u0628\u0639\u0636 \u0627\u0644\u0648\u062c\u0647\u0627\u062a \u062a\u062a\u0623\u062b\u0631 \u0628\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0631\u064a\u0642 \u0648\u0627\u0644\u0637\u0642\u0633 \u0648\u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0645\u0648\u0633\u0645\u064a.<\/p>\n<h2>\u0627\u0644\u0633\u0643\u0646 \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u0639\u0627\u0626\u0644\u0629<\/h2>\n<p>\u0627\u062e\u062a\u0631 \u0627\u0644\u0633\u0643\u0646 \u0628\u0646\u0627\u0621\u064b \u0639\u0644\u0649 \u0628\u0631\u0646\u0627\u0645\u062c\u0643 \u0644\u0627 \u0639\u0644\u0649 \u0627\u0644\u0633\u0639\u0631 \u0648\u062d\u062f\u0647. \u0642\u0631\u0628 \u0627\u0644\u0641\u0646\u062f\u0642 \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0639\u0645 \u0648\u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0648\u0646\u0642\u0627\u0637 \u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642 \u0642\u062f \u064a\u0648\u0641\u0631 \u0648\u0642\u062a\u0627\u064b \u064a\u0648\u0645\u064a\u0627\u064b \u0643\u0628\u064a\u0631\u0627\u064b. \u0642\u0628\u0644 \u0627\u0644\u062f\u0641\u0639\u060c \u062a\u062d\u0642\u0642 \u0645\u0646 \u0646\u0648\u0639 \u0627\u0644\u063a\u0631\u0641\u0629\u060c \u0639\u062f\u062f \u0627\u0644\u0623\u0633\u0631\u0651\u0629\u060c \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0625\u0644\u063a\u0627\u0621\u060c \u0627\u0644\u0625\u0641\u0637\u0627\u0631\u060c \u0627\u0644\u0645\u0635\u0639\u062f \u0648\u0627\u0644\u062a\u062f\u0641\u0626\u0629 \u0623\u0648 \u0627\u0644\u062a\u0643\u064a\u064a\u0641 \u062d\u0633\u0628 \u0627\u0644\u0645\u0648\u0633\u0645.<\/p>\n<h2>\u0627\u0644\u0645\u0627\u0644 \u0648\u0627\u0644\u0627\u062a\u0635\u0627\u0644<\/h2>\n<p>\u0639\u0645\u0644\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0647\u064a \u0627\u0644\u062a\u0646\u063a\u064a. \u062a\u062a\u063a\u064a\u0631 \u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0635\u0631\u0641\u060c \u0644\u0630\u0644\u0643 \u0627\u0633\u062a\u062e\u062f\u0645 \u0633\u0639\u0631\u0627\u064b \u0645\u0628\u0627\u0634\u0631\u0627\u064b \u0648\u0642\u062a \u0627\u0644\u0633\u0641\u0631 \u0648\u0644\u0627 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0631\u0642\u0645 \u0645\u0646\u0634\u0648\u0631 \u0641\u064a \u0645\u0642\u0627\u0644 \u0642\u062f\u064a\u0645. \u0627\u062d\u062a\u0641\u0638 \u0628\u0648\u0633\u064a\u0644\u0629 \u062f\u0641\u0639 \u0628\u062f\u064a\u0644\u0629 \u0648\u0645\u0628\u0644\u063a \u0646\u0642\u062f\u064a \u0645\u062d\u062f\u0648\u062f \u0644\u0644\u0645\u0648\u0627\u0642\u0641 \u0627\u0644\u062a\u064a \u0644\u0627 \u062a\u0642\u0628\u0644 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a.<\/p>\n<p>\u062c\u0647\u0632 \u0634\u0631\u064a\u062d\u0629 \u0627\u062a\u0635\u0627\u0644 \u0623\u0648 \u062a\u062c\u0648\u0627\u0644\u0627\u064b \u0645\u0646\u0627\u0633\u0628\u0627\u064b\u060c \u0648\u0646\u0632\u0651\u0644 \u0627\u0644\u062e\u0631\u0627\u0626\u0637 \u0648\u0627\u0644\u062a\u0631\u062c\u0645\u0629 \u0644\u0644\u0639\u0645\u0644 \u062f\u0648\u0646 \u0625\u0646\u062a\u0631\u0646\u062a. \u062d\u0641\u0638 \u0645\u0648\u0627\u0642\u0639 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u062e\u0631\u064a\u0637\u0629 \u064a\u0642\u0644\u0644 \u0623\u062e\u0637\u0627\u0621 \u0627\u0644\u062a\u0648\u0627\u0635\u0644.<\/p>\n<h2>\u0627\u0644\u0637\u0642\u0633 \u0648\u062a\u062c\u0647\u064a\u0632 \u0627\u0644\u0645\u0644\u0627\u0628\u0633<\/h2>\n<p>\u0642\u062f \u064a\u062e\u062a\u0644\u0641 \u0627\u0644\u0637\u0642\u0633 \u0628\u064a\u0646 \u0645\u0631\u0643\u0632 \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0648\u0627\u0644\u062c\u0628\u0627\u0644 \u0641\u064a \u0627\u0644\u064a\u0648\u0645 \u0646\u0641\u0633\u0647. \u0627\u0644\u0635\u064a\u0641 \u0645\u0646\u0627\u0633\u0628 \u0644\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u0637\u0628\u064a\u0639\u064a\u0629\u060c \u0628\u064a\u0646\u0645\u0627 \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0634\u062a\u0627\u0621 \u062a\u062c\u0647\u064a\u0632\u0627\u064b \u062d\u0642\u064a\u0642\u064a\u0627\u064b \u0644\u0644\u0628\u0631\u062f \u0648\u0627\u0644\u062b\u0644\u0648\u062c. \u0641\u064a \u0627\u0644\u0631\u0628\u064a\u0639 \u0648\u0627\u0644\u062e\u0631\u064a\u0641 \u0627\u062d\u0645\u0644 \u0637\u0628\u0642\u0627\u062a \u0645\u0644\u0627\u0628\u0633 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0625\u0636\u0627\u0641\u0629 \u0645\u0639 \u0633\u062a\u0631\u0629 \u0645\u0642\u0627\u0648\u0645\u0629 \u0644\u0644\u0645\u0637\u0631 \u0623\u0648 \u0627\u0644\u0631\u064a\u0627\u062d.<\/p>\n<p>\u0631\u0627\u062c\u0639 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-tourism-overview\/\">\u062f\u0644\u064a\u0644 \u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 2026<\/a> \u0644\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0645\u0648\u0633\u0645 \u0648\u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0627\u0644\u0645\u0646\u0627\u0633\u0628\u0629.<\/p>\n<h2>\u0627\u0644\u0637\u0639\u0627\u0645 \u0648\u0627\u0644\u062d\u0633\u0627\u0633\u064a\u0629 \u0627\u0644\u063a\u0630\u0627\u0626\u064a\u0629<\/h2>\n<p>\u062a\u062a\u0648\u0641\u0631 \u062e\u064a\u0627\u0631\u0627\u062a \u062d\u0644\u0627\u0644\u060c \u062e\u0627\u0635\u0629 \u0641\u064a \u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u0643\u0628\u0631\u0649\u060c \u0644\u0643\u0646 \u0627\u0633\u0623\u0644 \u0627\u0644\u0645\u0637\u0639\u0645 \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0646 \u0645\u0635\u062f\u0631 \u0627\u0644\u0644\u062d\u0648\u0645 \u0648\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u062d\u0636\u064a\u0631. \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0644\u062f\u064a\u0643 \u062d\u0633\u0627\u0633\u064a\u0629\u060c \u0627\u0643\u062a\u0628 \u0623\u0633\u0645\u0627\u0621 \u0627\u0644\u0645\u0648\u0627\u062f \u0627\u0644\u0645\u0645\u0646\u0648\u0639\u0629 \u0628\u0627\u0644\u0631\u0648\u0633\u064a\u0629 \u0623\u0648 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u064a\u0629 \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u062a\u0631\u062c\u0645\u0629\u060c \u0648\u0644\u0627 \u062a\u0639\u062a\u0645\u062f \u0639\u0644\u0649 \u0627\u0644\u0648\u0635\u0641 \u0627\u0644\u0634\u0641\u0647\u064a \u0641\u0642\u0637.<\/p>\n<h2>\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0648\u0627\u0644\u0633\u0644\u0627\u0645\u0629<\/h2>\n<p>\u0627\u062e\u062a\u0631 \u062a\u0623\u0645\u064a\u0646\u0627\u064b \u064a\u063a\u0637\u064a \u0645\u062f\u0629 \u0627\u0644\u0631\u062d\u0644\u0629 \u0648\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u062a\u064a \u0633\u062a\u0642\u0648\u0645 \u0628\u0647\u0627\u060c \u0648\u0627\u0642\u0631\u0623 \u0627\u0644\u0627\u0633\u062a\u062b\u0646\u0627\u0621\u0627\u062a \u0627\u0644\u0645\u062a\u0639\u0644\u0642\u0629 \u0628\u0627\u0644\u0631\u064a\u0627\u0636\u0627\u062a \u0648\u0627\u0644\u062c\u0628\u0627\u0644. \u0634\u0627\u0631\u0643 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0633\u0643\u0646 \u0645\u0639 \u0623\u062d\u062f \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0639\u0627\u0626\u0644\u0629\u060c \u0648\u0627\u062d\u0641\u0638 \u0631\u0642\u0645 \u0627\u0644\u0637\u0648\u0627\u0631\u0626 \u0627\u0644\u0645\u0648\u062d\u062f \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 <span dir=\"ltr\">112<\/span>.<\/p>\n<h2>\u0627\u062d\u062c\u0632 \u062e\u062f\u0645\u0627\u062a\u0643 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0645\u0639 \u0623\u0631\u0643\u0627\u062f\u064a\u0627<\/h2>\n<p>\u062a\u0633\u0627\u0639\u062f\u0643 \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0641\u064a \u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u060c \u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0645\u0646 \u0627\u0644\u0645\u0637\u0627\u0631\u060c \u0627\u0644\u0633\u0643\u0646\u060c \u0627\u0644\u0633\u064a\u0627\u0631\u0629 \u0648\u0627\u0644\u0645\u0631\u0634\u062f \u0648\u0627\u0644\u062c\u0648\u0644\u0627\u062a \u062f\u0627\u062e\u0644 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646. \u0644\u0627 \u0646\u0642\u062f\u0645 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629. \u0623\u0631\u0633\u0644 \u0639\u062f\u062f \u0627\u0644\u0645\u0633\u0627\u0641\u0631\u064a\u0646\u060c \u0623\u0639\u0645\u0627\u0631 \u0627\u0644\u0623\u0637\u0641\u0627\u0644\u060c \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0648\u0635\u0648\u0644 \u0648\u0639\u062f\u062f \u0627\u0644\u0644\u064a\u0627\u0644\u064a \u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0628\u0631\u0646\u0627\u0645\u062c \u0648\u0627\u0642\u0639\u064a \u064a\u0646\u0627\u0633\u0628 \u0631\u062d\u0644\u062a\u0643.<\/p>\n<p>\u0634\u0627\u0647\u062f <a href=\"https:\/\/arcadia-tour.com\/offers-bookings\/\">\u0627\u0644\u0639\u0631\u0648\u0636 \u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a<\/a> \u0623\u0648 \u062a\u0648\u0627\u0635\u0644 \u0639\u0628\u0631 \u0648\u0627\u062a\u0633\u0627\u0628 \u0639\u0644\u0649 <a href=\"https:\/\/wa.me\/77064007561\"><span dir=\"ltr\">+7 705 118 1845<\/span><\/a>.<\/p>\n<h2>\u0623\u0633\u0626\u0644\u0629 \u0634\u0627\u0626\u0639\u0629<\/h2>\n<h3>\u0643\u0645 \u064a\u0648\u0645\u0627\u064b \u062a\u0643\u0641\u064a \u0644\u0623\u0648\u0644 \u0631\u062d\u0644\u0629\u061f<\/h3>\n<p>\u0633\u0628\u0639\u0629 \u0625\u0644\u0649 \u062a\u0633\u0639\u0629 \u0623\u064a\u0627\u0645 \u0645\u0646\u0627\u0633\u0628\u0629 \u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0645\u0631\u064a\u062d \u064a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0623\u0644\u0645\u0627\u062a\u064a \u0648\u0627\u0644\u0637\u0628\u064a\u0639\u0629\u060c \u0645\u0639 \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u0625\u0636\u0627\u0641\u0629 \u0623\u0633\u062a\u0627\u0646\u0627 \u0648\u0641\u0642 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0627\u0644\u062c\u0648\u064a\u0629.<\/p>\n<h3>\u0647\u0644 \u064a\u062d\u062a\u0627\u062c \u0645\u0648\u0627\u0637\u0646\u0648 \u0627\u0644\u062e\u0644\u064a\u062c \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629\u061f<\/h3>\n<p>\u0627\u0644\u062c\u0648\u0627\u0632\u0627\u062a \u0627\u0644\u0639\u0627\u062f\u064a\u0629 \u0644\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0643\u0648\u064a\u062a \u0648\u0642\u0637\u0631 \u0648\u0627\u0644\u0628\u062d\u0631\u064a\u0646 \u0648\u0639\u064f\u0645\u0627\u0646 \u0645\u062f\u0631\u062c\u0629 \u0636\u0645\u0646 \u0627\u0644\u0625\u0639\u0641\u0627\u0621 \u062d\u062a\u0649 30 \u064a\u0648\u0645\u0627\u064b \u0641\u064a \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0631\u0633\u0645\u064a \u0627\u0644\u062d\u0627\u0644\u064a. \u062a\u062d\u0642\u0642 \u0645\u062c\u062f\u062f\u0627\u064b \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631 \u0644\u0623\u0646 \u0627\u0644\u0623\u0646\u0638\u0645\u0629 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u062a\u062d\u062f\u064a\u062b.<\/p>\n<h3>\u0647\u0644 \u062a\u0633\u062a\u062e\u0631\u062c \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629\u061f<\/h3>\n<p>\u0644\u0627. \u062e\u062f\u0645\u0627\u062a \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0633\u064a\u0627\u062d\u064a\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u062c\u0647\u0629 \u0648\u062a\u0634\u0645\u0644 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0648\u0627\u0644\u0627\u0633\u062a\u0642\u0628\u0627\u0644 \u0648\u0627\u0644\u0633\u0643\u0646 \u0648\u0627\u0644\u062a\u0646\u0642\u0644 \u0648\u0627\u0644\u062c\u0648\u0644\u0627\u062a.<\/p>\n","protected":false,"block_version":0}}