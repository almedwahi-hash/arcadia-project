-radius: 50px; font-size: 1rem; font-weight: 700; text-decoration: none; display: inline-flex; align-items: center; gap: 10px; transition: all 0.3s; }\r\n  .whatsapp-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(37,211,102,0.4); }\r\n  @media (max-width: 768px) { .cards-grid, .services-grid, .features { grid-template-columns: 1fr; } .cta-box { padding: 40px 24px; } }\r\n<\/style>\r\n\r\n<section class=\"hero\">\r\n  <div class=\"hero-content\">\r\n    <div class=\"hero-badge\">\ud83c\uddfa\ud83c\uddff \u062f\u0631\u0628 \u0627\u0644\u062d\u0631\u064a\u0631 \u0627\u0644\u0623\u0633\u0637\u0648\u0631\u064a<\/div>\r\n    <h1>\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0623\u0648\u0632\u0628\u0643\u0633\u062a\u0627\u0646<\/h1>\r\n    <p>\u0623\u0648\u0632\u0628\u0643\u0633\u062a\u0627\u0646 \u062d\u064a\u062b \u064a\u0644\u062a\u0642\u064a \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0628\u0627\u0644\u062c\u0645\u0627\u0644 \u2014 \u0633\u0645\u0631\u0642\u0646\u062f \u0648\u0628\u062e\u0627\u0631\u0649 \u0648\u0637\u0634\u0642\u0646\u062f \u062a\u0646\u062a\u0638\u0631\u0643 \u0628\u062d\u0636\u0627\u0631\u062a\u0647\u0627 \u0627\u0644\u0625\u0633\u0644\u0627\u0645\u064a\u0629 \u0627\u0644\u0639\u0631\u064a\u0642\u0629 \u0648\u0623\u062c\u0648\u0627\u0626\u0647\u0627 \u0627\u0644\u0633\u0627\u062d\u0631\u0629<\/p>\r\n    <div class=\"hero-btns\">\r\n      <a href=\"https:\/\/wa.me\/77064007561\" class=\"btn-gold\">\ud83d\udcac \u0627\u062d\u062c\u0632 \u0631\u062d\u0644\u062a\u0643 \u0627\u0644\u0622\u0646<\/a>\r\n      <a href=\"\/\u0627\u0644\u0639\u0631\u0648\u0636-\u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a\" class=\"btn-outline\">\ud83c\udf0d \u0627\u0633\u062a\u0639\u0631\u0636 \u0627\u0644\u0639\u0631\u0648\u0636<\/a>\r\n    <\/div>\r\n  <\/div>\r\n<\/section>\r\n\r\n<section class=\"intro\">\r\n  <span class=\"section-tag\">\u0639\u0646 \u0627\u0644\u0648\u062c\u0647\u0629<\/span>\r\n  <h2>\u0644\u0645\u0627\u063