\u062c\u0645\u0644 \u0627\u0644\u0631\u062d\u0644\u0627\u062a \u0648\u0644\u0627 \u063a\u0644\u0637\u0629. \u0643\u0644 \u0634\u064a\u0621 \u0643\u0627\u0646 \u0631\u0627\u0626\u0639\u0627\u064b. \u0634\u0643\u0631\u0627\u064b \u0634\u0631\u0643\u0629 \u0623\u0631\u0643\u0627\u062f\u064a\u0627. \u0634\u0631\u0643\u0629 \u0631\u0627\u0626\u0639\u0629 \u0628\u0643\u0644 \u0645\u0639\u0646\u0649 \u0627\u0644\u0643\u0644\u0645\u0629 \u0627\u0644\u0633\u0627\u0626\u0642\u064a\u0646 \u0627\u0644\u0645\u0631\u0634\u062f\u064a\u0646 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u0641\u0646\u0627\u062f\u0642 \u0643\u0644 \u0634\u064a\u0621 \u0645\u0645\u064a\u0632. \u0634\u0643\u0631\u0627\u064b<\/p>\r\n      <div class=\"test-author\">\r\n        <div class=\"test-avatar\">\u062e<\/div>\r\n        <div>\r\n          <div class=\"test-name\">\u062e\u0627\u0644\u062f \u0627\u0644\u0634\u0645\u0631\u064a<\/div>\r\n          <div class=\"test-trip\">\u0631\u062d\u0644\u0629 \u0632\u0648\u062c\u064a\u0646<\/div>\r\n        <\/div>\r\n      <\/div>\r\n    <\/div>\r\n    <div class=\"test-card\">\r\n      <div class=\"stars\">\u2605\u2605\u2605\u2605\u2605<\/div>\r\n      <p class=\"test-text\">\u0643\u0627\u0646\u062a \u0631\u062d\u0644\u0629 \u0645\u0645\u064a\u0632\u0629 \u062a\u062a\u0633\u0645 \u0628\u0627\u0644\u062a\u0646\u0638\u064a\u0645 \u0648\u0627\u0644\u062a\u0646\u0648\u0639 \u0648\u0627\u0644\u062f\u0642\u0629 \u0641\u064a \u0627\u0644\u0645\u0648\u0627\u0639\u064a\u062f. \u0643\u0627\u0646 \u0627\u0644\u0623\u062e \u0623\u0628\u0648 \u0623\u0645\u064a\u0631 \u064a\u062a\u0627\u0628\u0639 \u0633\u064a\u0631 \u0627\u0644\u0631\u062d\u0644\u0629 \u0628\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0648\u062f\u0627\u0626\u0645\u0627\u064b \u0639\u0644\u0649 \u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0648\u0643\u0627\u0646 \u0645\u062a\u0639\u0627\u0648\u0646\u0627\u064b \u062c\u062f\u0627\u064b. \u0627\u0644\u0634\u0643\u0631 \u0627\u0644\u062e\u0627\u0635 \u0644\u0647<\/p>\r\n      <div class=\"test-author\">\r\n        <div class=\"test-avatar\">\u0633<\/div>\r\n        <div>\r\n          <div class=\"test-name\">\u0633\u0627\u0631\u0629 \u0639\u0627\u062f\u0644<\/div>\r\n          <div class=\"test-trip\">\u0631\u062d\u0644\u0629 \u0631\u0648\u0633\u064a\u0627<\/div>\r\n        <\/div>\r\n      <\/div>\r\n    <\/div>\r\n  <\/div>\r\n<\/section>\r\n\r\n<!-- FAQ -->\r\n<section class=\"faq\">\r\n  <div class=\"faq-inner\">\r\n    <h2>\u0623\u0633\u0626\u0644\u0629 \u0634\u0627\u0626\u0639\u0629 \u0639\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0631\u0648\u0633\u064a\u0627<\/h2>\r\n\r\n    <div class=\"faq-item\">\r\n      <div class=\"faq-q\">\u0645\u0627 \u0647\u0648 \u0623\u0641\u0636\u0644 \u0648\u0642\u062a \u0644\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0631\u0648\u0633\u064a\u0627\u061f<\/div>\r\n      <div class=\"faq-a\">\u0623\u0641\u0636\u0644 \u0648\u0642\u062a \u0644\u0632\u064a\u0627\u0631\u0629 \u0631\u0648\u0633\u064a\u0627 \u0647\u0648 \u0627\u0644\u0631\u0628\u064a\u0639 \u0648\u0627\u0644\u0635\u064a\u0641 \u0648\u0627\u0644\u062e\u0631\u064a\u0641. \u062a\u0645\u062a \u0627\u0644\u0625\u0634\u0627\u0631\u0629 \u0625\u0644\u0649 \u0627\u0644\u0645\u0648\u0633\u0645\u064a\u0629 \u0627\u0644\u0645\u0648\u0635\u0649 \u0628\u0647\u0627 \u0644\u0643\u0644 \u0648\u062c\u0647\u0629 \u0633\u064a\u0627\u062d\u064a\u0629 \u0641\u064a \u0648\u0635\u0641 \u0627\u0644\u062c\u0648\u0644\u0629.<\/div>\r\n    <\/div>\r\n\r\n    <div class=\"faq-item\">\r\n      <div class=\"faq-q\">\u0647\u0644 \u064a\u062d\u062a\u0627\u062c \u0645\u0648\u0627\u0637\u0646\u0648 \u062f\u0648\u0644 \u0627\u0644\u062e\u0644\u064a\u062c \u0644\u0641\u064a\u0632\u0627 \u0644\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0631\u0648\u0633\u064a\u0627\u061f<\/div>\r\n      <div class=\"faq-a\">\u0644\u0627 \u064a\u062d\u062a\u0627\u062c \u0645\u0648\u0627\u0637\u0646\u0648 \u062f\u0648\u0644 \u0645\u062c\u0644\u0633 \u0627\u0644\u062a\u0639\u0627\u0648\u0646 \u0627\u0644\u062e\u0644\u064a\u062c\u064a \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629 \u0633\u064a\u0627\u062d\u064a\u0629 \u0644\u0632\u064a\u0627\u0631\u0629 \u0631\u0648\u0633\u064a\u0627\u060c \u0648\u064a\u0634\u0645\u0644 \u0630\u0644\u0643 \u0645\u0648\u0627\u0637\u0646\u064a \u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0648\u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0648\u0642\u0637\u0631 \u0648\u0627\u0644\u0643\u0648\u064a\u062a \u0648\u0627\u0644\u0628\u062d\u0631\u064a\u0646 \u0648\u0639\u064f\u0645\u0627\u0646.<\/div>\r\n    <\/div>\r\n\r\n    <div class=\"faq-item\">\r\n      <div class=\"faq-q\">\u0647\u0644 \u0627\u0644\u062d\u062c\u0627\u0628 \u0645\u0633\u0645\u0648\u062d \u0641\u064a \u0631\u0648\u0633\u064a\u0627\u061f<\/div>\r\n      <div class=\"faq-a\">\u0646\u0639\u0645 \u0627\u0644\u062d\u062c\u0627\u0628 \u0645\u0633\u0645\u0648\u062d \u0641\u064a \u0631\u0648\u0633\u064a\u0627. \u064a\u0648\u062c\u062f \u0627\u0644\u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0639\u0631\u0642\u064a\u0627\u062a \u0641\u064a \u0631\u0648\u0633\u064a\u0627 \u0648\u0641\u064a\u0647\u0627 \u062a\u0639\u062f\u062f \u0627\u0644\u062f\u064a\u0627\u0646\u0627\u062a \u0641\u0644\u0627 \u062f\u0627\u0639\u064a \u0644\u0644\u0642\u0644\u0642.<\/div>\r\n    <\/div>\r\n\r\n    <div class=\"faq-item\">\r\n      <div class=\"faq-q\">\u0645\u0627 \u0647\u064a \u0627\u0644\u0639\u0645\u0644\u0629 \u0627\u0644\u0645\u062a\u062f\u0627\u0648\u0644\u0629 \u0641\u064a \u0631\u0648\u0633\u064a\u0627\u061f<\/div>\r\n      <div class=\"faq-a\">\u0627\u0644\u0639\u0645\u0644\u0629 \u0627\u0644\u0645\u062d\u0644\u064a\u0629 \u0647\u064a \u0627\u0644\u0631\u0648\u0628\u0644. \u064a\u0646\u0635\u062d \u0628\u0623\u062e\u0630 \u062f\u0648\u0644\u0627\u0631\u0627\u062a \u0623\u0648 \u064a\u0648\u0631\u0648 \u0648\u0635\u0631\u0641\u0647\u0627 \u0647\u0646\u0627\u0643\u060c \u0648\u0627\u0644\u0623\u0641\u0636\u0644 \u0627\u0644\u0635\u0631\u0641 \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0637\u0627\u0631 \u0641\u064a \u0627\u0644\u0645\u062f\u064a\u0646\u0629.<\/div>\r\n    <\/div>\r\n\r\n    <div class=\"faq-item\">\r\n      <div class=\"faq-q\">\u0645\u0627 \u0647\u064a \u0623\u0641\u0636\u0644 \u0627\u0644\u0623\u0645\u0627\u0643\u0646 \u0644\u0644\u0632\u064a\u0627\u0631\u0629 \u0641\u064a \u0645\u0648\u0633\u0643\u0648\u061f<\/div>\r\n      <div class=\"faq-a\">\u0623\u0647\u0645 10 \u0623\u0645\u0627\u0643\u0646 \u0641\u064a \u0645\u0648\u0633\u0643\u0648: \u0627\u0644\u0633\u0627\u062d\u0629 \u0627\u0644\u062d\u0645\u0631\u0627\u0621\u060c \u0627\u0644\u0643\u0631\u0645\u0644\u064a\u0646\u060c \u0641\u062f\u064a\u0646\u062e\u0627\u060c \u0645\u0639\u0631\u0636 \u062a\u0631\u064a\u062a\u064a\u0627\u0643\u0648\u0641\u060c \u062d\u062f\u064a\u0642\u0629 \u062d\u064a\u0648\u0627\u0646 \u0645\u0648\u0633\u0643\u0648\u060c \u0645\u062f\u064a\u0646\u0629 \u0645\u0648\u0633\u0643\u0648\u060c \u0627\u0644\u062a\u0644\u0641\u0631\u064a\u0643\u060c \u0628\u0631\u062c \u0623\u0648\u0633\u062a\u0627\u0646\u0643\u064a\u0646\u0648\u060c \u0645\u0633\u0631\u062d \u0627\u0644\u0628\u0648\u0644\u0634\u0648\u064a\u060c \u062d\u062f\u064a\u0642\u0629 \u0632\u0627\u0631\u064a\u0627\u062f\u064a.<\/div>\r\n    <\/div>\r\n\r\n    <div class=\"faq-item\">\r\n      <div class=\"faq-q\">\u0647\u0644 \u062a\u0639\u0645\u0644 \u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0641\u064a\u0632\u0627 \u0648\u0627\u0644\u0645\u0627\u0633\u062a\u0631 \u0643\u0627\u0631\u062f \u0641\u064a \u0631\u0648\u0633\u064a\u0627\u061f<\/div>\r\n      <div class=\"faq-a\">\u0644\u0627 \u062a\u0639\u0645\u0644 \u0627\u0644\u0628\u0637\u0627\u0642\u0627\u062a \u0627\u0644\u0628\u0646\u0643\u064a\u0629 \u0645\u062b\u0644 \u0627\u0644\u0641\u064a\u0632\u0627 \u0623\u0648 \u0627\u0644\u0645\u0627\u0633\u062a\u0631 \u0643\u0627\u0631\u062f \u0641\u064a \u0631\u0648\u0633\u064a\u0627 \u062d\u0627\u0