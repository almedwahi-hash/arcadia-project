[{"id":"5d3248de","elType":"container","settings":{},"elements":[{"id":"7cf83bc0","elType":"widget","settings":{"editor":"<style>.arcadia-kz-hero,.page-header-wrap{min-height:280px!important;background-size:cover!important;background-position:center!important;background-repeat:no-repeat!important;}@media(max-width:767px){.noBackground,.page-header-wrap,.arcadia-kz-hero{background-image:linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.45)),url('https://arcadia-tour.com/wp-content/uploads/2026/07/almaty-kazakhstan-arcadia-hero-opt-2.jpg')!important;min-height:240px!important;}}</style><style>.arcadia-kz-hero,.page-header-wrap{min-height:280px!important;background-size:cover!important;background-position:center!important;background-repeat:no-repeat!important;}@media(max-width:767px){.noBackground,.page-header-wrap,.arcadia-kz-hero{background-image:linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.45)),url('https://arcadia-tour.com/wp-content/uploads/2026/07/almaty-kazakhstan-arcadia-hero-opt-2.jpg')!important;min-height:240px!important;}}</style><style>.arcadia-kz-hero,.page-header-wrap{min-height:280px!important;background-size:cover!important;background-position:center!important;background-repeat:no-repeat!important;}@media(max-width:767px){.noBackground,.page-header-wrap,.arcadia-kz-hero{background-image:linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.45)),url('https://arcadia-tour.com/wp-content/uploads/2026/07/almaty-kazakhstan-arcadia-hero-opt-2.jpg')!important;min-height:240px!important;}}</style><div class=\"noBackground\" style=\"background-image:linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.45)),url('https://arcadia-tour.com/wp-content/uploads/2026/07/almaty-kazakhstan-arcadia-hero-opt-2.jpg');background-size:cover;background-position:center;background-repeat:no-repeat;\">\n<div>\n<div class=\"container\">\n<div class=\"row modulesTitle text-center header-design-position-under-header\">\n<div class=\"col-xs-12\">\n<div class=\"page-header-wrap\" style=\";background:linear-gradient(rgba(11,18,32,.48),rgba(11,18,32,.60)), url('https://arcadia-tour.com/wp-content/uploads/2026/07/almaty-kazakhstan-arcadia-hero-opt-2.jpg') center/cover no-repeat !important;min-height:360px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:70px 24px;border-radius:0\">\n<h1 style=\"color: rgb(255, 255, 255); text-shadow: rgba(0, 0, 0, 0.45) 0px 2px 14px; font-weight: 800;\">دليل السياحة في كازاخستان 2026</h1>\n</div>\n<div class=\"header-separator-container\">\n<hr class=\"small\"></div>\n</div>\n</div>\n</div>\n</div>\n</div>\n<div class=\"container\">\n<div class=\"row\">\n<div class=\"col-lg-12 col-md-12 col-sm-12\">\n<div class=\"responsive-handler fr-view breakable\">\n<div>\n<h2 align=\"right\" style=\"text-align: center\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">مرحبًا بكم في كازاخستان الجميلة والمضيافة – الدولة الحديثة التي حافظت على تقاليدها القديمة</span></h2>\n\n<p></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: right;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">إن كنت تفكر بالسفر للسياحة في كازاخستان، نحن نوافر&nbsp;</span><a href=\"https://arcadia-tour.com/offers-bookings/\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700;text-decoration:underline\">برامج سياحية</span></a><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">&nbsp;</span><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000;font-weight:700\">&nbsp;و</span><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">معلومات ستساعدك في معرفة&nbsp;</span><a href=\"https://arcadia-tour.com/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3%d8%aa%d8%a7%d9%86/\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700;text-decoration:underline\">أهم المدن</span></a><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">&nbsp;والمناطق السياحية في كازاخستان. كما ستزودك بمجموعة من النصائح والإرشادات ، التي ستعينك في الترتيب لرحلة رائعه &nbsp;في كازاخستان.</span></p>\n<p dir=\"rtl\" style=\"line-height: 1.554; text-align: right; margin-top: 0pt; margin-bottom: 8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">السياحة في كازاخستان ممتعة في كل فصول السنة. كل فصل من فصول السنة يعتبر فرصة جيدة لاكتشاف جمالها. وتتمتع كازاخستان بطقس بارد ومثلج شتاء في حين يصبح المناخ قاريا في فصل الصيف مع درجات حرارة تتعدى 30 درجة مئوية. بينما تزدان سهول البلاد بالزهور الجميلة في فصلي الربيع والخريف ولذلك فمن الأفضل أن تختار الموسم المفضل لك كالتالي:</span></p>\n<h3 dir=\"rtl\" style=\"line-height: 1.554; text-align: right; margin-top: 2pt; margin-bottom: 0pt\"><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">السياحة في كازاخستان في فصل الصيف (من شهر مايو إلى منتصف سبتمبر):</span></h3>\n<p dir=\"rtl\" style=\"line-height: 1.554; text-align: right; margin-top: 0pt; margin-bottom: 8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">&nbsp;في الصيف أكبر عدد من السياح حيث يمكن الجمع بين زيارة كازاخستان ورحلة لمسافات طويلة في قيرغيزستان وطاجيكستان. وذلك وسط السهول الواسعة فعلى الرغم من الحرارة المرتفعة إلا أن الجو مثالي لزيارة الجبال والاستمتاع بمناظر الطبيعة الخلابة.</span></p>\n<h3 dir=\"rtl\" style=\"line-height: 1.554; text-align: right; margin-top: 2pt; margin-bottom: 0pt\"><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">السياحة في كازاخستان في فصل الربيع (من نهاية شهر مارس إلى شهر مايو):</span></h3>\n<p style=\"text-align: right\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">&nbsp;يعتبر فصل الربيع من أفضل الأوقات لرؤية السهول الخضراء في كازاخستان. وهذا ما يجعل للسياح الفرصة في الاستمتاع بزهور الاقحوان البرية في محمية أكسو جاباجلي الطبيعية. ومن ثم الجولات الساحرة وسط الطبيعة في أجواء مناخية معتدلة &nbsp;تجنب الزوار من حر الصيف ومن برد الشتاء. كذلك يمكنكم الاستمتاع أيضا بمهرجان النوروز في 21 مارس. أعرف المزيد عن المهرجان&nbsp;</span><a href=\"https://alkhabaralyoum.com/2025/03/20/%D8%A7%D9%84%D9%86%D9%8A%D8%B1%D9%88%D8%B2-%D8%A7%D8%AD%D8%AA%D9%81%D8%A7%D9%84%D9%8C-%D8%A8%D8%A7%D9%84%D8%AA%D8%AC%D8%AF%D9%8A%D8%AF-%D9%88%D8%A7%D9%84%D8%AA%D8%B1%D8%A7%D8%AB-%D9%88%D8%A7/\">مهرجان النوروز في كازاخستان</a></p>\n<p align=\"right\"><span contenteditable=\"false\" class=\"fr-img-caption fr-fic fr-dib fr-draggable\" style=\"width: 800px; height: 400px\" draggable=\"false\"><span class=\"fr-img-wrap\"><img decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63cbf49705cea.jpg\" style=\"width: 800px; height: 400px\" alt=\"السياحة في كازاخستان في الربيع\" class=\"fr-fic fr-dib\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>السياحة في كازاخستان في الربيع&nbsp;</strong></span></span></span> &nbsp;<br>&nbsp; &nbsp;</p>\n<h3 dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:2pt;margin-bottom:0pt\"><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">السياحة في كازاخستان في فصل الخريف (من شهر سبتمبر إلى شهر أكتوبر):&nbsp;</span></h3>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">على الرغم من قصر فصل الخريف في كازاخستان على أنه من الممكن ان يكون شهر واحد إلا أن هذا الوقت مناسب لزيارة البلاد في موسم الحصاد والاستمتاع بفاكهتها اللذيذة. حيث أن مناخ كازاخستان في الخريف &nbsp;يعتبر دافئ .</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\">\n</p><p align=\"right\"><span contenteditable=\"false\" class=\"fr-img-caption fr-fic fr-dib fr-draggable\" style=\"width: 800px; height: 400px\" draggable=\"false\"><span class=\"fr-img-wrap\"><img alt=\"جبال ألماتي كازاخستان - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63cbf6c90acd4.jpg\" style=\"width: 800px; height: 400px\" class=\"fr-fic fr-dib\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>السياحة في كازاخستان في الخريف&nbsp;</strong></span></span></span>&nbsp;</p>\n<p dir=\"ltr\" style=\"line-height:1.38;text-align: right;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">&nbsp;</span></p>\n<h3 dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: right;margin-top:2pt;margin-bottom:0pt\"><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">السياحة في كازاخستان في فصل الشتاء (من شهر نوفمبر إلى نهاية شهر مارس):&nbsp;</span></h3>\n<p dir=\"ltr\" style=\"line-height:1.38;text-align: right;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">لمحبي التزلج على الجليد فإن السياحة الشتوية في كازاخستان خيار جيد &nbsp;في الفترة من شهر ديسمبر إلى فبراير. يمكن للسياح الاستمتاع خلال هذه الفترة بالانشطه الشتوية المختلفه والمتنوعه ,بأنشطة فريدة مثل التزلج والصيد على الجليد أو ركوب الخيل في الثلج &nbsp;فضلا عن الصيد بالصقور والنسور وهو شغف عمره 3000 عام&nbsp;.</span></p>\n<p style=\"text-align: right\">\n</p><p style=\"text-align: right\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">&nbsp;تعرف أكثر على رحلتنا في كل فصول السنة&nbsp;</span><a href=\"https://arcadia-tour.com/offers-bookings/\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#337ab7\">ع<u>روض شركة أركاديا السياحية</u></span></a></p>\n<p align=\"right\"><span contenteditable=\"false\" class=\"fr-img-caption fr-fic fr-dib fr-draggable\" style=\"width: 800px; height: 400px\" draggable=\"false\"><span class=\"fr-img-wrap\"><img alt=\"سياحة في كازاخستان ألماتي - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63cbf6f3aa884.jpg\" style=\"width: 800px; height: 400px\" class=\"fr-fic fr-dib\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>السياحة الشتوية في كازاخستان&nbsp;</strong></span></span></span></p>\n\n<h2 dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: right;margin-top:2pt;margin-bottom:0pt\"><span style=\"font-size:15pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">اللغة والتواصل في كازاخستان</span></h2>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: right;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">تعتبر كازاخستان تاسع أكبر دولة في العالم من ناحية المساحة الشاسعة لذلك يوجد العديد من اللغات المتحدث بها. فعلى الرغم من اللغة الكازاخية وهي لغة كازاخستان الاصليه وهي قريبة من اللغة التركية نوعا &nbsp;ويتحدث بها غالبية السكان . إلا أن اللغة الروسية شائعة ويستخدمها ويعرفها غالبية السكان وتعتبر ثاني لغة رسمية في البلاد. وتنتشر في كازاخستان كذلك كل من اللغة التترية لغة الأوزبك فضلا عن لغات الأويغور والمنغولية.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: right;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">كازاخستان من الدول التي تمتلك طبيعة خلابة والتي يمكن الاستمتاع بها بما فيها من الأماكن السياحية الرائعة والمتعددة.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: right;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">كازاخستان هي دولة غنية بالأماكن الطبيعية الخلابة حيث تكثر فيها البحيرات والغابات والمنحدرات الجبلية كما أنها تحتضن الكثير من المعالم السياحية من معالم أثرية وتاريخية عريقة إلى جانب المعالم الحديثة التي تعكس التطوّر الكبير الذي تشهده البلاد. يمكنك التعرف على المزيد من&nbsp;</span><a href=\"https://www.hiamag.com/%D8%AA%D8%B1%D9%81%D9%8A%D9%87-%D9%88%D9%81%D9%86%D9%88%D9%86/%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%88%D8%B3%D9%81%D8%B1/1773047-%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D9%83%D8%A7%D8%B2%D8%A7%D8%AE%D8%B3%D8%AA%D8%A7%D9%86-%D9%85%D8%B2%D8%AC-%D8%A8%D9%8A%D9%86-%D8%A7%D9%84%D8%B7%D8%A8%D9%8A%D8%B9%D8%A9-%D9%88%D8%A7%D9%84%D8%AB%D9%82%D8%A7%D9%81%D8%A9-%D8%A7%D9%84%D8%B9%D8%B1%D9%8A%D9%82%D8%A9\">دليل السياحة في كازاخستان</a><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">.</span></p>\n<p style=\"text-align: right\"><a href=\"https://arcadia-tour.com/%d8%ae%d8%af%d9%85%d8%a7%d8%aa%d9%86%d8%a7/\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#0563c1;text-decoration:underline\">&nbsp;</span></a><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">كازاخستان من &nbsp;الدول الآسيوية التي تتمتع بطبيعة خلابة وتتعدد الطبيعة ما بين غابات وجبال وبحيراتكازاكاهي ووديان;وصحراء، ولهذا تعتبر السياحة في كازاخستان اختيارا مثاليا للقيام برحلة حيث العديد من الأماكن السياحية التي تستحق الزيارة، وهنا سنذكر بعض المعلومات عن السياحة في كازاخستان</span></p>\n<p align=\"right\">\n</p><p align=\"right\"><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"بحيرة كولساي كازاخستان - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63cbf71fa06b6.jpg\" style=\"width: 800px; height: 400px\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><br><strong>السياحة في كازاخستان</strong></span></span></span></p>\n<p align=\"right\">\n</p><h2 dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: right;margin-top:2pt;margin-bottom:0pt\"><span style=\"font-size:15pt;font-family:Tajawal,sans-serif;color:#2e75b5;font-weight:700\">الطبيعة في كازاخستان</span></h2>\n<p dir=\"rtl\" style=\"line-height: 1.554; text-align: right; margin-top: 0pt; margin-bottom: 8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">تتميز كازاخستان بموقعها الجغرافي المميز بين قارتي أسيا وأوروبا وأيضا تتميز بجمال وتنوع الأماكن الطبيعية الخلابة فيها، وهذا ينسب للتنوع البيولوجي وتضم كازاخستان أكثر من 25 منتزه طبيعي، وأنواع من السهوب والصحاري سواء الرملية أو المالحة أو الطينية، وغابات التايغا الشمالية والجبال والقمم الثلجية. حيث تحيط مدينة ألماتي الجبال من كل مكان.</span></p>\n<p dir=\"rtl\" style=\"line-height: 1.554; text-align: right; margin-top: 0pt; margin-bottom: 8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">كما يوجد العديد من المسطحات المائية والتي تشمل الكثير من البحيرات التي تقع في الصحارى والسهول والجبال، وكما أنه يوجد بها الأنهار الكبيرة والجداول الجبلية، كما تشتهر كازاخستان بالغابات الكثيفة والمسطحات الخضراء.</span></p>\n<p dir=\"rtl\" style=\"line-height: 1.554; text-align: right; margin-top: 0pt; margin-bottom: 8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">تحتوي كازاخستان على العديد من الأماكن الفريدة حيث يوجد فيها إحدى أكبر البحيرات في العالم وهي بحيرة بلخاش كما يتواجد بها منخفض كاراجي والذي يعد ثاني أدنى منطقة برية في العالم ويبلغ ارتفاعه 132 مترا تحت مستوى سطح البحر.</span></p>\n<p style=\"text-align: right\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000;font-weight:700\">السياحة في كازاخستان</span><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">&nbsp;تضم زيارة سلسلة جبال ألتاي وغابة كركرالا الجبلية والعديد من المنحدرات والعديد من الأنهار، مما يجعل من كازاخستان احدى وجهات الجذب السياحي لكل دول العالم.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.295;text-align: justify;margin-top:0pt;margin-bottom:8pt\">\n</p><p align=\"right\">\n</p><p align=\"right\"><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"جبال ألماتي كازاخستان - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63cbf76b5622d.jpg\" style=\"width: 800px; height: 400px\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>الطبيعة في كازاخستان</strong></span></span></span></p>\n\n\n<h2 dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:2pt;margin-bottom:0pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">5</span><span style=\"font-size:15pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">&nbsp;أسباب لزيارة كازاخستان والاستمتاع بطبيعتها الساحرة</span></h2>\n<p></p>\n<ol style=\"margin-top:0;margin-bottom:0;padding-inline-start:48px\">\n<li dir=\"rtl\" style=\"list-style-type:decimal;font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700;margin-left: 19pt\">\n<p dir=\"rtl\" style=\"line-height:1.38;text-align: right;margin-top:0pt;margin-bottom:0pt\"><a href=\"https://arcadia-tour.com/%d8%ae%d8%af%d9%85%d8%a7%d8%aa%d9%86%d8%a7/\"><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">كازاخستان&nbsp;</span></a><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">موطن زهور التوليب</span></p>\n</li>\n</ol>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">قد تفاجأ بمعرفة أن كازاخستان هي موطن زهور التوليب ، وليس هولندا. بالمقارنة مع هولندا ، حيث يجتمع الناس لمشاهدة العرض السنوي لهذه الزهور الجميلة ، تنمو زهور التوليب في كازاخستان و تتفتح في البرية دون تدخل بشري وتغطي مساحات شاسعة. هنا يمكنك رؤية حوالي 40 نوعًا من 65 نوعًا مختلفًا من زهور التوليب البرية الموجودة في آسيا الوسطى ، وقد تم إدراج 18 نوعًا منها على أنها من الأنواع المهددة بالانقراض. من بينها زهور الأقحوان Shrenk و Greig ، التي تعتبر واحدة من أجملها.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">من أبريل إلى مايو، تغطي الأزهار البرتقالية والصفراء القرمزية حقولًا وسفوحًا لا حدود لها في مقاطعات جامبيل وتركستان و ألماتي. يمكنك مشاهدة هذه الألوان الجميلة أثناء السفر لمسافات طويلة على الطريق السريع من جنوب شيمكنت إلى ألماتي. بمساعدة المرشدين السياحيين المتمرسين الموجودين لدينا فهم على استعداد لمساعدتك في تحديد أفضل المواقع لمشاهدة وشرح العديد من أنواع زهور التوليب. يُمنع قطف الزنبق في كازاخستان ، ولكن يمكنك الاستمتاع بها بشكل غير عادي وعطري متى شئت!</span></p>\n<p align=\"right\">\n</p><p align=\"right\">\n</p>\n<p style=\"text-align: right\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">الانغماس في أجواء مركز الفضاء يستحق الزيارة!&nbsp;</span><a href=\"https://aawsat.com/%D8%A7%D9%84%D8%B9%D8%A7%D9%84%D9%85/%D8%A3%D9%88%D8%B1%D9%88%D8%A8%D8%A7/4552266-%D9%82%D8%A7%D8%B9%D8%AF%D8%A9-%D8%A8%D8%A7%D9%8A%D9%83%D9%88%D9%86%D9%88%D8%B1-%D9%84%D9%84%D9%81%D8%B6%D8%A7%D8%A1-%D8%AA%D8%B3%D8%AA%D9%82%D8%B7%D8%A8-%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD-%D8%A7%D9%84%D8%B1%D9%88%D8%B3-%D8%A7%D9%84%D9%85%D9%8A%D8%B3%D9%88%D8%B1%D9%8A%D9%86\">قاعدة بايكونور الفضائية</a></p>\n<p><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"ثقافة كازاخستان التقليدية - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_6401f1e143657.jpg\" style=\"width: 800px; height: 400px\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>قاعدة بايكونور</strong></span></span></span></p>\n<h4></h4>\n\n<h3 dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: right;margin-top:2pt;margin-bottom:0pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">5</span><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">. المطبخ الكازاخستاني الشهي&nbsp;</span></h3>\n<p></p>\n<p dir=\"ltr\" style=\"line-height:1.38;text-align: right;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">&nbsp;لا يمكنك مقاومة تذوق الطعام اللذيذ للمطبخ الكازاخستاني. قد يجده الكثير منكم ممتع بشكل مدهش وسرعان ما تتعرفون على ما نأكله بالفعل هنا في كازاخستان. مع هذا ، يجب أن تعلم أن شعب كازاخستان لا يأكل إلا الطعام الصحي والطبيعي ، والكثير من منتجات الألبان.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">في الوقت الحاضر ، أصبحت سياحة تذوق الطعام في كازاخستان أكثر شيوعًا، لن تجد مجموعة متنوعة من المأكولات الوطنية والنكهات المتنوعة في أي مكان في العالم مثل المطبخ الكازاخستاني. هذا يرجع إلى 135 جنسية تعيش في كازاخستان. لكن أهم ما يميزه هو المطبخ الكازاخستاني الذي يعتمد على تقاليد البدو الرحل في السهوب العظيمة. أصبحت هذه الأطعمة الشهية والصحية و “الذكية” للبدو تحظى بشعبية كبيرة بين المسافرين هذه الأيام . تعرف علي&nbsp;</span><a href=\"https://www.belmasry.news/32694#google_vignette\">المطبخ الكازاخستاني التقليدي</a><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">يمكنك تجربة أطباق الشعب الكازاخستاني الشهيرة مثل بشبرماك (لحم مسلوق مع شرائح عجين) ، بورقس (خبز منفوخ مقلي) ، قاضي (سجق لحم حصان) ، إريمشيك (جبن قريش متفتت) في العديد من المقاهي والمطاعم. ولكن سيكون من المثير للاهتمام تجربة المطبخ الوطني في قرى العرقين. الضيوف مدعوون بشكل خاص لتجربة العديد من الأطباق الفريدة ، والتي يتم إعدادها وفقًا للوصفات التي يتم جمعها. سوف يشرحون لك أيضًا كيف يتم طهي هذه الأطباق ويخبروك بالتاريخ بالتفصيل وراء الأساطير والقصص غير العادية حول هذه الأطباق.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">استمتع بجمال كازاخستان مع أركاديا السياحية&nbsp;</span><a href=\"https://arcadia-tour.com/offers-bookings/\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#337ab7\">عروض أركاديا السياحية</span></a></p>\n<p><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"طبيعة كازاخستان - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_6401f2525bc56.jpg\" style=\"width: 800px; height: 400px\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>المطبخ الكازاخستاني</strong></span></span></span></p>\n<p></p>\n<p style=\"text-align: right\">\n</p><h2 dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:2pt;margin-bottom:0pt\"><span style=\"font-size:15pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">مراكز التسوق والترفيه في كازاخستان</span></h2>\n<p></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">الماتي بها العديد من اماكن التسوق الرائعه والمتنوعه والكبيرة والتي يمكن أن تجد فيها كل ما تحتاجه، نذكر منها:</span></p>\n<ol style=\"margin-top:0;margin-bottom:0;padding-inline-start:48px\">\n<li dir=\"rtl\" style=\"list-style-type:decimal;font-size:14pt;font-family:Arial,sans-serif;color:#434343;margin-left: 19pt\">\n<h3 dir=\"rtl\" style=\"line-height:1.38;text-align: right;margin-top:16pt;margin-bottom:4pt\"><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">DOSTIK PLAZA</span></h3>\n</li>\n</ol>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">أكثر من مجرد تسوق أنه مركز تسوق وترفيه حديث واسع النطاق يقع في وسط مدينة ألماتي. يوفر التصميم الخفيف والواسع والمستوى العالي من&nbsp;</span><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">الخدمة</span><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">&nbsp;للزائرين كل ما يحتاجون إليه للحصول على تجربة تسوق ممتعة وإقامة مريحة. DOSTYK PLAZA هو مركز تسوق وترفيه حديث واسع النطاق يقع في وسط مدينة ألماتي ، ويتميز بتصميم مشرق وواسع مستوى عالٍ من الخدمة ، ويمنح الزائرين كل ما يحتاجون إليه من أجل تسوق ممتع وإقامة مريحة.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">المركز له تصميم حديث وعصري بفضل الحلول المعمارية من مكتب الهندسة المعمارية الإنجليزي الشهير Benoy وعرض واسع في مجال التسوق والترفيه ، أصبح &nbsp;DOSTYK PLAZA أحد الأماكن المفضلة لسكان ألماتي ويجب أن يراه ضيوف العاصمة الجنوبية.</span></p>\n<p align=\"right\">\n</p><p align=\"right\"><strong><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"جبال ألماتي كازاخستان - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63ff400c08fec.jpg\" style=\"width: 800px; height: 400px\"></span></span></strong><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 300px\"><span class=\"fr-img-wrap\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>DOSTIK PLAZA</strong></span></span></span></p>\n<p></p>\n<p align=\"right\"><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"سياحة في كازاخستان ألماتي - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63ff404711c64.jpg\" style=\"width: 800px; height: 400px\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>DOSTIK PLAZA</strong></span></span></span></p>\n<p></p>\n<h2 dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: right;margin-top:18pt;margin-bottom:8pt\"><span style=\"font-size:16pt;font-family:Arial,sans-serif;color:#000000\"><br></span><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#2c82c9;font-weight:700\">2.&nbsp;</span><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">MEGA Alma-Ata “ميجا ألما آتا”</span></h2>\n<p></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: right;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">مركز التسوق الأكثر شهرة في العاصمة والمنصة الأولى لمعظم الشركات العالمية الشهيرة الممثلة في كازاخستان. ماركات مثل ZARA &nbsp;و New Yorker و Armani Jeans و Marc O’Polo و Monsoon Accessorize و Baldinini و Starbucks و Burger King &nbsp;و KFC و Hardee’s والعديد من العلامات التجارية الأخرى فتحت متاجرها الأولى في كازاخستان هنا.</span></p>\n<p dir=\"ltr\" style=\"line-height:1.38;text-align: right;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000;font-weight:700\">.حصل مركز التسوق على علامة الجودة “لا تشوبها شائبة” من رابطة المستهلكين الوطنية في كازاخستان&nbsp;</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">BREEAM In-Use هو برنامج شهادات فريد يقوم بتقييم المباني العاملة للامتثال لمعايير تشغيل وصيانة العقارات. حصل المشروع على تصنيف جيد جدًا في الفئات: الإدارة ، والصحة والراحة ، والمياه ، والمواد الصديقة للبيئة ، وتقنيات توفير الطاقة ، وما إلى ذلك.&nbsp;</span></p>\n<p style=\"text-align: right\">\n</p><p style=\"text-align: right\">\n</p><p align=\"right\"><strong><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"بحيرة كولساي كازاخستان - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63ff437d16b3a.jpg\" style=\"width: 800px; height: 400px\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>MEGA Alma-Ata</strong></span></span></span></strong></p>\n<p><strong><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 300px\"><span class=\"fr-img-wrap\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"></span></span></span></strong></p>\n<p></p>\n<p><strong><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"سياحة في كازاخستان ألماتي - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63ff418890812.jpg\" style=\"width: 800px; height: 400px\"></span></span></strong><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 300px\"><span class=\"fr-img-wrap\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>ميجا ألما آتا</strong></span></span></span></p>\n<p></p>\n\n<ol style=\"margin-top:0;margin-bottom:0;padding-inline-start:48px\" start=\"3\">\n<li dir=\"rtl\" style=\"list-style-type:decimal;font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700;margin-left: 2pt\">\n<h3 dir=\"rtl\" style=\"line-height:1.38;text-align: right;margin-top:16pt;margin-bottom:4pt\"><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">Esentai&nbsp;</span><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#2c82c9;font-weight:700\">Mall</span></h3>\n</li>\n</ol>\n<p dir=\"rtl\" style=\"line-height: 1.554; text-align: right; margin-top: 0pt; margin-bottom: 8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000;font-weight:700\">&nbsp;</span></p>\n<p dir=\"rtl\" style=\"line-height: 1.554; text-align: right; margin-top: 0pt; margin-bottom: 8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">Esentai Mall هو مجمع فريد تم تصميمه وتطويره لخلق أجواء وظروف خاصة على المستوى الدولي للتسوق والترفيه. يقدم لسكان المدينة وضيوفها مجموعة واسعة من العلامات التجارية الحصرية: Burberry و Dior و Dolce &amp; Gabbana و Fendi و Giorgio Armani و Gucci و Jimmy Choo و Louis Vuitton و Prada و Valentino والمطاعم والأطعمة الجاهزة والسينما ونادي اللياقة البدنية وخدمات السبا ، مناطق ترفيهية للأطفال.</span></p>\n<p style=\"text-align: right\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000;font-weight:700\">أما فيما يخص الماركات العالمية المشهورة</span><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">&nbsp;‘ فهو أكبر مركز تسوق فاخر في آسيا الوسطى ، بالإضافة إلى مركز للأزياء وتصميم الفن المعاصر. يمكنك شراء منتجات من العلامات التجارية الرائدة في العالم مثل Dior و Louis Vuitton و The Ritz-Carlton و Porsche والمزيد.</span></p>\n<p></p>\n<p><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"ثقافة كازاخستان التقليدية - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63ff45c972b47.jpg\" style=\"width: 800px; height: 400px\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><br><strong>Esentai Mall&nbsp;</strong></span></span><span class=\"fr-img-wrap\"><img alt=\"طبيعة كازاخستان - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63ff460c27d68.jpg\" style=\"width: 800px; height: 400px\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>Esentai Mall&nbsp;</strong></span></span></span></p>\n<p></p>\n<p></p>\n<p></p>\n<p></p>\n\n<h3 dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:2pt;margin-bottom:0pt\"><span style=\"font-size:14pt;font-family:Tajawal,sans-serif;color:#0563c1;font-weight:700\">4. FORUM</span></h3>\n<p></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">FORUM هو أكبر مركز تسوق وترفيه في كازاخستان، هو تجسيد للمفهوم الفريد “City in the City” ، الذي يقع في قلب العاصمة الجنوبية. يتكون من 5 &nbsp;طوابق بمساحة إجمالية قدرها 168000 متر مربع حيث تكون مريحة للزوار من مختلف شرائح السكان. هنا ، دون مغادرة المركز التجاري ، يمكن لكل زائر الحصول على الخدمات اللازمة في مختلف مجالات النشاط: البيع بالتجزئة على نطاق واسع ، ومناطق ترفيه للأطفال ، وصالات رياضية ، وخدمات طب الأسنان ، فضلاً عن بنية تحتية اجتماعية مدروسة جيدًا.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">يعتبر مركز ترفيه للجميع حيث لدى FORUM أكثر من 150 متجراً ودورتي سينما على أحدث طراز. السينما بصيغة VIP ذات 6 شاشات ، وتقع في الطابق الثالث. يشتهر بمفهومه الفريد للأغذية والأفلام ، مع غرف راحة ممتازة وخدمة من المطعم الإيطالي لاكوبولا.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">يوجد أيضا منطقة للأطفال في الطابق الرابع من المول. يمكنك شراء جميع السلع الضرورية لأطفالك في المتاجر: Detsky Mir ، Orchestra ، Petit Berry ، Button Blue ، إلخ. لن يشعر الأطفال بالملل أبدا فى مراكز الأطفال Alem Kids و Aspan Park و Legorod و Evrikum ، &nbsp;مما يتيح لك الاستمتاع بالتسوق.</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">يوفر المركز كل وسائل الراحة للزوار، يمكنك الاستمتاع بأجواء مريحة ومأكولات لذيذة في قاعة الطعام التي تم تجديدها. يقع في الطابق الخامس ويسعد الزوار بتنوعه. يمكنك تناول الإفطار مع عائلتك أو الاستمتاع مع الأصدقاء في بلازا: بار وتراس الأصدقاء ، كوفي بوم ، ريستوبارك ، ياسودا ، سي ، ليبيم فاريم ، فرش وأكثر من ذلك بكثير – لن يترك أحد جائعًا!</span></p>\n<p dir=\"rtl\" style=\"line-height:1.5539999999999998;text-align: justify;margin-top:0pt;margin-bottom:8pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">لراحة الزوار ، يتم توفير مواقف سيارات تحت الأرض ومواقف مفتوحة في بلازا ومن جانب الشارع. نيكيتين.&nbsp;</span></p>\n<p></p>\n<p><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"جبال ألماتي كازاخستان - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63ff4b0a3e376.jpg\" style=\"width: 800px; height: 400px\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>FORUM</strong></span></span></span></p>\n<p></p>\n<p><span class=\"fr-img-caption fr-fic fr-dib fr-draggable\" contenteditable=\"false\" draggable=\"false\" style=\"width: 800px; height: 400px\"><span class=\"fr-img-wrap\"><img alt=\"سياحة في كازاخستان ألماتي - أركاديا السياحية\" decoding=\"async\" src=\"https://files.cdn-files-a.com/uploads/2152243/2000_63ff4c109f051.jpg\" style=\"width: 800px; height: 400px\"><span class=\"fr-inner\" style=\"text-align:center;display:block;margin-top:5px;\" contenteditable=\"true\"><strong>FORUM&nbsp;</strong></span></span></span></p>\n<p></p>\n<p align=\"right\" style=\"text-align: right\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#000000\">رحلة كازاخستان هي رحلة الأحلام &nbsp;يمكنكم لاطلاع على&nbsp;</span><a href=\"https://arcadia-tour.com/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3%d8%aa%d8%a7%d9%86/\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#2e75b5;font-weight:700;text-decoration:underline\">عروض وبرامج سياحية في&nbsp;</span></a><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#2e75b5;font-weight:700;text-decoration:underline\">كازاخستان من هنا</span></p>\n<p align=\"right\" style=\"text-align: right\">\n</p><p align=\"right\">\n</p></div>\n</div>\n</div>\n</div>\n</div>\n<section dir=\"rtl\" class=\"arc-kz-seo-links\" style=\"margin-top:36px;padding:20px 22px;border-top:3px solid #0563c1;background:#f8fafc;border-radius:8px;\">\n<h2 style=\"font-size:1.35rem;margin:0 0 14px;color:#0d1b2a;\">روابط مفيدة لرحلتك إلى كازاخستان</h2>\n<ul style=\"margin:0;padding-right:22px;line-height:2;\">\n<li><a href=\"https://arcadia-tour.com/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3%d8%aa%d8%a7%d9%86/%d8%aa%d8%a3%d8%b4%d9%8a%d8%b1%d8%a9-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3%d8%aa%d8%a7%d9%86/\">تأشيرة كازاخستان للعرب</a></li>\n<li><a href=\"https://arcadia-tour.com/almaty-guide/\">دليل ألماتي الشامل</a></li>\n<li><a href=\"https://arcadia-tour.com/kolsai-lake-day-trip/\">بحيرة كولساي: دليل الرحلة اليومية</a></li>\n<li><a href=\"https://arcadia-tour.com/kazakhstan-family-children-trip/\">رحلة كازاخستان للعائلات والأطفال</a></li>\n<li><a href=\"https://arcadia-tour.com/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3%d8%aa%d8%a7%d9%86/kazakhstan-10-days/\">برنامج كازاخستان السياحي 10 أيام</a></li>\n<li><a href=\"https://arcadia-tour.com/offers-bookings/\">عروض وبرامج سياحية في كازاخستان</a></li>\n</ul>\n</section>\n\n<section dir=\"rtl\" class=\"arc-kz-faq\" style=\"margin-top:32px;padding:20px 22px;background:#fff;border:1px solid #e8ecf0;border-radius:8px;\">\n<h2 style=\"font-size:1.35rem;margin:0 0 16px;color:#0d1b2a;\">أسئلة شائعة عن السياحة في كازاخستان</h2>\n<h3 style=\"font-size:1.1rem;margin:18px 0 8px;color:#0563c1;\">ما أفضل وقت لزيارة كازاخستان؟</h3>\n<p style=\"margin:0 0 12px;line-height:1.8;\">من مايو إلى سبتمبر مثالي للطبيعة والجولات في ألماتي وأستانا. الشتاء مناسب لعشاق التزلج في منتجعات الجبال.</p>\n<h3 style=\"font-size:1.1rem;margin:18px 0 8px;color:#0563c1;\">هل تحتاج تأشيرة لكازاخستان؟</h3>\n<p style=\"margin:0 0 12px;line-height:1.8;\">يعتمد على جنسيتك. نساعدك في إجراءات التأشيرة ونوفر مرشداً عربياً طوال الرحلة.</p>\n<h3 style=\"font-size:1.1rem;margin:18px 0 8px;color:#0563c1;\">ما أشهر مدن كازاخستان للسياحة؟</h3>\n<p style=\"margin:0 0 12px;line-height:1.8;\">ألماتي للجبال والتسوق، وأستانا (نور سلطان) للعمارة الحديثة والمتاحف، وبحيرة كولساي لرحلات اليوم الواحد.</p>\n<h3 style=\"font-size:1.1rem;margin:18px 0 8px;color:#0563c1;\">هل توجد برامج عائلية في كازاخستان؟</h3>\n<p style=\"margin:0 0 12px;line-height:1.8;\">نعم — برامج مصممة للعائلات والأطفال مع فنادق مناسبة ونقل مريح ومرشد عربي.</p>\n<h3 style=\"font-size:1.1rem;margin:18px 0 8px;color:#0563c1;\">كيف أحجز رحلة كازاخستان مع أركاديا؟</h3>\n<p style=\"margin:0;line-height:1.8;\">تواصل عبر واتساب <a href=\"https://wa.me/77064007561\">+77064007561</a> أو صفحة <a href=\"https://arcadia-tour.com/offers-bookings/\">العروض والحجوزات</a>.</p>\n</section>\n\n<section dir=\"rtl\" class=\"arc-kz-cta\" style=\"margin-top:28px;padding:22px;text-align:center;background:linear-gradient(135deg,#0563c1,#0d1b2a);border-radius:10px;color:#fff;\">\n<h2 style=\"margin:0 0 10px;font-size:1.4rem;color:#fff;\">احجز رحلتك إلى كازاخستان مع مرشد عربي</h2>\n<p style=\"margin:0 0 16px;opacity:.95;\">برامج ألماتي وأستانا — فنادق، نقل، تأشيرة ودعم 24/7</p>\n<a href=\"https://wa.me/77064007561?text=%D8%B1%D8%AD%D9%84%D8%A9%20%D9%83%D8%A7%D8%B2%D8%A7%D8%AE%D8%B3%D8%AA%D8%A7%D9%86\" style=\"display:inline-block;background:#25d366;color:#fff;padding:12px 28px;border-radius:8px;font-weight:700;text-decoration:none;margin-left:10px;\">واتساب +77064007561</a>\n<a href=\"https://arcadia-tour.com/offers-bookings/\" style=\"display:inline-block;background:#c9a84c;color:#0d1b2a;padding:12px 28px;border-radius:8px;font-weight:700;text-decoration:none;\">استكشف برامج كازاخستان</a>\n</section>\n"},"elements":[],"widgetType":"text-editor"}],"isInner":false}]