[{"id":"50bbffa","elType":"container","settings":[],"elements":[{"id":"82dcfc1","elType":"widget","settings":{"html":"<style>\r\n  :root {\r\n    --gold: #C9A84C;\r\n    --gold-light: #E8C97A;\r\n    --dark: #0D1B2A;\r\n    --dark2: #1A2E42;\r\n    --white: #FFFFFF;\r\n    --gray: #F4F6F8;\r\n    --text: #2C3E50;\r\n    --kz-blue: #00AFCA;\r\n  }\r\n\r\n  * { margin: 0; padding: 0; box-sizing: border-box; }\r\n\r\n  body {\r\n    font-family: Tajawal, sans-serif;\r\n    direction: rtl;\r\n    color: var(--text);\r\n    background: var(--white);\r\n  }\r\n\r\n  \/* HERO *\/\r\n  .hero {\r\n    min-height: 60vh;\r\n    background: linear-gradient(135deg, rgba(13,59,110,.66) 0%, rgba(21,101,192,.5) 50%, rgba(2,136,209,.55) 100%), url(https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/03\/normal_67d61036a4336.jpg) center\/cover no-repeat;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    text-align: center;\r\n    position: relative;\r\n    overflow: hidden;\r\n    padding: 80px 20px;\r\n  }\r\n\r\n  .hero::before {\r\n    content: ;\r\n    position: absolute;\r\n    inset: 0;\r\n    background: url(https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/03\/kazakhstan-hero-v2.jpg) center\/cover no-repeat;\r\n    opacity: 0;\r\n  }\r\n\r\n  .hero-content {\r\n    position: relative;\r\n    z-index: 2;\r\n    max-width: 800px;\r\n  }\r\n\r\n  .hero-badge {\r\n    display: inline-block;\r\n    background: rgba(255,215,0,0.2);\r\n    border: 1px solid rgba(255,215,0,0.5);\r\n    color: #FFD700;\r\n    padding: 8px 24px;\r\n    border-radius: 50px;\r\n    font-size: 14px;\r\n    margin-bottom: 20px;\r\n  }\r\n\r\n  .hero h1 {\r\n    font-size: clamp(2rem, 5vw, 4rem);\r\n    font-weight: 900;\r\n    color: var(--white);\r\n    line-height: 1.2;\r\n    margin-bottom: 16px;\r\n  }\r\n\r\n  .hero p {\r\n    font-size: 1.2rem;\r\n    color: rgba(255,255,255,0.85);\r\n    max-width: 600px;\r\n    margin: 0 auto 32px;\r\n    line-height: 1.8;\r\n  }\r\n\r\n  .hero-btns {\r\n    display: flex;\r\n    gap: 16px;\r\n    justify-content: center;\r\n    flex-wrap: wrap;\r\n  }\r\n\r\n  .btn-gold {\r\n    background: var(--gold);\r\n    color: var(--dark);\r\n    padding: 14px 36px;\r\n    border-radius: 50px;\r\n    font-size: 1rem;\r\n    font-weight: 700;\r\n    text-decoration: none;\r\n    transition: all 0.3s;\r\n  }\r\n\r\n  .btn-gold:hover {\r\n    background: var(--gold-light);\r\n    transform: translateY(-2px);\r\n  }\r\n\r\n  .btn-outline {\r\n    background: transparent;\r\n    color: var(--white);\r\n    padding: 14px 36px;\r\n    border-radius: 50px;\r\n    font-size: 1rem;\r\n    font-weight: 700;\r\n    text-decoration: none;\r\n    border: 2px solid rgba(255,255,255,0.4);\r\n    transition: all 0.3s;\r\n  }\r\n\r\n  .btn-outline:hover { border-color: var(--gold); color: var(--gold); }\r\n\r\n  \/* INTRO *\/\r\n  .intro {\r\n    padding: 80px 20px;\r\n    max-width: 900px;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n  }\r\n\r\n  .section-tag {\r\n    display: inline-block;\r\n    color: var(--gold);\r\n    font-size: 14px;\r\n    font-weight: 700;\r\n    letter-spacing: 3px;\r\n    text-transform: uppercase;\r\n    margin-bottom: 12px;\r\n  }\r\n\r\n  .intro h2 {\r\n    font-size: clamp(1.8rem, 4vw, 2.8rem);\r\n    font-weight: 900;\r\n    color: var(--dark);\r\n    margin-bottom: 20px;\r\n  }\r\n\r\n  .intro p {\r\n    color: #555;\r\n    font-size: 1.1rem;\r\n    line-height: 1.9;\r\n  }\r\n\r\n  \/* CARDS *\/\r\n  .cards-section {\r\n    padding: 20px 20px 80px;\r\n    background: var(--gray);\r\n  }\r\n\r\n  .cards-title {\r\n    text-align: center;\r\n    font-size: clamp(1.5rem, 3vw, 2.2rem);\r\n    font-weight: 900;\r\n    color: var(--dark);\r\n    margin-bottom: 48px;\r\n  }\r\n\r\n  .cards-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));\r\n    gap: 28px;\r\n    max-width: 1200px;\r\n    margin: 0 auto;\r\n  }\r\n\r\n  .card {\r\n    background: var(--white);\r\n    border-radius: 20px;\r\n    overflow: hidden;\r\n    box-shadow: 0 4px 20px rgba(0,0,0,0.08);\r\n    transition: all 0.4s;\r\n    text-decoration: none;\r\n    color: inherit;\r\n    display: block;\r\n  }\r\n\r\n  .card:hover {\r\n    transform: translateY(-8px);\r\n    box-shadow: 0 20px 50px rgba(0,0,0,0.15);\r\n  }\r\n\r\n  .card-img {\r\n    height: 200px;\r\n    overflow: hidden;\r\n    position: relative;\r\n  }\r\n\r\n  .card-img img {\r\n    width: 100%;\r\n    height: 100%;\r\n    object-fit: cover;\r\n    transition: transform 0.4s;\r\n  }\r\n\r\n  .card:hover .card-img img { transform: scale(1.05); }\r\n\r\n  .card-num {\r\n    position: absolute;\r\n    top: 16px;\r\n    right: 16px;\r\n    background: var(--gold);\r\n    color: var(--dark);\r\n    width: 36px;\r\n    height: 36px;\r\n    border-radius: 50%;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    font-weight: 900;\r\n    font-size: 1rem;\r\n  }\r\n\r\n  .card-body {\r\n    padding: 24px;\r\n  }\r\n\r\n  .card-body h3 {\r\n    font-size: 1.15rem;\r\n    font-weight: 800;\r\n    color: var(--dark);\r\n    margin-bottom: 10px;\r\n    line-height: 1.4;\r\n  }\r\n\r\n  .card-body p {\r\n    color: #666;\r\n    font-size: 0.95rem;\r\n    line-height: 1.7;\r\n    margin-bottom: 20px;\r\n  }\r\n\r\n  .card-link {\r\n    color: var(--gold);\r\n    font-weight: 700;\r\n    font-size: 0.95rem;\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 6px;\r\n  }\r\n\r\n  \/* FACTS *\/\r\n  .facts {\r\n    padding: 80px 20px;\r\n    background: var(--dark);\r\n  }\r\n\r\n  .facts-inner {\r\n    max-width: 1000px;\r\n    margin: 0 auto;\r\n    text-align: center;\r\n  }\r\n\r\n  .facts h2 {\r\n    font-size: 2rem;\r\n    font-weight: 900;\r\n    color: var(--white);\r\n    margin-bottom: 48px;\r\n  }\r\n\r\n  .facts-grid {\r\n    display: grid;\r\n    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\r\n    gap: 32px;\r\n  }\r\n\r\n  .fact-item {\r\n    background: rgba(255,255,255,0.05);\r\n    border: 1px solid rgba(255,255,255,0.1);\r\n    border-radius: 16px;\r\n    padding: 32px 20px;\r\n  }\r\n\r\n  .fact-icon { font-size: 2.5rem; margin-bottom: 12px; }\r\n\r\n  .fact-num {\r\n    font-size: 2rem;\r\n    font-weight: 900;\r\n    color: var(--gold);\r\n    display: block;\r\n    margin-bottom: 8px;\r\n  }\r\n\r\n  .fact-label {\r\n    color: rgba(255,255,255,0.7);\r\n    font-size: 0.95rem;\r\n  }\r\n\r\n  \/* CTA *\/\r\n  .cta {\r\n    padding: 80px 20px;\r\n    text-align: center;\r\n  }\r\n\r\n  .cta-box {\r\n    max-width: 700px;\r\n    margin: 0 auto;\r\n    background: linear-gradient(135deg, var(--dark) 0%, #1A3A5C 100%);\r\n    border-radius: 24px;\r\n    padding: 60px 40px;\r\n    color: var(--white);\r\n  }\r\n\r\n  .cta-box h2 {\r\n    font-size: 2rem;\r\n    font-weight: 900;\r\n    margin-bottom: 16px;\r\n  }\r\n\r\n  .cta-box p {\r\n    color: rgba(255,255,255,0.7);\r\n    margin-bottom: 32px;\r\n    font-size: 1.05rem;\r\n  }\r\n\r\n  .whatsapp-btn {\r\n    background: #25D366;\r\n    color: white;\r\n    padding: 14px 36px;\r\n    border-radius: 50px;\r\n    font-size: 1rem;\r\n    font-weight: 700;\r\n    text-decoration: none;\r\n    display: inline-flex;\r\n    align-items: center;\r\n    gap: 10px;\r\n    transition: all 0.3s;\r\n  }\r\n\r\n  .whatsapp-btn:hover {\r\n    transform: translateY(-2px);\r\n    box-shadow: 0 10px 30px rgba(37,211,102,0.4);\r\n  }\r\n\r\n  @media (max-width: 768px) {\r\n    .cards-grid { grid-template-columns: 1fr; }\r\n    .cta-box { padding: 40px 24px; }\r\n  }\r\n<\/style>\r\n\r\n<!-- HERO -->\r\n<section class=\"hero\">\r\n  <div class=\"hero-content\">\r\n    <div class=\"hero-badge\">\ud83c\uddf0\ud83c\uddff \u0648\u062c\u0647\u0629 \u0633\u064a\u0627\u062d\u064a\u0629 \u0645\u0645\u064a\u0632\u0629<\/div>\r\n    <h1>\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/h1>\r\n    <p>\u0627\u0633\u062a\u0645\u062a\u0639 \u0628\u062b\u0642\u0627\u0641\u0629 \u063a\u0646\u064a\u0629 \u0648\u0637\u0628\u064a\u0639\u0629 \u062e\u0644\u0627\u0628\u0629 \u0648\u0643\u0631\u0645 \u0627\u0644\u0636\u064a\u0627\u0641\u0629 \u0627\u0644\u0623\u0635\u064a\u0644 \u2014 \u0645\u0639 \u0645\u0631\u0634\u062f\u064a\u0646 \u0646\u0627\u0637\u0642\u064a\u0646 \u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629<\/p>\r\n    <div class=\"hero-btns\">\r\n      <a href=\"https:\/\/wa.me\/77064007561\" class=\"btn-gold\">\ud83d\udcac \u0627\u062d\u062c\u0632 \u0631\u062d\u0644\u062a\u0643 \u0627\u0644\u0622\u0646<\/a>\r\n      <a href=\"\/offers-bookings\/\" class=\"btn-outline\">\ud83c\udf0d \u0627\u0633\u062a\u0639\u0631\u0636 \u0627\u0644\u0639\u0631\u0648\u0636<\/a>\r\n    <\/div>\r\n  <\/div>\r\n<\/section>\r\n\r\n<!-- INTRO -->\r\n<section class=\"intro\">\r\n  <span class=\"section-tag\">\u0639\u0646 \u0627\u0644\u0648\u062c\u0647\u0629<\/span>\r\n  <h2>\u0644\u0645\u0627\u0630\u0627 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h2>\r\n  <p>\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0628\u0644\u062f \u0631\u0627\u0626\u0639 \u064a\u062c\u0645\u0639 \u0628\u064a\u0646 \u0627\u0644\u062d\u062f\u0627\u062b\u0629 \u0648\u0627\u0644\u062a\u0631\u0627\u062b \u0627\u0644\u0639\u0631\u064a\u0642. \u062a\u0645\u062a\u062f \u0639\u0644\u0649 \u0645\u0633\u0627\u062d\u0629 \u0634\u0627\u0633\u0639\u0629 \u062a\u0636\u0645 \u062c\u0628\u0627\u0644\u0627\u064b \u0634\u0627\u0647\u0642\u0629\u060c \u0633\u0647\u0648\u0644\u0627\u064b \u062e\u0636\u0631\u0627\u0621\u060c \u0628\u062d\u064a\u0631\u0627\u062a \u0633\u0627\u062d\u0631\u0629\u060c \u0648\u0645\u062f\u0646\u0627\u064b \u0639\u0635\u0631\u064a\u0629 \u062a\u0628\u0647\u0631 \u0627\u0644\u0632\u0648\u0627\u0631. \u0645\u062f\u064a\u0646\u0629 \u0623\u0644\u0645\u0627\u062a\u064a \u0627\u0644\u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u0627\u0642\u062a\u0635\u0627\u062f\u064a\u0629 \u062a\u0639\u062f \u0645\u0646 \u0623\u062c\u0645\u0644 \u0627\u0644\u0645\u062f\u0646 \u0641\u064a \u0622\u0633\u064a\u0627 \u0627\u0644\u0648\u0633\u0637\u0649\u060c \u0628\u064a\u0646\u0645\u0627 \u062a\u0628\u0647\u0631 \u0623\u0633\u062a\u0627\u0646\u0627 \u0627\u0644\u0639\u0627\u0644\u0645 \u0628\u0645\u0639\u0645\u0627\u0631\u0647\u0627 \u0627\u0644\u0641\u0631\u064a\u062f. \u0634\u0631\u0643\u0629 \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u062a\u0642\u062f\u0645 \u0644\u0643 \u062a\u062c\u0631\u0628\u0629 \u0633\u0641\u0631 \u0645\u062a\u0643\u0627\u0645\u0644\u0629 \u0645\u0639 \u0645\u0631\u0634\u062f\u064a\u0646 \u0646\u0627\u0637\u0642\u064a\u0646 \u0628\u0627\u0644\u0639\u0631\u0628\u064a\u0629 \u0648\u062e\u062f\u0645\u0629 \u0639\u0644\u0649 \u0623\u0639\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0648\u064a\u0627\u062a.<\/p>\r\n<\/section>\r\n\r\n<!-- CARDS -->\r\n<section class=\"cards-section\">\r\n  <h2 class=\"cards-title\">\u0627\u0643\u062a\u0634\u0641 \u0643\u0644 \u0645\u0627 \u062a\u062d\u062a\u0627\u062c\u0647 \u0639\u0646 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/h2>\r\n  <div class=\"cards-grid\">\r\n\r\n    <a href=\"\/kazakhstan-tourism-overview\/\" class=\"card\">\r\n      <div class=\"card-img\">\r\n        <img src=\"https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/03\/normal_67d61036a4336.jpg\" alt=\"\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\" loading=\"lazy\">\r\n        <div class=\"card-num\">1<\/div>\r\n      <\/div>\r\n      <div class=\"card-body\">\r\n        <h3>\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/h3>\r\n        <p>\u0627\u0633\u062a\u0645\u062a\u0639 \u0628\u062b\u0642\u0627\u0641\u0629 \u063a\u0646\u064a\u0629 \u0648\u0637\u0628\u064a\u0639\u0629 \u062e\u0644\u0627\u0628\u0629 \u0648\u0643\u0631\u0645 \u0627\u0644\u0636\u064a\u0627\u0641\u0629 \u0627\u0644\u0623\u0635\u064a\u0644 \u0641\u064a \u0623\u0644\u0645\u0627\u062a\u064a \u0648\u0623\u0633\u062a\u0627\u0646\u0627 \u0648\u0623\u062c\u0645\u0644 \u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629<\/p>\r\n        <span class=\"card-link\">\u0627\u0639\u0631\u0641 \u0623\u0643\u062b\u0631 \u2190<\/span>\r\n      <\/div>\r\n    <\/a>\r\n\r\n    <a href=\"\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\/%d8%a7%d9%84%d9%85%d8%af%d9%86-%d9%81%d9%8a-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3%d8%aa%d8%a7%d9%86-%d8%aa%d8%b9%d8%b1%d9%81-%d8%b9%d9%84%d9%89-%d8%a3%d9%87%d9%85-9-%d9%85%d8%af%d9%86-%d8%b3%d9%8a\" class=\"card\">\r\n      <div class=\"card-img\">\r\n        <img src=\"https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/03\/kaz-cities.jpg\" alt=\"\u0627\u0644\u0645\u062f\u0646 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\" loading=\"lazy\">\r\n        <div class=\"card-num\">2<\/div>\r\n      <\/div>\r\n      <div class=\"card-body\">\r\n        <h3>\u0627\u0644\u0645\u062f\u0646 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u2014 \u0623\u0647\u0645 9 \u0645\u062f\u0646 \u0633\u064a\u0627\u062d\u064a\u0629<\/h3>\r\n        <p>\u064a\u0648\u062c\u062f \u0627\u0644\u0639\u062f\u064a\u062f \u0645\u0646 \u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0627\u0644\u062a\u064a \u062a\u0633\u062a\u062d\u0642 \u0627\u0644\u0632\u064a\u0627\u0631\u0629 \u0644\u0645\u0627 \u062a\u0636\u0645\u0647 \u0645\u0646 \u062a\u0627\u0631\u064a\u062e \u0648\u062b\u0642\u0627\u0641\u0629 \u0648\u062d\u0636\u0627\u0631\u0629<\/p>\r\n        <span class=\"card-link\">\u0627\u0639\u0631\u0641 \u0623\u0643\u062b\u0631 \u2190<\/span>\r\n      <\/div>\r\n    <\/a>\r\n\r\n    <a href=\"\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\/\u062a\u0623\u0634\u064a\u0631\u0629-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\" class=\"card\">\r\n      <div class=\"card-img\">\r\n        <img src=\"https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/03\/kaz-visa.jpg\" alt=\"\u062a\u0623\u0634\u064a\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\" loading=\"lazy\">\r\n        <div class=\"card-num\">3<\/div>\r\n      <\/div>\r\n      <div class=\"card-body\">\r\n        <h3>\u062a\u0623\u0634\u064a\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/h3>\r\n        <p>\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062a\u0623\u0634\u064a\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646: \u0645\u0639\u0638\u0645 \u0645\u0648\u0627\u0637\u0646\u064a \u062f\u0648\u0644 \u0627\u0644\u062e\u0644\u064a\u062c \u064a\u062f\u062e\u0644\u0648\u0646 \u0628\u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629\u060c \u0648\u062c\u0646\u0633\u064a\u0627\u062a \u0639\u062f\u064a\u062f\u0629 \u0644\u062f\u064a\u0647\u0627 \u0625\u0639\u0641\u0627\u0621 \u0623\u0648 \u062a\u0623\u0634\u064a\u0631\u0629 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u2014 \u0631\u0627\u062c\u0639 \u062f\u0644\u064a\u0644\u0646\u0627 \u0627\u0644\u0625\u0631\u0634\u0627\u062f\u064a \u0642\u0628\u0644 \u0631\u062d\u0644\u062a\u0643<\/p>\r\n        <span class=\"card-link\">\u0627\u0639\u0631\u0641 \u0623\u0643\u062b\u0631 \u2190<\/span>\r\n      <\/div>\r\n    <\/a>\r\n\r\n    <a href=\"\/\u062a\u062c\u0627\u0631\u0628-\u0644\u0627-\u062a-\u0646\u0633\u0649-\u0623\u0646\u0634\u0637\u0629-\u0645\u0645\u064a\u0632\u0629-\u0639\u0646\u062f-\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\/\" class=\"card\">\r\n      <div class=\"card-img\">\r\n        <img src=\"https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/03\/kaz-nature.jpg\" alt=\"\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\" loading=\"lazy\">\r\n        <div class=\"card-num\">4<\/div>\r\n      <\/div>\r\n      <div class=\"card-body\">\r\n        <h3>\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/h3>\r\n        <p>\u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0645\u062a\u0646\u0648\u0639\u0629 \u0648\u0645\u062b\u064a\u0631\u0629 \u0628\u0641\u0636\u0644 \u0637\u0628\u064a\u0639\u062a\u0647\u0627 \u0627\u0644\u062c\u0630\u0627\u0628\u0629 \u0645\u0646 \u062c\u0628\u0627\u0644 \u0648\u0648\u062f\u064a\u0627\u0646 \u0648\u0623\u0646\u0647\u0627\u0631 \u0648\u0645\u0631\u062a\u0641\u0639\u0627\u062a \u0648\u0645\u0633\u0637\u062d\u0627\u062a \u0645\u0627\u0626\u064a\u0629<\/p>\r\n        <span class=\"card-link\">\u0627\u0639\u0631\u0641 \u0623\u0643\u062b\u0631 \u2190<\/span>\r\n      <\/div>\r\n    <\/a>\r\n\r\n    <a href=\"\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\/\u0645\u0639\u0644\u0648\u0645\u0627\u062a-\u0648\u0646\u0635\u0627\u0626\u062d-\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\/\" class=\"card\">\r\n      <div class=\"card-img\">\r\n        <img src=\"https:\/\/arcadia-tour.com\/wp-content\/uploads\/2026\/03\/kaz-tips.jpg\" alt=\"\u0646\u0635\u0627\u0626\u062d \u0627\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\" loading=\"lazy\">\r\n        <div class=\"card-num\">5<\/div>\r\n      <\/div>\r\n      <div class=\"card-body\">\r\n        <h3>\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0646\u0635\u0627\u0626\u062d \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627