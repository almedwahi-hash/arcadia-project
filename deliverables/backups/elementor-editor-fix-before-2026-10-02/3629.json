{"id": 3629, "content": "<section dir=\"rtl\" style=\"position:relative;min-height:360px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:78px 24px;background:linear-gradient(135deg,rgba(13,30,60,.6),rgba(21,60,120,.5)),url(https://arcadia-tour.com/wp-content/uploads/2026/06/arcadia-hero-happy-tourists.jpg) center/cover no-repeat;margin:0 0 32px;border-radius:14px\">🌍 وجهاتنا<h1 style=\"color:#fff;font-size:40px;font-weight:800;margin:0;text-shadow:0 2px 14px rgba(0,0,0,.45)\">وجهاتنا السياحية</h1><p style=\"color:#eef2f8;font-size:18px;max-width:700px;margin:16px auto 0;line-height:1.7\">اكتشف كازاخستان وروسيا وبولندا وأوزبكستان والصين — رحلات منظّمة بالكامل مع مرشدين ناطقين بالعربية.</p></section><!-- wp:html -->\n<!-- Hero Section -->\n    ✈ استكشف العالم معنا\n    <h2 style=\"color: #ffffff; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; margin-bottom: 20px; line-height: 1.2;\">وجهاتنا السياحية</h2>\n    <p style=\"color: rgba(255,255,255,0.8); font-size: 1.2rem; line-height: 1.8; max-width: 600px; margin: 0 auto;\">برامج سياحية متكاملة إلى أجمل الوجهات في آسيا الوسطى وأوروبا الشرقية والصين — مع مرشدين ناطقين بالعربية</p>\n<!-- Destinations Cards -->\n    <!-- كازاخستان -->\n    <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D9%83%D8%A7%D8%B2%D8%A7%D8%AE%D8%B3%D8%AA%D8%A7%D9%86/\" style=\"text-decoration: none; color: inherit; display: block; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.12); transition: transform 0.3s, box-shadow 0.3s;\">\n        <img src=\"https://arcadia-tour.com/wp-content/uploads/2026/03/normal_67d61036a4336.jpg\" alt=\"السياحة في كازاخستان\" style=\"width: 100%; height: 100%; object-fit: cover;\">\n        🇰🇿\n        <h2 style=\"position: absolute; bottom: 20px; right: 20px; color: white; font-size: 1.5rem; font-weight: 900; margin: 0;\">السياحة في كازاخستان</h2>\n        <p style=\"color: #555; line-height: 1.8; margin-bottom: 20px;\">اكتشف جمال ألماتي وأستانا — المدينتان اللتان تجمعان الحضارة الحديثة مع الطبيعة الخلابة وكرم الضيافة الكازاخية الأصيل.</p>\n          🏔️ جبال آلاتاو\n          🌃 أستانا الجديدة\n          🗣️ مرشد عربي\n          من $580 <small style=\"font-size: 0.8rem; color: #888;\">/ شخص</small>\n          اكتشف المزيد ←\n    </a>\n    <!-- روسيا -->\n    <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D8%B1%D9%88%D8%B3%D9%8A%D8%A7/\" style=\"text-decoration: none; color: inherit; display: block; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.12);\">\n        <img src=\"https://images.unsplash.com/photo-1513326738677-b964603b136d?w=600\" alt=\"السياحة في روسيا\" style=\"width: 100%; height: 100%; object-fit: cover;\">\n        🇷🇺\n        <h2 style=\"position: absolute; bottom: 20px; right: 20px; color: white; font-size: 1.5rem; font-weight: 900; margin: 0;\">السياحة في روسيا</h2>\n        <p style=\"color: #555; line-height: 1.8; margin-bottom: 20px;\">اكتشف روعة موسكو الكبرى وسحر سانت بطرسبرغ — كنوز الحضارة الروسية العريقة بين القصور الذهبية والساحات الشهيرة.</p>\n          🏰 الكرملين\n          🎭 هيرميتاج\n          🗣️ مرشد عربي\n          من $1,066 <small style=\"font-size: 0.8rem; color: #888;\">/ شخص</small>\n          اكتشف المزيد ←\n    </a>\n    <!-- بولندا -->\n    <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D8%A8%D9%88%D9%84%D9%86%D8%AF%D8%A7/\" style=\"text-decoration: none; color: inherit; display: block; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.12);\">\n        <img src=\"https://images.unsplash.com/photo-1519197924294-4ba991a11128?w=600\" alt=\"السياحة في بولندا\" style=\"width: 100%; height: 100%; object-fit: cover;\">\n        🇵🇱\n        <h2 style=\"position: absolute; bottom: 20px; right: 20px; color: white; font-size: 1.5rem; font-weight: 900; margin: 0;\">السياحة في بولندا</h2>\n        <p style=\"color: #555; line-height: 1.8; margin-bottom: 20px;\">تجوّل في شوارع وارسو التاريخية وكراكوف الساحرة — واكتشف جمال جبال زاكوباني البولندية الخلابة في رحلة لا تُنسى.</p>\n          🏛️ وارسو القديمة\n          ⛰️ زاكوباني\n          🗣️ مرشد عربي\n          تواصل للسعر <small style=\"font-size: 0.8rem; color: #888;\">المخصص</small>\n          اكتشف المزيد ←\n    </a>\n    <!-- أوزبكستان -->\n    <a href=\"https://arcadia-tour.com/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D8%A3%D9%88%D8%B2%D8%A8%D9%83%D8%B3%D8%AA%D8%A7%D9%86/\" style=\"text-decoration: none; color: inherit; display: block; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.12);\">\n        <img src=\"https://arcadia-tour.com/wp-content/uploads/2026/03/el-registan.jpg\" alt=\"السياحة في أوزبكستان\" style=\"width: 100%; height: 100%; object-fit: cover;\">\n        🇺🇿\n        <h2 style=\"position: absolute; bottom: 20px; right: 20px; color: white; font-size: 1.5rem; font-weight: 900; margin: 0;\">السياحة في أوزبكستان</h2>\n        <p style=\"color: #555; line-height: 1.8; margin-bottom: 20px;\">سافر عبر الزمن على درب الحرير في سمرقند وبخارى وخيفا — مدن التاريخ الإسلامي العريق والفن المعماري الخالد.</p>\n          🕌 الرجستان\n          🏰 بخارى\n          🗣️ مرشد عربي\n          أسعار مميزة\n          اكتشف المزيد ←\n    </a>\n    <!-- الصين -->\n    <a href=\"https://arcadia-tour.com/china-main/\" style=\"text-decoration: none; color: inherit; display: block; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.12);\">\n        <img src=\"https://images.unsplash.com/photo-1508804185872-d7badad00f7d?w=600\" alt=\"السياحة في الصين\" style=\"width: 100%; height: 100%; object-fit: cover;\">\n        🇨🇳\n        <h2 style=\"position: absolute; bottom: 20px; right: 20px; color: white; font-size: 1.5rem; font-weight: 900; margin: 0;\">السياحة في الصين</h2>\n        <p style=\"color: #555; line-height: 1.8; margin-bottom: 20px;\">اكتشف سور الصين العظيم وبكين وشنغهاي وقوانزو — مع مرافق عربي متخصص ومكتبنا الخاص في قوانزو لتسهيل تجارتك.</p>\n          🏯 السور العظيم\n          🏙️ شنغهاي\n          🤝 استيراد وأعمال\n          تواصل للسعر\n          اكتشف المزيد ←\n    </a>\n<!-- City Guides Section -->\n    📖 محتوى مجاني\n    <h2 style=\"font-size: 2rem; font-weight: 900; color: #0D1B2A; margin-bottom: 14px;\">أدلة المدن الشاملة</h2>\n    <p style=\"color: #666; font-size: 1.05rem; max-width: 600px; margin: 0 auto; line-height: 1.8;\">كل ما تحتاج معرفته قبل سفرك — معالم، مطاعم، نصائح، وتكاليف — مجاناً</p>\n    <!-- موسكو -->\n    <a href=\"https://arcadia-tour.com/moscow-guide/\" style=\"text-decoration: none; color: inherit; display: flex; align-items: center; gap: 18px; background: white; border: 1px solid #eee; border-radius: 16px; padding: 22px; box-shadow: 0 4px 16px rgba(0,0,0,0.06); transition: box-shadow 0.2s;\">\n      🏰\n        🇷🇺 روسيا\n        دليل موسكو الشامل\n        اقرأ الدليل ←\n    </a>\n    <!-- سانت بطرسبرغ -->\n    <a href=\"https://arcadia-tour.com/saint-petersburg-guide/\" style=\"text-decoration: none; color: inherit; display: flex; align-items: center; gap: 18px; background: white; border: 1px solid #eee; border-radius: 16px; padding: 22px; box-shadow: 0 4px 16px rgba(0,0,0,0.06);\">\n      🎭\n        🇷🇺 روسيا\n        دليل سانت بطرسبرغ الشامل\n        اقرأ الدليل ←\n    </a>\n    <!-- ألماتي -->\n    <a href=\"https://arcadia-tour.com/almaty-guide/\" style=\"text-decoration: none; color: inherit; display: flex; align-items: center; gap: 18px; background: white; border: 1px solid #eee; border-radius: 16px; padding: 22px; box-shadow: 0 4px 16px rgba(0,0,0,0.06);\">\n      🏔️\n        🇰🇿 كازاخستان\n        دليل ألماتي الشامل\n        اقرأ الدليل ←\n    </a>\n    <!-- بولندا -->\n    <a href=\"https://arcadia-tour.com/poland-guide/\" style=\"text-decoration: none; color: inherit; display: flex; align-items: center; gap: 18px; background: white; border: 1px solid #eee; border-radius: 16px; padding: 22px; box-shadow: 0 4px 16px rgba(0,0,0,0.06);\">\n      🏛️\n        🇵🇱 بولندا\n        دليل بولندا الشامل\n        اقرأ الدليل ←\n    </a>\n    <!-- قوانزو -->\n    <a href=\"https://arcadia-tour.com/guangzhou-guide/\" style=\"text-decoration: none; color: inherit; display: flex; align-items: center; gap: 18px; background: white; border: 1px solid #eee; border-radius: 16px; padding: 22px; box-shadow: 0 4px 16px rgba(0,0,0,0.06);\">\n      🏙️\n        🇨🇳 الصين\n        دليل قوانزو الشامل\n        اقرأ الدليل ←\n    </a>\n<!-- لماذا أركاديا -->\n    <h2 style=\"font-size: 2rem; font-weight: 900; color: #0D1B2A; margin-bottom: 40px;\">لماذا تختار أركاديا لرحلتك؟</h2>\n        🗣️\n        <h3 style=\"font-weight: 800; color: #0D1B2A; margin-bottom: 10px;\">مرشدون عرب</h3>\n        <p style=\"color: #666; font-size: 0.9rem; line-height: 1.7;\">مرشدون سياحيون ناطقون بالعربية في جميع الوجهات</p>\n        🏨\n        <h3 style=\"font-weight: 800; color: #0D1B2A; margin-bottom: 10px;\">فنادق مميزة</h3>\n        <p style=\"color: #666; font-size: 0.9rem; line-height: 1.7;\">إقامة في أفضل الفنادق بأسعار تنافسية مضمونة</p>\n        📋\n        <h3 style=\"font-weight: 800; color: #0D1B2A; margin-bottom: 10px;\">برامج متكاملة</h3>\n        <p style=\"color: #666; font-size: 0.9rem; line-height: 1.7;\">تنظيم شامل من الفيزا حتى العودة بسلام</p>\n        💬\n        <h3 style=\"font-weight: 800; color: #0D1B2A; margin-bottom: 10px;\">دعم 24/7</h3>\n        <p style=\"color: #666; font-size: 0.9rem; line-height: 1.7;\">فريقنا متاح على مدار الساعة لمساعدتك</p>\n<!-- CTA -->\n  <h2 style=\"color: white; font-size: 2rem; font-weight: 900; margin-bottom: 15px;\">احجز رحلتك الآن</h2>\n  <p style=\"color: rgba(255,255,255,0.7); font-size: 1.1rem; margin-bottom: 35px;\">تواصل معنا وسنصمم لك رحلة الأحلام</p>\n  <a href=\"https://wa.me/77064007561?text=مرحباً، أريد الاستفسار عن وجهاتكم السياحية\" target=\"_blank\" style=\"display: inline-flex; align-items: center; gap: 10px; background: #25D366; color: white; padding: 16px 40px; border-radius: 50px; font-size: 1.1rem; font-weight: 700; text-decoration: none; margin-left: 15px;\">\n    💬 واتساب\n  </a>\n  <a href=\"https://arcadia-tour.com/offers-bookings/\" style=\"display: inline-flex; align-items: center; gap: 10px; background: #C9A84C; color: #0D1B2A; padding: 16px 40px; border-radius: 50px; font-size: 1.1rem; font-weight: 700; text-decoration: none;\">\n    🌍 استعرض العروض\n  </a>\n<!-- /wp:html -->", "_elementor_data": "[{\"id\":\"2d930e56\",\"elType\":\"container\",\"settings\":[],\"elements\":[{\"id\":\"76442afd\",\"elType\":\"widget\",\"settings\":{\"editor\":\"<section class=\\\"arcadia-hero\\\" dir=\\\"rtl\\\" style=\\\"position:relative;min-height:360px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:78px 24px;background:linear-gradient(135deg,rgba(13,30,60,.6),rgba(21,60,120,.5)),url(https://arcadia-tour.com/wp-content/uploads/2026/06/arcadia-hero-happy-tourists.jpg) center/cover no-repeat;margin:0 0 32px;border-radius:14px\\\"><span style=\\\"display:inline-block;background:rgba(200,164,92,.92);color:#13161c;font-weight:700;padding:7px 18px;border-radius:30px;font-size:14px;margin-bottom:16px\\\">🌍 وجهاتنا</span><h1 style=\\\"color:#fff;font-size:40px;font-weight:800;margin:0;text-shadow:0 2px 14px rgba(0,0,0,.45)\\\">وجهاتنا السياحية</h1><p style=\\\"color:#eef2f8;font-size:18px;max-width:700px;margin:16px auto 0;line-height:1.7\\\">اكتشف كازاخستان وروسيا وبولندا وأوزبكستان والصين — رحلات منظّمة بالكامل مع مرشدين ناطقين بالعربية.</p></section><!-- wp:html -->\\n<div style=\\\"font-family: Tajawal, Tahoma, Arial, sans-serif; direction: rtl;\\\">\\n\\n<!-- Hero Section -->\\n<div style=\\\"background: linear-gradient(135deg, #0D1B2A 0%, #1A2E42 60%, #1E3A5F 100%); padding: 100px 20px; text-align: center; position: relative; overflow: hidden;\\\">\\n  <div style=\\\"position: relative; z-index: 2; max-width: 800px; margin: 0 auto;\\\">\\n    <span style=\\\"display: inline-block; background: rgba(201,168,76,0.2); border: 1px solid rgba(201,168,76,0.5); color: #E8C97A; padding: 8px 24px; border-radius: 50px; font-size: 14px; margin-bottom: 20px;\\\">✈ استكشف العالم معنا</span>\\n    <h2 style=\\\"color: #ffffff; font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 900; margin-bottom: 20px; line-height: 1.2;\\\">وجهاتنا السياحية</h2>\\n    <p style=\\\"color: rgba(255,255,255,0.8); font-size: 1.2rem; line-height: 1.8; max-width: 600px; margin: 0 auto;\\\">برامج سياحية متكاملة إلى أجمل الوجهات في آسيا الوسطى وأوروبا الشرقية والصين — مع مرشدين ناطقين بالعربية</p>\\n  </div>\\n</div>\\n\\n<!-- Destinations Cards -->\\n<div style=\\\"max-width: 1200px; margin: 0 auto; padding: 80px 20px;\\\">\\n  <div style=\\\"display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 40px;\\\">\\n\\n    <!-- كازاخستان -->\\n    <a href=\\\"https://arcadia-tour.com/السياحة-في-كازاخستان/\\\" style=\\\"text-decoration: none; color: inherit; display: block; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.12); transition: transform 0.3s, box-shadow 0.3s;\\\">\\n      <div style=\\\"position: relative; height: 240px; overflow: hidden;\\\">\\n        <img src=\\\"https://arcadia-tour.com/wp-content/uploads/2026/03/normal_67d61036a4336.jpg\\\" alt=\\\"السياحة في كازاخستان\\\" style=\\\"width: 100%; height: 100%; object-fit: cover;\\\">\\n        <div style=\\\"position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 60%);\\\"></div>\\n        <span style=\\\"position: absolute; top: 16px; right: 16px; background: white; padding: 6px 12px; border-radius: 20px; font-size: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.2);\\\">🇰🇿</span>\\n        <h2 style=\\\"position: absolute; bottom: 20px; right: 20px; color: white; font-size: 1.5rem; font-weight: 900; margin: 0;\\\">السياحة في كازاخستان</h2>\\n      </div>\\n      <div style=\\\"padding: 28px; background: white;\\\">\\n        <p style=\\\"color: #555; line-height: 1.8; margin-bottom: 20px;\\\">اكتشف جمال ألماتي وأستانا — المدينتان اللتان تجمعان الحضارة الحديثة مع الطبيعة الخلابة وكرم الضيافة الكازاخية الأصيل.</p>\\n        <div style=\\\"display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px;\\\">\\n          <span style=\\\"background: #f0f4ff; color: #1a1a2e; padding: 5px 12px; border-radius: 15px; font-size: 13px;\\\">🏔️ جبال آلاتاو</span>\\n          <span style=\\\"background: #f0f4ff; color: #1a1a2e; padding: 5px 12px; border-radius: 15px; font-size: 13px;\\\">🌃 أستانا الجديدة</span>\\n          <span style=\\\"background: #f0f4ff; color: #1a1a2e; padding: 5px 12px; border-radius: 15px; font-size: 13px;\\\">🗣️ مرشد عربي</span>\\n        </div>\\n        <div style=\\\"display: flex; justify-content: space-between; align-items: center;\\\">\\n          <span style=\\\"color: #C9A84C; font-size: 1.4rem; font-weight: 900;\\\">من $580 <small style=\\\"font-size: 0.8rem; color: #888;\\\">/ شخص</small></span>\\n          <span style=\\\"color: #C9A84C; font-weight: 700;\\\">اكتشف المزيد ←</span>\\n        </div>\\n      </div>\\n    </a>\\n\\n    <!-- روسيا -->\\n    <a href=\\\"https://arcadia-tour.com/السياحة-في-روسيا/\\\" style=\\\"text-decoration: none; color: inherit; display: block; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.12);\\\">\\n      <div style=\\\"position: relative; height: 240px; overflow: hidden;\\\">\\n        <img src=\\\"https://images.unsplash.com/photo-1513326738677-b964603b136d?w=600\\\" alt=\\\"السياحة في روسيا\\\" style=\\\"width: 100%; height: 100%; object-fit: cover;\\\">\\n        <div style=\\\"position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.6) 0%, transparent 60%);\\\"></div>\\n        <span style=\\\"position: absolute; top: 16px; right: 16px; background: white; padding: 6px 12px; border-radius: 20px; font-size: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.2);\\\">🇷🇺</span>\\n        <h2 style=\\\"position: absolute; bottom: 20px; right: 20px; color: white; font-size: 1.5rem; font-weight: 900; margin: 0;\\\">السياحة في روسيا</h2>\\n      </div>\\n      <div style=\\\"padding: 28px; background: white;\\\">\\n        <p style=\\\"color: #555; line-height: 1.8; margin-bottom: 20px;\\\">اكتشف روعة موسكو الكبرى وسحر سانت بطرسبرغ — كنوز الحضارة الروسية العريقة بين القصور الذهبية والساحات الشهيرة.</p>\\n        <div style=\\\"display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px;\\\">\\n          <span style=\\\"background: #f0f4ff; color: #1a1a2e; padding: 5px 12px; border-radius: 15px; font-size: 13px;\\\">🏰 الكرملين</span>\\n          <span style=\\\"background: #f0f4ff; color: #1a1a2e; padding: 5px 12px; border-radius: 15px; font-size: 13px;\\\">🎭 هيرميتاج</span>\\n          <span style=\\\"background: #f0f4ff; color: #1a1a2e; padding: 5px 12px; border-radius: 15px; font-size: 13px;\\\">🗣️ مرشد عربي</span>\\n        </div>\\n        <div style=\\\"display: flex; justify-content: space-between; align-items: center;\\\">\\n          <span style=\\\"color: #C9A84C; font-size: 1.4rem; font-weight: 900;\\\">من $1,066 <small style=\\\"font-size: 0.8rem; color: #888;\\\">/ شخص</small></span>\\n          <span style=\\\"color: #C9A84C; font-weight: 700;\\\">اكتشف المزيد ←</span>\\n        </div>\\n      </div>\\n    </a>\\n\\n    <!-- بولندا -->\\n    <a href=\\\"https://arcadia-tour.com/السياحة-في-بولندا/\\\" style=\\\"text-decoration: none; color: inherit; display: block; border-radius: 20px; overflow: hidden; box-shadow: 0 8px 30px rgba(0,0,0,0.12);\\\">\\n      <div style=\\\"position: relative; height: 240px; overflow: hidden;\\\">\\n        <img src=\\\"https://images.unsplash.com/photo-1519197924294-4ba991a11128?w=600\\\" alt=\\\"السياحة في بولندا\\\" style=\\\"width: 100%; height: 100%; object-fit: cover;\\\">\\n        <div style=\\\"position: absolute; inset: 0; background: linear-gradie