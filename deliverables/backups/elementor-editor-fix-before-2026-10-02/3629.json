der-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 26px;\\\">🏛️</div>\\n      <div>\\n        <div style=\\\"font-size: 12px; color: #888; margin-bottom: 4px;\\\">🇵🇱 بولندا</div>\\n        <div style=\\\"font-weight: 800; color: #0D1B2A; font-size: 1rem; margin-bottom: 5px;\\\">دليل بولندا الشامل</div>\\n        <div style=\\\"color: #C9A84C; font-size: 13px; font-weight: 600;\\\">اقرأ الدليل ←</div>\\n      </div>\\n    </a>\\n\\n    <!-- قوانزو -->\\n    <a href=\\\"https://arcadia-tour.com/guangzhou-guide/\\\" style=\\\"text-decoration: none; color: inherit; display: flex; align-items: center; gap: 18px; background: white; border: 1px solid #eee; border-radius: 16px; padding: 22px; box-shadow: 0 4px 16px rgba(0,0,0,0.06);\\\">\\n      <div style=\\\"flex-shrink: 0; width: 56px; height: 56px; background: linear-gradient(135deg, #D84315, #BF360C); border-radius: 14px; display: flex; align-items: center; justify-content: center; font-size: 26px;\\\">🏙️</div>\\n      <div>\\n        <div style=\\\"font-size: 12px; color: #888; margin-bottom: 4px;\\\">🇨🇳 الصين</div>\\n        <div style=\\\"font-weight: 800; color: #0D1B2A; font-size: 1rem; margin-bottom: 5px;\\\">دليل قوانزو الشامل</div>\\n        <div style=\\\"color: #C9A84C; font-size: 13px; font-weight: 600;\\\">اقرأ الدليل ←</div>\\n      </div>\\n    </a>\\n\\n  </div>\\n</div>\\n\\n\\n<!-- لماذا أركاديا -->\\n<div style=\\\"background: #f8f9fa; padding: 80px 20px;\\\">\\n  <div style=\\\"max-width: 900px; margin: 0 auto; text-align: center;\\\">\\n    <h2 style=\\\"font-size: 2rem; font-weight: 900; color: #0D1B2A; margin-bottom: 40px;\\\">لماذا تختار أركاديا لرحلتك؟</h2>\\n    <div style=\\\"display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 30px;\\\">\\n      <div style=\\\"background: white; border-radius: 16px; padding: 30px 20px; box-shadow: 0 4px 15px rgba(0,0,0,0.06);\\\">\\n        <div style=\\\"font-size: 2.5rem; margin-bottom: 15px