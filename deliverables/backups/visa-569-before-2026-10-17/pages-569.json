{"id":569,"content":{"raw":"<aside id=\"arcadia-visa-info-only\" dir=\"rtl\" style=\"margin:18px 0;padding:16px 18px;border-right:4px solid #d6a936;background:#fff8e7;border-radius:10px;line-height:1.9;color:#26384a\"><strong>\u062a\u0646\u0628\u064a\u0647 \u0645\u0647\u0645:<\/strong> \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0644\u0644\u062a\u0648\u0639\u064a\u0629 \u0628\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0641\u0642\u0637. \u0634\u0631\u0643\u0629 \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0644\u0627 \u062a\u0642\u062f\u0645 \u062e\u062f\u0645\u0629 \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0623\u0648 \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a. \u062e\u062f\u0645\u0627\u062a\u0646\u0627 \u062a\u0634\u0645\u0644 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0648\u0627\u0644\u062a\u0646\u0642\u0644\u0627\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u062c\u0647\u0629. <a href=\"https:\/\/arcadia-tour.com\/offers-bookings\/\">\u0627\u0633\u062a\u0639\u0631\u0636 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629<\/a>.<\/aside>\n<p id=\"arcadia-visa-official-sources\" dir=\"rtl\" style=\"margin:14px 0;line-height:1.9\"><strong>\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u0635\u062f\u0631 \u0627\u0644\u0631\u0633\u0645\u064a \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631:<\/strong> <a href=\"https:\/\/www.gov.kz\/memleket\/entities\/mfa\/activities\/34747?lang=en&amp;parentId=3053\" target=\"_blank\" rel=\"noopener noreferrer\">\u062c\u062f\u0648\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629<\/a>\u060c <a href=\"https:\/\/vmp.gov.kz\/en\/\" target=\"_blank\" rel=\"noopener noreferrer\">\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629<\/a>.<\/p>\n<p dir=\"rtl\" style=\"line-height:1.32;text-align: right;margin-top:15pt;margin-bottom:16pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#414141;background-color:#ffffff\">\u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u062e\u0637\u0637 \u0644\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 <u><a href=\"https:\/\/arcadia-tour.com\/offers-bookings\/\">\u0639\u0631\u0648\u0636 \u0634\u0631\u0643\u0629 \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0644\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/a><\/u><\/span><\/p>\n\n\n<p class=\"arc-related-link\">\u062a\u062e\u0637\u0651\u0637 \u0644\u0631\u062d\u0644\u062a\u0643\u061f \u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0643\u0644 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0641\u064a \u062f\u0644\u064a\u0644 <a href=\"https:\/\/arcadia-tour.com\/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D9%83%D8%A7%D8%B2%D8%A7%D8%AE%D8%B3%D8%AA%D8%A7%D9%86\/\">\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/a> \u0627\u0644\u0634\u0627\u0645\u0644 \u0645\u0639 \u0623\u0631\u0643\u0627\u062f\u064a\u0627.<\/p>\n\n<h2>\u0645\u0646 \u064a\u062f\u062e\u0644 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0628\u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629\u061f<\/h2>\n<p>\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0645\u0646 \u0623\u0633\u0647\u0644 \u062f\u0648\u0644 \u0622\u0633\u064a\u0627 \u062f\u062e\u0648\u0644\u0627\u064b \u0644\u0644\u0645\u0633\u0627\u0641\u0631 \u0627\u0644\u062e\u0644\u064a\u062c\u064a. \u0628\u062d\u0633\u0628 \u062c\u062f\u0648\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a \u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629:<\/p>\n<table>\n<thead><tr><th>\u0627\u0644\u062c\u0646\u0633\u064a\u0629<\/th><th>\u0627\u0644\u0648\u0636\u0639<\/th><th>\u0645\u062f\u0629 \u0627\u0644\u0625\u0642\u0627\u0645\u0629<\/th><\/tr><\/thead>\n<tbody>\n<tr><td>\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u060c \u0642\u0637\u0631\u060c \u0627\u0644\u0643\u0648\u064a\u062a\u060c \u0627\u0644\u0628\u062d\u0631\u064a\u0646\u060c \u0639\u064f\u0645\u0627\u0646<\/td><td>\u0628\u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629<\/td><td>\u062d\u062a\u0649 30 \u064a\u0648\u0645\u0627\u064b \u0641\u064a \u0643\u0644 \u0632\u064a\u0627\u0631\u0629 (\u0628\u062d\u062f \u0623\u0642\u0635\u0649 90 \u064a\u0648\u0645\u0627\u064b \u062e\u0644\u0627\u0644 180 \u064a\u0648\u0645\u0627\u064b)<\/td><\/tr>\n<tr><td>\u0627\u0644\u0623\u0631\u062f\u0646<\/td><td>\u0628\u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 (\u0625\u0639\u0641\u0627\u0621 \u0623\u062d\u0627\u062f\u064a)<\/td><td>\u062d\u062a\u0649 30 \u064a\u0648\u0645\u0627\u064b<\/td><\/tr>\n<tr><td>\u0645\u0635\u0631\u060c \u0627\u0644\u062c\u0632\u0627\u0626\u0631\u060c \u0627\u0644\u0645\u063a\u0631\u0628\u060c \u062a\u0648\u0646\u0633\u060c \u0627\u0644\u0639\u0631\u0627\u0642\u060c \u0644\u0628\u0646\u0627\u0646\u060c \u0633\u0648\u0631\u064a\u0627\u060c \u0627\u0644\u064a\u0645\u0646\u060c \u0644\u064a\u0628\u064a\u0627\u060c \u0627\u0644\u0633\u0648\u062f\u0627\u0646<\/td><td>\u062a\u0623\u0634\u064a\u0631\u0629 \u0645\u0637\u0644\u0648\u0628\u0629<\/td><td>\u0628\u062d\u0633\u0628 \u0646\u0648\u0639 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629<\/td><\/tr>\n<\/tbody>\n<\/table>\n<p>\u0642\u0648\u0627\u0626\u0645 \u0627\u0644\u0625\u0639\u0641\u0627\u0621 \u062a\u062a\u063a\u064a\u0631 \u0645\u0646 \u0633\u0646\u0629 \u0644\u0623\u062e\u0631\u0649\u061b \u062a\u062d\u0642\u0642\u0648\u0627 \u0645\u0646 \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0631\u0633\u0645\u064a \u0642\u0628\u0644 \u0627\u0644\u062d\u062c\u0632. \u0627\u0644\u062c\u0648\u0627\u0632 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0635\u0627\u0644\u062d\u0627\u064b \u0644\u0645\u062f\u0629 \u0644\u0627 \u062a\u0642\u0644 \u0639\u0646 3 \u0623\u0634\u0647\u0631 \u0628\u0639\u062f \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629\u060c \u0648\u064a\u064f\u0646\u0635\u062d \u0628\u06406 \u0623\u0634\u0647\u0631.<\/p>\n\n<h2>\u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0644\u0645\u0646 \u064a\u062d\u062a\u0627\u062c\u0647\u0627<\/h2>\n<p>\u062a\u0642\u062f\u0645 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0633\u064a\u0627\u062d\u064a\u0629 \u0644\u0639\u062f\u062f \u0645\u0646 \u0627\u0644\u062c\u0646\u0633\u064a\u0627\u062a \u0639\u0628\u0631 <strong>\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629<\/strong>\u060c \u0648\u062a\u062a\u0637\u0644\u0628 \u0641\u064a \u0627\u0644\u0639\u0627\u062f\u0629: \u0635\u0648\u0631\u0629 \u0627\u0644\u062c\u0648\u0627\u0632\u060c \u0635\u0648\u0631\u0629 \u0634\u062e\u0635\u064a\u0629\u060c \u062d\u062c\u0632 \u0641\u0646\u062f\u0642\u060c \u0648\u062a\u0630\u0643\u0631\u0629 \u0630\u0647\u0627\u0628 \u0648\u0639\u0648\u062f\u0629\u060c \u0648\u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u062e\u0637\u0627\u0628 \u062f\u0639\u0648\u0629 \u0645\u0646 \u062c\u0647\u0629 \u0645\u0633\u062a\u0636\u064a\u0641\u0629 \u0645\u0633\u062c\u0644\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646. \u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0645\u0639\u062a\u0627\u062f\u0629 \u0644\u0644\u0645\u0639\u0627\u0644\u062c\u0629 5\u201310 \u0623\u064a\u0627\u0645 \u0639\u0645\u0644. \u0644\u0645\u0646 \u0644\u0627 \u062a\u062a\u0648\u0641\u0631 \u0644\u0647 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\u060c \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0639\u0628\u0631 \u0633\u0641\u0627\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0641\u064a \u0628\u0644\u062f\u0647. \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0644\u0627 \u062a\u0635\u062f\u0631 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0644\u0627 \u062e\u0637\u0627\u0628\u0627\u062a \u0627\u0644\u062f\u0639\u0648\u0629\u060c \u0644\u0643\u0646\u0646\u0627 \u0646\u0632\u0648\u062f \u0639\u0645\u0644\u0627\u0621\u0646\u0627 \u0628\u062d\u062c\u0648\u0632\u0627\u062a \u0627\u0644\u0641\u0646\u0627\u062f\u0642 \u0627\u0644\u0645\u0624\u0643\u062f\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0644\u0644\u0637\u0644\u0628.<\/p>\n\n<h2>\u0645\u0627\u0630\u0627 \u064a\u062d\u062f\u062b \u0639\u0646\u062f \u0627\u0644\u0648\u0635\u0648\u0644\u061f<\/h2>\n<ul>\n<li><strong>\u0627\u0644\u062c\u0648\u0627\u0632\u0627\u062a:<\/strong> \u062e\u062a\u0645 \u062f\u062e\u0648\u0644 \u0641\u064a \u0645\u0637\u0627\u0631 \u0623\u0644\u0645\u0627\u062a\u064a \u0623\u0648 \u0623\u0633\u062a\u0627\u0646\u0627 \u062f\u0648\u0646 \u0646\u0645\u0627\u0630\u062c \u0648\u0631\u0642\u064a\u0629\u060c \u0648\u064a\u064f\u0637\u0644\u0628 \u0623\u062d\u064a\u0627\u0646\u0627\u064b \u062d\u062c\u0632 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u062a\u0630\u0643\u0631\u0629 \u0627\u0644\u0639\u0648\u062f\u0629.<\/li>\n<li><strong>\u0627\u0644\u062a\u0633\u062c\u064a\u0644:<\/strong> \u0627\u0644\u0641\u0646\u062f\u0642 \u064a\u0628\u0644\u063a \u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0647\u062c\u0631\u0629 \u0628\u0648\u0635\u0648\u0644\u0643\u0645 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u062e\u0644\u0627\u0644 3 \u0623\u064a\u0627\u0645 \u0639\u0645\u0644\u060c \u0648\u0644\u0627 \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0633\u0627\u0626\u062d \u0644\u0623\u064a \u0625\u062c\u0631\u0627\u0621 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0625\u0642\u0627\u0645\u0629 \u0623\u0642\u0644 \u0645\u0646 30 \u064a\u0648\u0645\u0627\u064b.<\/li>\n<li><strong>\u0627\u0644\u0623\u0637\u0641\u0627\u0644:<\/strong> \u064a\u062f\u062e\u0644\u0648\u0646 \u0628\u062c\u0648\u0627\u0632\u0627\u062a\u0647\u0645 \u0645\u0639 \u0646\u0641\u0633 \u0634\u0631\u0648\u0637 \u0627\u0644\u0643\u0628\u0627\u0631\u060c \u0648\u0644\u0627 \u064a\u064f\u0637\u0644\u0628 \u0645\u0648\u0627\u0641\u0642\u0629 \u0625\u0636\u0627\u0641\u064a\u0629 \u0639\u0646\u062f \u0627\u0644\u0633\u0641\u0631 \u0645\u0639 \u0623\u062d\u062f \u0627\u0644\u0648\u0627\u0644\u062f\u064a\u0646 \u0639\u0627\u062f\u0629\u064b.<\/li>\n<li><strong>\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u062d\u064a:<\/strong> \u063a\u064a\u0631 \u0625\u0644\u0632\u0627\u0645\u064a \u0644\u0644\u062f\u062e\u0648\u0644\u060c \u0644\u0643\u0646\u0647 \u0645\u0648\u0635\u0649 \u0628\u0647 \u0628\u0634\u062f\u0629 \u0648\u0645\u0634\u0645\u0648\u0644 \u0641\u064a \u0628\u0631\u0627\u0645\u062c \u0623\u0631\u0643\u0627\u062f\u064a\u0627.<\/li>\n<\/ul>\n\n<h2>\u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0648\u0627\u0644\u0639\u0628\u0648\u0631 \u0625\u0644\u0649 \u0623\u0648\u0632\u0628\u0643\u0633\u062a\u0627\u0646<\/h2>\n<p>\u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0639\u0627\u0626\u0644\u0627\u062a \u062a\u062c\u0645\u0639 \u0628\u064a\u0646 \u0627\u0644\u0628\u0644\u062f\u064a\u0646. \u0627\u0644\u062e\u0631\u0648\u062c \u0645\u0646 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0648\u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0623\u0648\u0632\u0628\u0643\u0633\u062a\u0627\u0646 \u0628\u0637\u064a\u0631\u0627\u0646 \u0645\u0628\u0627\u0634\u0631 \u0645\u0646 \u0623\u0644\u0645\u0627\u062a\u064a \u0625\u0644\u0649 \u0637\u0634\u0642\u0646\u062f (\u0633\u0627\u0639\u0629 \u0648\u0646\u0635\u0641)\u060c \u0648\u0645\u0648\u0627\u0637\u0646\u0648 \u0627\u0644\u062e\u0644\u064a\u062c \u0645\u0639\u0641\u0648\u0646 \u0645\u0646 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0641\u064a \u0627\u0644\u0628\u0644\u062f\u064a\u0646. \u0648\u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0628\u0639\u062f \u0632\u064a\u0627\u0631\u0629 \u0623\u0648\u0632\u0628\u0643\u0633\u062a\u0627\u0646 \u062a\u064f\u062d\u0633\u0628 \u0632\u064a\u0627\u0631\u0629 \u062c\u062f\u064a\u062f\u0629 \u0636\u0645\u0646 \u062d\u062f 90 \u064a\u0648\u0645\u0627\u064b \u0641\u064a 180 \u064a\u0648\u0645\u0627\u064b. \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-uzbekistan-10-days-trip\/\">\u0631\u062d\u0644\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0648\u0623\u0648\u0632\u0628\u0643\u0633\u062a\u0627\u0646 10 \u0623\u064a\u0627\u0645<\/a>.<\/p>\n\n<h2>\u0646\u0635\u0627\u0626\u062d \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631<\/h2>\n<ul>\n<li>\u0627\u062d\u0645\u0644\u0648\u0627 \u0646\u0633\u062e\u0629 \u0645\u0646 \u062d\u062c\u0632 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u062a\u0630\u0643\u0631\u0629 \u0627\u0644\u0639\u0648\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0647\u0627\u062a\u0641.<\/li>\n<li>\u0644\u0627 \u064a\u064f\u0637\u0644\u0628 \u0625\u062b\u0628\u0627\u062a \u0645\u0627\u0644\u064a \u0639\u0627\u062f\u0629\u064b\u060c \u0644\u0643\u0646 \u0628\u0637\u0627\u0642\u0629 \u0628\u0646\u0643\u064a\u0629 \u0648\u0646\u0642\u062f\u0627\u064b \u0643\u0627\u0641\u064a\u0627\u064b \u0623\u0645\u0631 \u0645\u0639\u062a\u0627\u062f.<\/li>\n<li>\u0627\u0644\u062f\u062e\u0648\u0644 \u0628\u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u061b \u0627\u0644\u062c\u0648\u0627\u0632 \u0625\u0644\u0632\u0627\u0645\u064a.<\/li>\n<li>\u0644\u0644\u0645\u0633\u0627\u0641\u0631 \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u062a\u062d\u062f\u064a\u062f\u0627\u064b \u0631\u0627\u062c\u0639\u0648\u0627 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-for-saudis-2026\/\">\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0644\u0633\u0639\u0648\u062f\u064a\u064a\u0646<\/a>\u060c \u0648\u0644\u0644\u062a\u0643\u0644\u0641\u0629 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-family-trip-cost-2026\/\">\u062a\u0643\u0644\u0641\u0629 \u0631\u062d\u0644\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0644\u0639\u0627\u0626\u0644\u0627\u062a<\/a>.<\/li>\n<\/ul>\n\n<h2>\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629 \u0639\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0644\u0639\u0631\u0628<\/h2>\n<h3>\u0647\u0644 \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0645\u0635\u0631\u064a\u0648\u0646 \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629 \u0644\u062f\u062e\u0648\u0644 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h3>\n<p>\u0628\u062d\u0633\u0628 \u062c\u062f\u0648\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u060c \u064a\u062d\u062a\u0627\u062c \u062d\u0627\u0645\u0644 \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631 \u0627\u0644\u0645\u0635\u0631\u064a \u0627\u0644\u0639\u0627\u062f\u064a \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631. \u062a\u062e\u062a\u0644\u0641 \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0648\u0627\u0644\u0623\u0647\u0644\u064a\u0629 \u0644\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\u060c \u0644\u0630\u0644\u0643 \u064a\u062c\u0628 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629 \u0623\u0648 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629. \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0644\u0627 \u062a\u0633\u062a\u062e\u0631\u062c \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0644\u0627 \u062a\u0635\u062f\u0631 \u062e\u0637\u0627\u0628\u0627\u062a \u0627\u0644\u062f\u0639\u0648\u0629.<\/p>\n<h3>\u0647\u0644 \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u062c\u0632\u0627\u0626\u0631\u064a\u0648\u0646 \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629 \u0644\u062f\u062e\u0648\u0644 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h3>\n<p>\u0628\u062d\u0633\u0628 \u062c\u062f\u0648\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u060c \u064a\u062d\u062a\u0627\u062c \u062d\u0627\u0645\u0644 \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631 \u0627\u0644\u062c\u0632\u0627\u0626\u0631\u064a \u0627\u0644\u0639\u0627\u062f\u064a \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631. \u0631\u0627\u062c\u0639 \u0627\u0644\u0633\u0641\u0627\u0631\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629 \u0623\u0648 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0644\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0642\u0646\u0627\u0629 \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0644\u062d\u0627\u0644\u062a\u0643. \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u062a\u0642\u062f\u0645 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0641\u0642\u0637 \u0648\u0644\u0627 \u062a\u0642\u062f\u0645 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a.<\/p>\n<h3>\u0647\u0644 \u0645\u0648\u0627\u0637\u0646\u0648 \u062f\u0648\u0644 \u0627\u0644\u062e\u0644\u064a\u062c \u0645\u0639\u0641\u0648\u0646 \u0645\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h3>\n<p>\u0646\u0639\u0645\u060c \u064a\u0645\u0643\u0646 \u0644\u0645\u0648\u0627\u0637\u0646\u064a \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0628\u062d\u0631\u064a\u0646 \u0648\u0627\u0644\u0643\u0648\u064a\u062a \u0648\u0639\u064f\u0645\u0627\u0646 \u0648\u0642\u0637\u0631 \u0648\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0628\u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0644\u0645\u062f\u0629 \u062a\u0635\u0644 \u0625\u0644\u0649 30 \u064a\u0648\u0645\u064b\u0627 \u0648\u0641\u0642 \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0631\u0633\u0645\u064a\u060c \u0645\u0639 \u0636\u0631\u0648\u0631\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0634\u0631\u0648\u0637 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631.<\/p>\n<h3>\u0643\u0645 \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629 \u0648\u0643\u0645 \u062a\u0633\u062a\u063a\u0631\u0642\u061f<\/h3>\n<p>\u062a\u062e\u062a\u0644\u0641 \u0627\u0644\u0631\u0633\u0648\u0645 \u0648\u0645\u062f\u0629 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0628\u062d\u0633\u0628 \u0646\u0648\u0639 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0648\u0627\u0644\u062c\u0646\u0633\u064a\u0629 \u0648\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628\u060c \u0648\u0642\u062f \u062a\u062a\u063a\u064a\u0631. \u0631\u0627\u062c\u0639 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0623\u0648 \u0627\u0644\u0628\u0639\u062b\u0629 \u0627\u0644\u062f\u0628\u0644\u0648\u0645\u0627\u0633\u064a\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629 \u0627\u0644\u0645\u062e\u062a\u0635\u0629 \u0642\u0628\u0644 \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0637\u0644\u0628.<\/p>\n<h3>\u0647\u0644 \u0623\u062d\u062a\u0627\u062c \u0644\u0644\u062a\u0633\u062c\u064a\u0644 \u0644\u062f\u0649 \u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0647\u062c\u0631\u0629 \u0628\u0639\u062f \u0648\u0635\u0648\u0644\u064a \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h3>\n<p>\u0644\u0627 \u062d\u0627\u062c\u0629 \u0644\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0634\u062e\u0635\u064a \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0625\u0642\u0627\u0645\u062a\u0643 \u0623\u0642\u0644 \u0645\u0646 30 \u064a\u0648\u0645\u064b\u0627\u060c \u0644\u0643\u0646 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u0636\u064a\u0641\u0629 (\u0627\u0644\u0641\u0646\u062f\u0642 \u0623\u0648 \u0627\u0644\u0645\u064f\u0636\u064a\u0641) \u0645\u0644\u0632\u0645\u0629 \u0628\u0625\u062e\u0637\u0627\u0631 \u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0647\u062c\u0631\u0629 \u0628\u0648\u0635\u0648\u0644\u0643 \u062e\u0644\u0627\u0644 3 \u0623\u064a\u0627\u0645 \u0639\u0645\u0644 \u0645\u0646 \u0639\u0628\u0648\u0631 \u0627\u0644\u062d\u062f\u0648\u062f.<\/p>\n","rendered":"<aside id=\"arcadia-visa-info-only\" dir=\"rtl\" style=\"margin:18px 0;padding:16px 18px;border-right:4px solid #d6a936;background:#fff8e7;border-radius:10px;line-height:1.9;color:#26384a\"><strong>\u062a\u0646\u0628\u064a\u0647 \u0645\u0647\u0645:<\/strong> \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u0644\u0644\u062a\u0648\u0639\u064a\u0629 \u0628\u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0641\u0642\u0637. \u0634\u0631\u0643\u0629 \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0644\u0627 \u062a\u0642\u062f\u0645 \u062e\u062f\u0645\u0629 \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0623\u0648 \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a. \u062e\u062f\u0645\u0627\u062a\u0646\u0627 \u062a\u0634\u0645\u0644 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0648\u0627\u0644\u062a\u0646\u0642\u0644\u0627\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u0648\u062c\u0647\u0629. <a href=\"https:\/\/arcadia-tour.com\/offers-bookings\/\">\u0627\u0633\u062a\u0639\u0631\u0636 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629<\/a>.<\/aside>\n<p id=\"arcadia-visa-official-sources\" dir=\"rtl\" style=\"margin:14px 0;line-height:1.9\"><strong>\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u0635\u062f\u0631 \u0627\u0644\u0631\u0633\u0645\u064a \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631:<\/strong> <a href=\"https:\/\/www.gov.kz\/memleket\/entities\/mfa\/activities\/34747?lang=en&amp;parentId=3053\" target=\"_blank\" rel=\"noopener noreferrer\">\u062c\u062f\u0648\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629<\/a>\u060c <a href=\"https:\/\/vmp.gov.kz\/en\/\" target=\"_blank\" rel=\"noopener noreferrer\">\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629<\/a>.<\/p>\n<p dir=\"rtl\" style=\"line-height:1.32;text-align: right;margin-top:15pt;margin-bottom:16pt\"><span style=\"font-size:13pt;font-family:Tajawal,sans-serif;color:#414141;background-color:#ffffff\">\u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u062e\u0637\u0637 \u0644\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 <a href=\"https:\/\/arcadia-tour.com\/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d9%83%d8%a7%d8%b2%d8%a7%d8%ae%d8%b3%d8%aa%d8%a7%d9%86\/\">\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/a> \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u062a\u0639\u0631\u0641 \u0639\u0644\u0649 <u><a href=\"https:\/\/arcadia-tour.com\/offers-bookings\/\">\u0639\u0631\u0648\u0636 \u0634\u0631\u0643\u0629 \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0644\u0644\u0633\u0641\u0631 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/a><\/u><\/span><\/p>\n<p class=\"arc-related-link\">\u062a\u062e\u0637\u0651\u0637 \u0644\u0631\u062d\u0644\u062a\u0643\u061f \u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0643\u0644 \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0641\u064a \u062f\u0644\u064a\u0644 <a href=\"https:\/\/arcadia-tour.com\/%D8%A7%D9%84%D8%B3%D9%8A%D8%A7%D8%AD%D8%A9-%D9%81%D9%8A-%D9%83%D8%A7%D8%B2%D8%A7%D8%AE%D8%B3%D8%AA%D8%A7%D9%86\/\">\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646<\/a> \u0627\u0644\u0634\u0627\u0645\u0644 \u0645\u0639 \u0623\u0631\u0643\u0627\u062f\u064a\u0627.<\/p>\n<h2>\u0645\u0646 \u064a\u062f\u062e\u0644 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0628\u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629\u061f<\/h2>\n<p>\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0645\u0646 \u0623\u0633\u0647\u0644 \u062f\u0648\u0644 \u0622\u0633\u064a\u0627 \u062f\u062e\u0648\u0644\u0627\u064b \u0644\u0644\u0645\u0633\u0627\u0641\u0631 \u0627\u0644\u062e\u0644\u064a\u062c\u064a. \u0628\u062d\u0633\u0628 \u062c\u062f\u0648\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a \u0644\u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629:<\/p>\n<table>\n<thead>\n<tr>\n<th>\u0627\u0644\u062c\u0646\u0633\u064a\u0629<\/th>\n<th>\u0627\u0644\u0648\u0636\u0639<\/th>\n<th>\u0645\u062f\u0629 \u0627\u0644\u0625\u0642\u0627\u0645\u0629<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629\u060c \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u060c \u0642\u0637\u0631\u060c \u0627\u0644\u0643\u0648\u064a\u062a\u060c \u0627\u0644\u0628\u062d\u0631\u064a\u0646\u060c \u0639\u064f\u0645\u0627\u0646<\/td>\n<td>\u0628\u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629<\/td>\n<td>\u062d\u062a\u0649 30 \u064a\u0648\u0645\u0627\u064b \u0641\u064a \u0643\u0644 \u0632\u064a\u0627\u0631\u0629 (\u0628\u062d\u062f \u0623\u0642\u0635\u0649 90 \u064a\u0648\u0645\u0627\u064b \u062e\u0644\u0627\u0644 180 \u064a\u0648\u0645\u0627\u064b)<\/td>\n<\/tr>\n<tr>\n<td>\u0627\u0644\u0623\u0631\u062f\u0646<\/td>\n<td>\u0628\u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 (\u0625\u0639\u0641\u0627\u0621 \u0623\u062d\u0627\u062f\u064a)<\/td>\n<td>\u062d\u062a\u0649 30 \u064a\u0648\u0645\u0627\u064b<\/td>\n<\/tr>\n<tr>\n<td>\u0645\u0635\u0631\u060c \u0627\u0644\u062c\u0632\u0627\u0626\u0631\u060c \u0627\u0644\u0645\u063a\u0631\u0628\u060c \u062a\u0648\u0646\u0633\u060c \u0627\u0644\u0639\u0631\u0627\u0642\u060c \u0644\u0628\u0646\u0627\u0646\u060c \u0633\u0648\u0631\u064a\u0627\u060c \u0627\u0644\u064a\u0645\u0646\u060c \u0644\u064a\u0628\u064a\u0627\u060c \u0627\u0644\u0633\u0648\u062f\u0627\u0646<\/td>\n<td>\u062a\u0623\u0634\u064a\u0631\u0629 \u0645\u0637\u0644\u0648\u0628\u0629<\/td>\n<td>\u0628\u062d\u0633\u0628 \u0646\u0648\u0639 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>\u0642\u0648\u0627\u0626\u0645 \u0627\u0644\u0625\u0639\u0641\u0627\u0621 \u062a\u062a\u063a\u064a\u0631 \u0645\u0646 \u0633\u0646\u0629 \u0644\u0623\u062e\u0631\u0649\u061b \u062a\u062d\u0642\u0642\u0648\u0627 \u0645\u0646 \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0631\u0633\u0645\u064a \u0642\u0628\u0644 \u0627\u0644\u062d\u062c\u0632. \u0627\u0644\u062c\u0648\u0627\u0632 \u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0635\u0627\u0644\u062d\u0627\u064b \u0644\u0645\u062f\u0629 \u0644\u0627 \u062a\u0642\u0644 \u0639\u0646 3 \u0623\u0634\u0647\u0631 \u0628\u0639\u062f \u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0645\u063a\u0627\u062f\u0631\u0629\u060c \u0648\u064a\u064f\u0646\u0635\u062d \u0628\u06406 \u0623\u0634\u0647\u0631.<\/p>\n<h2>\u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0644\u0645\u0646 \u064a\u062d\u062a\u0627\u062c\u0647\u0627<\/h2>\n<p>\u062a\u0642\u062f\u0645 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0633\u064a\u0627\u062d\u064a\u0629 \u0644\u0639\u062f\u062f \u0645\u0646 \u0627\u0644\u062c\u0646\u0633\u064a\u0627\u062a \u0639\u0628\u0631 <strong>\u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629<\/strong>\u060c \u0648\u062a\u062a\u0637\u0644\u0628 \u0641\u064a \u0627\u0644\u0639\u0627\u062f\u0629: \u0635\u0648\u0631\u0629 \u0627\u0644\u062c\u0648\u0627\u0632\u060c \u0635\u0648\u0631\u0629 \u0634\u062e\u0635\u064a\u0629\u060c \u062d\u062c\u0632 \u0641\u0646\u062f\u0642\u060c \u0648\u062a\u0630\u0643\u0631\u0629 \u0630\u0647\u0627\u0628 \u0648\u0639\u0648\u062f\u0629\u060c \u0648\u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u062d\u0627\u0644\u0627\u062a \u062e\u0637\u0627\u0628 \u062f\u0639\u0648\u0629 \u0645\u0646 \u062c\u0647\u0629 \u0645\u0633\u062a\u0636\u064a\u0641\u0629 \u0645\u0633\u062c\u0644\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646. \u0627\u0644\u0645\u062f\u0629 \u0627\u0644\u0645\u0639\u062a\u0627\u062f\u0629 \u0644\u0644\u0645\u0639\u0627\u0644\u062c\u0629 5\u201310 \u0623\u064a\u0627\u0645 \u0639\u0645\u0644. \u0644\u0645\u0646 \u0644\u0627 \u062a\u062a\u0648\u0641\u0631 \u0644\u0647 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\u060c \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0639\u0628\u0631 \u0633\u0641\u0627\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0641\u064a \u0628\u0644\u062f\u0647. \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0644\u0627 \u062a\u0635\u062f\u0631 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0644\u0627 \u062e\u0637\u0627\u0628\u0627\u062a \u0627\u0644\u062f\u0639\u0648\u0629\u060c \u0644\u0643\u0646\u0646\u0627 \u0646\u0632\u0648\u062f \u0639\u0645\u0644\u0627\u0621\u0646\u0627 \u0628\u062d\u062c\u0648\u0632\u0627\u062a \u0627\u0644\u0641\u0646\u0627\u062f\u0642 \u0627\u0644\u0645\u0624\u0643\u062f\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u0629 \u0644\u0644\u0637\u0644\u0628.<\/p>\n<h2>\u0645\u0627\u0630\u0627 \u064a\u062d\u062f\u062b \u0639\u0646\u062f \u0627\u0644\u0648\u0635\u0648\u0644\u061f<\/h2>\n<ul>\n<li><strong>\u0627\u0644\u062c\u0648\u0627\u0632\u0627\u062a:<\/strong> \u062e\u062a\u0645 \u062f\u062e\u0648\u0644 \u0641\u064a \u0645\u0637\u0627\u0631 <a href=\"https:\/\/arcadia-tour.com\/almaty-guide\/\">\u0623\u0644\u0645\u0627\u062a\u064a<\/a> \u0623\u0648 <a href=\"https:\/\/arcadia-tour.com\/astana-family-guide-2026\/\">\u0623\u0633\u062a\u0627\u0646\u0627<\/a> \u062f\u0648\u0646 \u0646\u0645\u0627\u0630\u062c \u0648\u0631\u0642\u064a\u0629\u060c \u0648\u064a\u064f\u0637\u0644\u0628 \u0623\u062d\u064a\u0627\u0646\u0627\u064b \u062d\u062c\u0632 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u062a\u0630\u0643\u0631\u0629 \u0627\u0644\u0639\u0648\u062f\u0629.<\/li>\n<li><strong>\u0627\u0644\u062a\u0633\u062c\u064a\u0644:<\/strong> \u0627\u0644\u0641\u0646\u062f\u0642 \u064a\u0628\u0644\u063a \u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0647\u062c\u0631\u0629 \u0628\u0648\u0635\u0648\u0644\u0643\u0645 \u062a\u0644\u0642\u0627\u0626\u064a\u0627\u064b \u062e\u0644\u0627\u0644 3 \u0623\u064a\u0627\u0645 \u0639\u0645\u0644\u060c \u0648\u0644\u0627 \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0633\u0627\u0626\u062d \u0644\u0623\u064a \u0625\u062c\u0631\u0627\u0621 \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0627\u0644\u0625\u0642\u0627\u0645\u0629 \u0623\u0642\u0644 \u0645\u0646 30 \u064a\u0648\u0645\u0627\u064b.<\/li>\n<li><strong>\u0627\u0644\u0623\u0637\u0641\u0627\u0644:<\/strong> \u064a\u062f\u062e\u0644\u0648\u0646 \u0628\u062c\u0648\u0627\u0632\u0627\u062a\u0647\u0645 \u0645\u0639 \u0646\u0641\u0633 \u0634\u0631\u0648\u0637 \u0627\u0644\u0643\u0628\u0627\u0631\u060c \u0648\u0644\u0627 \u064a\u064f\u0637\u0644\u0628 \u0645\u0648\u0627\u0641\u0642\u0629 \u0625\u0636\u0627\u0641\u064a\u0629 \u0639\u0646\u062f \u0627\u0644\u0633\u0641\u0631 \u0645\u0639 \u0623\u062d\u062f \u0627\u0644\u0648\u0627\u0644\u062f\u064a\u0646 \u0639\u0627\u062f\u0629\u064b.<\/li>\n<li><strong>\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0635\u062d\u064a:<\/strong> \u063a\u064a\u0631 \u0625\u0644\u0632\u0627\u0645\u064a \u0644\u0644\u062f\u062e\u0648\u0644\u060c \u0644\u0643\u0646\u0647 \u0645\u0648\u0635\u0649 \u0628\u0647 \u0628\u0634\u062f\u0629 \u0648\u0645\u0634\u0645\u0648\u0644 \u0641\u064a \u0628\u0631\u0627\u0645\u062c \u0623\u0631\u0643\u0627\u062f\u064a\u0627.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0648\u0627\u0644\u0639\u0628\u0648\u0631 \u0625\u0644\u0649 \u0623\u0648\u0632\u0628\u0643\u0633\u062a\u0627\u0646<\/h2>\n<p>\u0643\u062b\u064a\u0631 \u0645\u0646 \u0627\u0644\u0639\u0627\u0626\u0644\u0627\u062a \u062a\u062c\u0645\u0639 \u0628\u064a\u0646 \u0627\u0644\u0628\u0644\u062f\u064a\u0646. \u0627\u0644\u062e\u0631\u0648\u062c \u0645\u0646 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0648\u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 <a href=\"https:\/\/arcadia-tour.com\/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d8%a3%d9%88%d8%b2%d8%a8%d9%83%d8%b3%d8%aa%d8%a7%d9%86\/\">\u0623\u0648\u0632\u0628\u0643\u0633\u062a\u0627\u0646<\/a> \u0628\u0637\u064a\u0631\u0627\u0646 \u0645\u0628\u0627\u0634\u0631 \u0645\u0646 \u0623\u0644\u0645\u0627\u062a\u064a \u0625\u0644\u0649 <a href=\"https:\/\/arcadia-tour.com\/tashkent-2-days-itinerary\/\">\u0637\u0634\u0642\u0646\u062f<\/a> (\u0633\u0627\u0639\u0629 \u0648\u0646\u0635\u0641)\u060c \u0648\u0645\u0648\u0627\u0637\u0646\u0648 \u0627\u0644\u062e\u0644\u064a\u062c \u0645\u0639\u0641\u0648\u0646 \u0645\u0646 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0641\u064a \u0627\u0644\u0628\u0644\u062f\u064a\u0646. \u0648\u0627\u0644\u0639\u0648\u062f\u0629 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0628\u0639\u062f \u0632\u064a\u0627\u0631\u0629 \u0623\u0648\u0632\u0628\u0643\u0633\u062a\u0627\u0646 \u062a\u064f\u062d\u0633\u0628 \u0632\u064a\u0627\u0631\u0629 \u062c\u062f\u064a\u062f\u0629 \u0636\u0645\u0646 \u062d\u062f 90 \u064a\u0648\u0645\u0627\u064b \u0641\u064a 180 \u064a\u0648\u0645\u0627\u064b. \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-uzbekistan-10-days-trip\/\">\u0631\u062d\u0644\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0648\u0623\u0648\u0632\u0628\u0643\u0633\u062a\u0627\u0646 10 \u0623\u064a\u0627\u0645<\/a>.<\/p>\n<h2>\u0646\u0635\u0627\u0626\u062d \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631<\/h2>\n<ul>\n<li>\u0627\u062d\u0645\u0644\u0648\u0627 \u0646\u0633\u062e\u0629 \u0645\u0646 \u062d\u062c\u0632 \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u062a\u0630\u0643\u0631\u0629 \u0627\u0644\u0639\u0648\u062f\u0629 \u0639\u0644\u0649 \u0627\u0644\u0647\u0627\u062a\u0641.<\/li>\n<li>\u0644\u0627 \u064a\u064f\u0637\u0644\u0628 \u0625\u062b\u0628\u0627\u062a \u0645\u0627\u0644\u064a \u0639\u0627\u062f\u0629\u064b\u060c \u0644\u0643\u0646 \u0628\u0637\u0627\u0642\u0629 \u0628\u0646\u0643\u064a\u0629 \u0648\u0646\u0642\u062f\u0627\u064b \u0643\u0627\u0641\u064a\u0627\u064b \u0623\u0645\u0631 \u0645\u0639\u062a\u0627\u062f.<\/li>\n<li>\u0627\u0644\u062f\u062e\u0648\u0644 \u0628\u0627\u0644\u0647\u0648\u064a\u0629 \u0627\u0644\u0648\u0637\u0646\u064a\u0629 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u061b \u0627\u0644\u062c\u0648\u0627\u0632 \u0625\u0644\u0632\u0627\u0645\u064a.<\/li>\n<li>\u0644\u0644\u0645\u0633\u0627\u0641\u0631 \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u062a\u062d\u062f\u064a\u062f\u0627\u064b \u0631\u0627\u062c\u0639\u0648\u0627 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-for-saudis-2026\/\">\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0644\u0633\u0639\u0648\u062f\u064a\u064a\u0646<\/a>\u060c \u0648\u0644\u0644\u062a\u0643\u0644\u0641\u0629 <a href=\"https:\/\/arcadia-tour.com\/kazakhstan-family-trip-cost-2026\/\">\u062a\u0643\u0644\u0641\u0629 \u0631\u062d\u0644\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0644\u0639\u0627\u0626\u0644\u0627\u062a<\/a>.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629 \u0639\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0644\u0644\u0639\u0631\u0628<\/h2>\n<h3>\u0647\u0644 \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0645\u0635\u0631\u064a\u0648\u0646 \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629 \u0644\u062f\u062e\u0648\u0644 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h3>\n<p>\u0628\u062d\u0633\u0628 \u062c\u062f\u0648\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u060c \u064a\u062d\u062a\u0627\u062c \u062d\u0627\u0645\u0644 \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631 \u0627\u0644\u0645\u0635\u0631\u064a \u0627\u0644\u0639\u0627\u062f\u064a \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631. \u062a\u062e\u062a\u0644\u0641 \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062a\u0642\u062f\u064a\u0645 \u0648\u0627\u0644\u0623\u0647\u0644\u064a\u0629 \u0644\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629\u060c \u0644\u0630\u0644\u0643 \u064a\u062c\u0628 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0648\u0632\u0627\u0631\u0629 \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629 \u0623\u0648 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629. \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u0644\u0627 \u062a\u0633\u062a\u062e\u0631\u062c \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0644\u0627 \u062a\u0635\u062f\u0631 \u062e\u0637\u0627\u0628\u0627\u062a \u0627\u0644\u062f\u0639\u0648\u0629.<\/p>\n<h3>\u0647\u0644 \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u062c\u0632\u0627\u0626\u0631\u064a\u0648\u0646 \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629 \u0644\u062f\u062e\u0648\u0644 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h3>\n<p>\u0628\u062d\u0633\u0628 \u062c\u062f\u0648\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0627\u0644\u0631\u0633\u0645\u064a\u060c \u064a\u062d\u062a\u0627\u062c \u062d\u0627\u0645\u0644 \u062c\u0648\u0627\u0632 \u0627\u0644\u0633\u0641\u0631 \u0627\u0644\u062c\u0632\u0627\u0626\u0631\u064a \u0627\u0644\u0639\u0627\u062f\u064a \u0625\u0644\u0649 \u062a\u0623\u0634\u064a\u0631\u0629 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631. \u0631\u0627\u062c\u0639 \u0627\u0644\u0633\u0641\u0627\u0631\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629 \u0623\u0648 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0644\u0645\u0639\u0631\u0641\u0629 \u0627\u0644\u0642\u0646\u0627\u0629 \u0627\u0644\u0645\u062a\u0627\u062d\u0629 \u0644\u062d\u0627\u0644\u062a\u0643. \u0623\u0631\u0643\u0627\u062f\u064a\u0627 \u062a\u0642\u062f\u0645 \u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0633\u064a\u0627\u062d\u064a\u0629 \u0648\u0627\u0644\u062d\u062c\u0648\u0632\u0627\u062a \u0641\u0642\u0637 \u0648\u0644\u0627 \u062a\u0642\u062f\u0645 \u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a.<\/p>\n<h3>\u0647\u0644 \u0645\u0648\u0627\u0637\u0646\u0648 \u062f\u0648\u0644 \u0627\u0644\u062e\u0644\u064a\u062c \u0645\u0639\u0641\u0648\u0646 \u0645\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h3>\n<p>\u0646\u0639\u0645\u060c \u064a\u0645\u0643\u0646 \u0644\u0645\u0648\u0627\u0637\u0646\u064a \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0628\u062d\u0631\u064a\u0646 \u0648\u0627\u0644\u0643\u0648\u064a\u062a \u0648\u0639\u064f\u0645\u0627\u0646 \u0648\u0642\u0637\u0631 \u0648\u0627\u0644\u0633\u0639\u0648\u062f\u064a\u0629 \u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 \u0628\u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0644\u0645\u062f\u0629 \u062a\u0635\u0644 \u0625\u0644\u0649 30 \u064a\u0648\u0645\u064b\u0627 \u0648\u0641\u0642 \u0627\u0644\u062c\u062f\u0648\u0644 \u0627\u0644\u0631\u0633\u0645\u064a\u060c \u0645\u0639 \u0636\u0631\u0648\u0631\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0634\u0631\u0648\u0637 \u0642\u0628\u0644 \u0627\u0644\u0633\u0641\u0631.<\/p>\n<h3>\u0643\u0645 \u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629 \u0648\u0643\u0645 \u062a\u0633\u062a\u063a\u0631\u0642\u061f<\/h3>\n<p>\u062a\u062e\u062a\u0644\u0641 \u0627\u0644\u0631\u0633\u0648\u0645 \u0648\u0645\u062f\u0629 \u0627\u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0628\u062d\u0633\u0628 \u0646\u0648\u0639 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0648\u0627\u0644\u062c\u0646\u0633\u064a\u0629 \u0648\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628\u060c \u0648\u0642\u062f \u062a\u062a\u063a\u064a\u0631. \u0631\u0627\u062c\u0639 \u0628\u0648\u0627\u0628\u0629 \u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0627\u062a \u0648\u0627\u0644\u0647\u062c\u0631\u0629 \u0627\u0644\u0631\u0633\u0645\u064a\u0629 \u0623\u0648 \u0627\u0644\u0628\u0639\u062b\u0629 \u0627\u0644\u062f\u0628\u0644\u0648\u0645\u0627\u0633\u064a\u0629 \u0627\u0644\u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u064a\u0629 \u0627\u0644\u0645\u062e\u062a\u0635\u0629 \u0642\u0628\u0644 \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0637\u0644\u0628.<\/p>\n<h3>\u0647\u0644 \u0623\u062d\u062a\u0627\u062c \u0644\u0644\u062a\u0633\u062c\u064a\u0644 \u0644\u062f\u0649 \u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0647\u062c\u0631\u0629 \u0628\u0639\u062f \u0648\u0635\u0648\u0644\u064a \u0625\u0644\u0649 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646\u061f<\/h3>\n<p>\u0644\u0627 \u062d\u0627\u062c\u0629 \u0644\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0634\u062e\u0635\u064a \u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0625\u0642\u0627\u0645\u062a\u0643 \u0623\u0642\u0644 \u0645\u0646 30 \u064a\u0648\u0645\u064b\u0627\u060c \u0644\u0643\u0646 \u0627\u0644\u062c\u0647\u0629 \u0627\u0644\u0645\u0633\u062a\u0636\u064a\u0641\u0629 (\u0627\u0644\u0641\u0646\u062f\u0642 \u0623\u0648 \u0627\u0644\u0645\u064f\u0636\u064a\u0641) \u0645\u0644\u0632\u0645\u0629 \u0628\u0625\u062e\u0637\u0627\u0631 \u062f\u0627\u0626\u0631\u0629 \u0627\u0644\u0647\u062c\u0631\u0629 \u0628\u0648\u0635\u0648\u0644\u0643 \u062e\u0644\u0627\u0644 3 \u0623\u064a\u0627\u0645 \u0639\u0645\u0644 \u0645\u0646 \u0639\u0628\u0648\u0631 \u0627\u0644\u062d\u062f\u0648\u062f.<\/p>\n","protected":false,"block_version":0},"meta":{"_yoast_wpseo_focuskw":"\u062a\u0623\u0634\u064a\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646","_yoast_wpseo_title":"\u062a\u0623\u0634\u064a\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646 2026: \u0645\u0646 \u064a\u062f\u062e\u0644 \u0628\u062f\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629\u061f | \u0623\u0631\u0643\u0627\u062f\u064a\u0627","_yoast_wpseo_metadesc":"\u062f\u0644\u064a\u0644 \u062a\u0623\u0634\u064a\u0631\u0629 \u0643\u0627\u0632\u0627\u062e\u0633\u062a\u0627\u0646: \u0627\u0644\u0625\u0639\u0641\u0627\u0621 \u0644\u0645\u0648\u0627\u0637\u0646\u064a \u0627\u0644\u062e\u0644\u064a\u062c 30 \u064a\u0648\u0645\u0627\u064b\u060c \u0627\u0644\u062c\u0646\u0633\u064a\u0