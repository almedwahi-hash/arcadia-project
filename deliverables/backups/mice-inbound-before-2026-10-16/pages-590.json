629 \u0648\u0627\u0644\u0623\u0635\u062f\u0642\u0627\u0621 \u0648\u0627\u0644\u0634\u0631\u0643\u0627\u062a \u0648\u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u0630\u064a\u0646 \u064a\u0631\u064a\u062f\u0648\u0646 \u0623\u0648\u0631\u0648\u0628\u0627 \u0628\u0623\u0633\u0639\u0627\u0631 \u0645\u0639\u0642\u0648\u0644\u0629 \u0648\u0628\u062a\u0646\u0638\u064a\u0645 \u0643\u0627\u0645\u0644: \u062d\u0627\u0641\u0644\u0629 \u0648\u0627\u062d\u062f\u0629 \u0648\u0645\u0631\u0634\u062f \u0639\u0631\u0628\u064a\u060c \u0641\u0646\u0627\u062f\u0642 \u0628\u0623\u0633\u0639\u0627\u0631 \u0627\u0644\u0639\u0642\u0648\u062f \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/warsaw-poland-tourism\/\">\u0648\u0627\u0631\u0633\u0648<\/a> \u0648\u0643\u0631\u0627\u0643\u0648\u0641 \u0648\u0632\u0627\u0643\u0648\u0628\u0627\u0646\u064a\u060c \u0648\u062a\u0630\u0627\u0643\u0631 \u0627\u0644\u0645\u0639\u0627\u0644\u0645 \u0645\u062d\u062c\u0648\u0632\u0629 \u0645\u0633\u0628\u0642\u0627\u064b\u060c \u0645\u0639 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0641\u064a \u0645\u0644\u0641 \u062a\u0623\u0634\u064a\u0631\u0629 \u0634\u0646\u063a\u0646 \u0644\u0643\u0644 \u0623\u0641\u0631\u0627\u062f \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629. \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629 \u062a\u0634\u0631\u062d \u0645\u0627 \u0646\u0642\u062f\u0645\u0647\u060c \u0648\u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0648\u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u0623\u0643\u062b\u0631 \u0637\u0644\u0628\u0627\u064b\u060c \u0648\u0633\u0639\u0631 \u0627\u0644\u0641\u0631\u062f \u0628\u062d\u0633\u0628 \u062d\u062c\u0645 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629\u060c \u0648\u0645\u0627 \u0646\u062d\u062a\u0627\u062c\u0647 \u0645\u0646\u0643\u0645.<\/p>\n<h2>\u0645\u0627\u0630\u0627 \u064a\u0634\u0645\u0644 \u062a\u0646\u0638\u064a\u0645 \u0627\u0644\u0631\u062d\u0644\u0629 \u0627\u0644\u062c\u0645\u0627\u0639\u064a\u0629 \u0625\u0644\u0649 \u0628\u0648\u0644\u0646\u062f\u0627\u061f<\/h2>\n<ul>\n<li><strong>\u0627\u0644\u062a\u062e\u0637\u064a\u0637:<\/strong> \u062a\u062d\u062f\u064a\u062f \u0647\u062f\u0641 \u0627\u0644\u0631\u062d\u0644\u0629 (\u062b\u0642\u0627\u0641\u0629\u060c \u0637\u0628\u064a\u0639\u0629\u060c \u062a\u0632\u0644\u062c) \u0648\u0627\u0644\u0645\u0648\u0633\u0645 \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0648\u0627\u0644\u0645\u064a\u0632\u0627\u0646\u064a\u0629.<\/li>\n<li><strong>\u0627\u0644\u0625\u0642\u0627\u0645\u0629:<\/strong> \u0641\u0646\u0627\u062f\u0642 \u0623\u0648 \u0634\u0642\u0642 \u0643\u0628\u064a\u0631\u0629 \u0644\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0628\u063a\u0631\u0641 \u0645\u062a\u062c\u0627\u0648\u0631\u0629 \u0648\u0625\u0641\u0637\u0627\u0631 \u0628\u0623\u0635\u0646\u0627\u0641 \u0648\u0627\u0636\u062d\u0629 \u0627\u0644\u062d\u0644\u0627\u0644.<\/li>\n<li><strong>\u0627\u0644\u0646\u0642\u0644:<\/strong> \u062d\u0627\u0641\u0644\u0629 \u0645\u0643\u064a\u0641\u0629 \u062d\u062f\u064a\u062b\u0629 \u0644\u0644\u0645\u062c\u0645\u0648\u0639\u0629 \u0628\u064a\u0646 \u0627\u0644\u0645\u062f\u0646 \u0648\u0627\u0644\u0645\u0639\u0627\u0644\u0645\u060c \u0648\u062a\u0630\u0627\u0643\u0631 \u062c\u0645\u0627\u0639\u064a\u0629 \u0644\u0644\u0642\u0637\u0627\u0631 \u0628\u064a\u0646 \u0648\u0627\u0631\u0633\u0648 \u0648\u0643\u0631\u0627\u0643\u0648\u0641.<\/li>\n<li><strong>\u0627\u0644\u0645\u0631\u0634\u062f:<\/strong> \u0645\u0631\u0634\u062f \u0639\u0631\u0628\u064a \u0644\u0643\u0644 \u062d\u0627\u0641\u0644\u0629\u060c \u0648\u0645\u0646\u0633\u0642 \u0639\u0644\u0649 \u0648\u0627\u062a\u0633\u0627\u0628.<\/li>\n<li><strong>\u0627\u0644\u0623\u0646\u0634\u0637\u0629:<\/strong> \u062c\u0648\u0644\u0627\u062a \u0627\u0644\u0645\u062f\u0646 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\u060c \u0623\u0648\u0634\u0641\u064a\u062a\u0632\u060c \u0645\u0646\u062c\u0645 \u0627\u0644\u0645\u0644\u062d \u0641\u064a\u0644\u064a\u062a\u0634\u0643\u0627\u060c <a href=\"https:\/\/arcadia-tour.com\/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d8%b2%d8%a7%d9%83%d9%88%d8%a8%d8%a7%d9%86%d9%8a-%d8%af%d9%84%d9%8a%d9%84-%d8%b4%d8%a7%d9%85%d9%84-%d9%84%d9%84%d8%b1%d8%ad%d9%84%d8%a9-%d9%85\/\">\u0632\u0627\u0643\u0648\u0628\u0627\u0646\u064a<\/a> \u0648\u0627\u0644\u062a\u0644\u0641\u0631\u064a\u0643\u0627\u062a\u060c \u0642\u0648\u0627\u0631\u0628 \u0628\u062d\u064a\u0631\u0627\u062a \u0645\u0627\u0633\u0648\u0631\u064a\u0627\u060c \u0623\u0633\u0648\u0627\u0642 \u0627\u0644\u0643\u0631\u064a\u0633\u0645\u0627\u0633.<\/li>\n<li><strong>\u0627\u0644\u0637\u0639\u0627\u0645:<\/strong> \u0645\u0637\u0627\u0639\u0645 \u062d\u0644\u0627\u0644 \u062a\u0631\u0643\u064a\u0629 \u0648\u0639\u0631\u0628\u064a\u0629 \u0648\u0647\u0646\u062f\u064a\u0629 \u0641\u064a \u0643\u0644 \u0645\u062f\u064a\u0646\u0629\u060c \u0643\u0645\u0627 \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/krakow-halal-restaurants-guide\/\">\u0645\u0637\u0627\u0639\u0645 \u0643\u0631\u0627\u0643\u0648\u0641 \u0627\u0644\u062d\u0644\u0627\u0644<\/a> \u0648<a href=\"https:\/\/arcadia-tour.com\/warsaw-halal-restaurants-arabs\/\">\u0645\u0637\u0627\u0639\u0645 \u0648\u0627\u0631\u0633\u0648 \u0627\u0644\u062d\u0644\u0627\u0644<\/a>.<\/li>\n<li><strong>\u0627\u0644\u062a\u0623\u0634\u064a\u0631\u0629 \u0648\u0627\u0644\u062a\u0623\u0645\u064a\u0646:<\/strong> \u062a\u0623\u0643\u064a\u062f\u0627\u062a \u0627\u0644\u0641\u0646\u0627\u062f\u0642 \u0648\u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0644\u0645\u0644\u0641 \u0634\u0646\u063a\u0646 \u0644\u0643\u0644 \u0641\u0631\u062f\u060c \u0648\u062a\u0623\u0645\u064a\u0646 \u0633\u0641\u0631 \u064a\u063a\u0637\u064a \u0627\u0644\u0631\u062d\u0644\u0629.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u0648\u062c\u0647\u0627\u062a \u0627\u0644\u062a\u064a \u0646\u063a\u0637\u064a\u0647\u0627 \u0644\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a<\/h2>\n<ul>\n<li><strong><a href=\"https:\/\/arcadia-tour.com\/%d8%a7%d9%84%d8%b3%d9%8a%d8%a7%d8%ad%d8%a9-%d9%81%d9%8a-%d9%83%d8%b1%d8%a7%d9%83%d9%88%d9%81-%d8%b1%d8%ad%d9%84%d8%a9-%d8%a8%d9%8a%d9%86-%d8%a7%d9%84%d8%b7%d8%a8%d9%8a%d8%b9%d8%a9-%d9%88%d8%a7%d9%84\/\">\u0643\u0631\u0627\u0643\u0648\u0641<\/a>:<\/strong> \u0627\u0644\u062a\u0627\u0631\u064a\u062e \u0648\u0627\u0644\u062b\u0642\u0627\u0641\u0629\u060c \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0648\u0642\u0644\u0639\u0629 \u0641\u0627\u0641\u0644\u060c \u0623\u0648\u0634\u0641\u064a\u062a\u0632 \u0648\u0645\u0646\u062c\u0645 \u0627\u0644\u0645\u0644\u062d.<\/li>\n<li><strong>\u0648\u0627\u0631\u0633\u0648:<\/strong> \u0627\u0644\u0639\u0627\u0635\u0645\u0629 \u0627\u0644\u062d\u062f\u064a\u062b\u0629\u060c \u0627\u0644\u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0642\u062f\u064a\u0645\u0629\u060c \u0642\u0635\u0631 \u0627\u0644\u062b\u0642\u0627\u0641\u0629\u060c \u0645\u062a\u062d\u0641 \u0627\u0644\u0627\u0646\u062a\u0641\u0627\u0636\u0629.<\/li>\n<li><strong>\u0632\u0627\u0643\u0648\u0628\u0627\u0646\u064a \u0648\u062c\u0628\u0627\u0644 \u062a\u0627\u062a\u0631\u0627:<\/strong> \u0627\u0644\u062a\u0644\u0641\u0631\u064a\u0643\u0627\u062a \u0648\u0627\u0644\u0645\u0634\u064a \u0635\u064a\u0641\u0627\u064b \u0648\u0627\u0644\u062a\u0632\u0644\u062c \u0634\u062a\u0627\u0621\u064b.<\/li>\n<li><strong>\u0641\u0631\u0648\u062a\u0633\u0648\u0627\u0641:<\/strong> \u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u062c\u0633\u0648\u0631 \u0648\u0627\u0644\u062c\u0632\u0631 \u0648\u0627\u0644\u0623\u0642\u0632\u0627\u0645.<\/li>\n<li><strong><a href=\"https:\/\/arcadia-tour.com\/gdansk-poland-tourism\/\">\u063a\u062f\u0627\u0646\u0633\u0643<\/a>:<\/strong> \u0627\u0644\u0633\u0627\u062d\u0644 \u0648\u0627\u0644\u0628\u0644\u0637\u064a\u0642 \u0648\u0645\u0646\u062a\u062c\u0639 \u0633\u0648\u0628\u0648\u062a.<\/li>\n<li><strong>\u0628\u062d\u064a\u0631\u0627\u062a \u0645\u0627\u0633\u0648\u0631\u064a\u0627:<\/strong> \u0627\u0644\u0642\u0648\u0627\u0631\u0628 \u0648\u0627\u0644\u0637\u0628\u064a\u0639\u0629 \u0648\u0627\u0644\u0647\u062f\u0648\u0621.<\/li>\n<\/ul>\n<h2>\u0627\u0644\u0628\u0631\u0627\u0645\u062c \u0627\u0644\u062c\u0645\u0627\u0639\u064a\u0629 \u0627\u0644\u0623\u0643\u062b\u0631 \u0637\u0644\u0628\u0627\u064b<\/h2>\n<h3>\u0643\u0631\u0627\u0643\u0648\u0641 \u0648\u0632\u0627\u0643\u0648\u0628\u0627\u0646\u064a 5 \u0623\u064a\u0627\u0645<\/h3>\n<p>3 \u0644\u064a\u0627\u0644\u064d \u0641\u064a \u0643\u0631\u0627\u0643\u0648\u0641 \u0648\u0644\u064a\u0644\u062a\u0627\u0646 \u0641\u064a \u0627\u0644\u062c\u0628\u0627\u0644\u060c \u0643\u0645\u0627 \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0643\u0631\u0627\u0643\u0648\u0641-\u0631\u062d\u0644\u0629-\u0628\u064a\u0646-\u0627\u0644\u0637\u0628\u064a\u0639\u0629-\u0648\u0627\u0644\/\">\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0643\u0631\u0627\u0643\u0648\u0641<\/a> \u0648<a href=\"https:\/\/arcadia-tour.com\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0632\u0627\u0643\u0648\u0628\u0627\u0646\u064a-\u062f\u0644\u064a\u0644-\u0634\u0627\u0645\u0644-\u0644\u0644\u0631\u062d\u0644\u0629-\u0645\/\">\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0632\u0627\u0643\u0648\u0628\u0627\u0646\u064a<\/a>.<\/p>\n<h3>\u0628\u0648\u0644\u0646\u062f\u0627 \u0627\u0644\u0643\u0644\u0627\u0633\u064a\u0643\u064a\u0629 7 \u0623\u064a\u0627\u0645<\/h3>\n<p>\u0648\u0627\u0631\u0633\u0648 \u0648\u0643\u0631\u0627\u0643\u0648\u0641 \u0648\u0632\u0627\u0643\u0648\u0628\u0627\u0646\u064a\u060c \u0643\u0645\u0627 \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/\u062f\u0644\u064a\u0644-\u0634\u0627\u0645\u0644-\u0644\u0632\u064a\u0627\u0631\u0629-\u0628\u0648\u0644\u0646\u062f\u0627-1\/\">\u0628\u0631\u0646\u0627\u0645\u062c \u0628\u0648\u0644\u0646\u062f\u0627 7 \u0623\u064a\u0627\u0645<\/a>.<\/p>\n<h3>\u0627\u0644\u0634\u062a\u0627\u0621: \u0627\u0644\u062a\u0632\u0644\u062c \u0648\u0623\u0633\u0648\u0627\u0642 \u0627\u0644\u0643\u0631\u064a\u0633\u0645\u0627\u0633<\/h3>\n<p>\u0643\u0645\u0627 \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0628\u0648\u0644\u0646\u062f\u0627\/\u0634\u062a\u0627\u0621-\u0643\u0631\u0627\u0643\u0648\u0641-\u0632\u0627\u0643\u0648\u0628\u0627\u0646\u064a\/\">\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0627\u0644\u0634\u062a\u0648\u064a\u0629 \u0641\u064a \u0628\u0648\u0644\u0646\u062f\u0627<\/a> \u0648<a href=\"https:\/\/arcadia-tour.com\/warsaw-christmas-markets\/\">\u0623\u0633\u0648\u0627\u0642 \u0627\u0644\u0643\u0631\u064a\u0633\u0645\u0627\u0633 \u0641\u064a \u0648\u0627\u0631\u0633\u0648<\/a>.<\/p>\n<h2>\u0643\u064a\u0641 \u064a\u064f\u062d\u0633\u0628 \u0633\u0639\u0631 \u0627\u0644\u0641\u0631\u062f \u0641\u064a \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629\u061f<\/h2>\n<p>\u062a\u0642\u062f\u064a\u0631\u0627\u062a \u0644\u0628\u0631\u0646\u0627\u0645\u062c 7 \u0623\u064a\u0627\u0645 \u0628\u0641\u0646\u0627\u062f\u0642 4 \u0646\u062c\u0648\u0645 \u0645\u0639 \u0627\u0644\u0625\u0641\u0637\u0627\u0631 \u0648\u0627\u0644\u062d\u0627\u0641\u0644\u0629 \u0648\u0627\u0644\u0645\u0631\u0634\u062f \u0648\u0627\u0644\u062a\u0630\u0627\u0643\u0631\u060c \u062f\u0648\u0646 \u0627\u0644\u0637\u064a\u0631\u0627\u0646 \u0627\u0644\u062f\u0648\u0644\u064a:<\/p>\n<table>\n<thead>\n<tr>\n<th>\u062d\u062c\u0645 \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629<\/th>\n<th>\u0633\u0639\u0631 \u0627\u0644\u0641\u0631\u062f \u0627\u0644\u062a\u0642\u0631\u064a\u0628\u064a<\/th>\n<\/tr>\n<\/thead>\n<tbody>\n<tr>\n<td>10\u201315 \u0634\u062e\u0635\u0627\u064b<\/td>\n<td>3,400\u20134,200 \u0631\u064a\u0627\u0644<\/td>\n<\/tr>\n<tr>\n<td>16\u201330 \u0634\u062e\u0635\u0627\u064b<\/td>\n<td>3,000\u20133,700 \u0631\u064a\u0627\u0644<\/td>\n<\/tr>\n<tr>\n<td>31\u201350 \u0634\u062e\u0635\u0627\u064b<\/td>\n<td>2,700\u20133,300 \u0631\u064a\u0627\u0644<\/td>\n<\/tr>\n<\/tbody>\n<\/table>\n<p>\u0627\u0644\u0623\u0639\u0644\u0649 \u0641\u064a \u064a\u0648\u0644\u064a\u0648 \u0648\u0623\u063a\u0633\u0637\u0633 \u0648\u062f\u064a\u0633\u0645\u0628\u0631\u060c \u0648\u0627\u0644\u0623\u0642\u0644 \u0641\u064a \u0645\u0627\u0631\u0633 \u0648\u0623\u0628\u0631\u064a\u0644 \u0648\u0646\u0648\u0641\u0645\u0628\u0631. \u0627\u0644\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/poland-family-trip-cost\/\">\u062a\u0643\u0644\u0641\u0629 \u0631\u062d\u0644\u0629 \u0628\u0648\u0644\u0646\u062f\u0627 \u0644\u0644\u0639\u0627\u0626\u0644\u0627\u062a<\/a>.<\/p>\n<h2>\u062a\u0623\u0634\u064a\u0631\u0629 \u0634\u0646\u063a\u0646 \u0644\u0644\u0645\u062c\u0645\u0648\u0639\u0627\u062a<\/h2>\n<p>\u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u064a\u0648\u0646 \u0645\u0639\u0641\u0648\u0646\u060c \u0648\u0628\u0642\u064a\u0629 \u0627\u0644\u062e\u0644\u064a\u062c\u064a\u064a\u0646 \u064a\u062d\u062a\u0627\u062c\u0648\u0646 \u062a\u0623\u0634\u064a\u0631\u0629 \u0634\u0646\u063a\u0646 \u062a\u064f\u0642\u062f\u064e\u0651\u0645 \u0639\u0628\u0631 \u0645\u0631\u0643\u0632 VFS \u0641\u064a \u0628\u0644\u062f\u0647\u0645 \u0642\u0628\u0644 6\u20138 \u0623\u0633\u0627\u0628\u064a\u0639. \u0646\u0632\u0648\u062f \u0643\u0644 \u0641\u0631\u062f \u0628\u062a\u0623\u0643\u064a\u062f \u0627\u0644\u0641\u0646\u062f\u0642 \u0648\u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u0631\u062d\u0644\u0629 \u0648\u0627\u0644\u062a\u0623\u0645\u064a\u0646 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u064a\u0646 \u0644\u0644\u0645\u0644\u0641\u060c \u0648\u0646\u0646\u0633\u0642 \u0645\u0648\u0627\u0639\u064a\u062f \u0627\u0644\u0645\u062c\u0645\u0648\u0639\u0629. \u0627\u0644\u062a\u0641\u0627\u0635\u064a\u0644 \u0641\u064a <a href=\"https:\/\/arcadia-tour.com\/poland-for-saudis-2026\/\">\u0627\u0644\u0633\u064a\u0627\u062d\u0629 \u0641\u064a \u0628\u0648\u0644\u0646\u062f\u0627 \u0644\u0644\u0633\u0639\u0648\u062f\u064a\u064a\u0646<\/a> \u0648<a href=\"https:\/\/arcadia-tour.com\/\u0627\u0644\u0633\u064a\u0627\u062d\u0629-\u0641\u064a-\u0628\u0648\u0644\u0646\u062f\u0627\/\u0627\u0644\u0641\u064a\u0632\u0627-\u0627\u0648-\u0627\u0644\u062a\u0627\u0634\u064a\u0631\u0647-\u0627\u0644\u0649-\u0628\u0648\u0644\u0646\u062f\u0627\/\">\u062a\u0623\u0634\u064a\u0631\u0629 \u0628\u0648\u0644\u0646\u062f\u0627<\/a>.<\/p>\n<h2>\u0645\u0627 \u0646\u062d\u062a\u0627\u062c\u0647 \u0645\u0646\u0643\u0645 \u0644\u0625\u0631\u0633\u0627\u0644 \u0639\u0631\u0636 \u0627\u0644\u0633\u0639\u0631<\/h2>\n<ol>\n<li>\u0639\u062f\u062f \u0627\u0644\u0623\u0641\u0631\u0627\u062f \u0648\u0623\u0639\u0645\u0627\u0631 \u0627\u0644\u0623\u0637\u0641\u0627\u0644 \u0648\u0643\u0628\u0627\u0631 \u0627\u0644\u0633\u0646 \u0648\u0627\u0644\u062c\u0646\u0633\u064a\u0627\u062a.<\/li>\n<li>\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0633\u0641\u0631 \u0623\u0648 \u0627\u0644\u0634\u0647\u0631 \u0627\u0644\u0645\u0641\u0636\u0644 \u0648\u0639\u062f\u062f \u0627\u0644\u0644\u064a\u0627\u0644\u064a.<\/li>\n<li>\u0645\u062f\u064a\u0646\u0629 \u0627\u0644\u0627\u0646\u0637\u0644\u0627\u0642 \u0648\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0641\u0646\u0627\u062f\u0642.<\/li>\n<li>\u0627\u0644\u0627\u0647\u062a\u0645\u0627\u0645\u0627\u062a: \u0627\u0644\u0645\u062f\u0646\u060c \u0627\u0644\u062c\u0628\u0627\u0644\u060c \u0627\u0644\u062a\u0632\u0644\u062c\u060c \u0627\u0644\u0628\u062d\u0631.<\/li>\n<\/ol>\n<p>\u0646\u0631\u0633\u0644 \u0628\u0631\u0646\u0627\u0645\u062c\u0627\u064b \u064a\u0648\u0645\u0627\u064b \u0628\u064a\u0648\u0645 \u0645\u0639 \u0633\u0639\u0631 \u0627\u0644\u0641\u0631\u062f \u0628\u0627\u0644\u0631\u064a\u0627\u0644 \u062e\u0644\u0627\u0644 48 \u0633\u0627\u0639\u0629.<\/p>\n<h2>\u0627\u0644\u0623\u0633\u0626\u0644\u0629 \u0627\u0644\u0634\u0627\u0626\u0639\u0629<\/h2>\n<p><strong>\u0645\u0627 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u06