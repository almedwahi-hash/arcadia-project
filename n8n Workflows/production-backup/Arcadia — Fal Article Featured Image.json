  "name": "Arcadia — Fal Article Featured Image",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "arcadia-fal-article-image",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-article-image",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "arcadia-fal-article-image"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst destAr = body.destination || body.country || 'كازاخستان';\nconst keyword = body.keyword || body.title || '';\nconst skipImage = body.with_image === false || body.skip_image === true;\n\nconst map = {\n  'كازاخستان': { en: 'Kazakhstan', code: 'KZ', alt: 'سياحة في كازاخستان - أركاديا السياحية' },\n  'Kazakhstan': { en: 'Kazakhstan', code: 'KZ', alt: 'سياحة في كازاخستان - أركاديا السياحية' },\n  'روسيا': { en: 'Russia', code: 'RU', alt: 'سياحة في روسيا - أركاديا السياحية' },\n  'Russia': { en: 'Russia', code: 'RU', alt: 'سياحة في روسيا - أركاديا السياحية' },\n  'بولندا': { en: 'Poland', code: 'PL', alt: 'سياحة في بولندا - أركاديا السياحية' },\n  'Poland': { en: 'Poland', code: 'PL', alt: 'سياحة في بولندا - أركاديا السياحية' },\n  'أوزبكستان': { en: 'Uzbekistan', code: 'UZ', alt: 'سياحة في أوزبكستان - أركاديا السياحية' },\n  'Uzbekistan': { en: 'Uzbekistan', code: 'UZ', alt: 'سياحة في أوزبكستان - أركاديا السياحية' },\n  'الصين': { en: 'China', code: 'CN', alt: 'سياحة في الصين - أركاديا السياحية' },\n  'China': { en: 'China', code: 'CN', alt: 'سياحة في الصين - أركاديا السياحية' },\n};\n\nconst m = map[destAr] || map['كازاخستان'];\nconst prompt = body.prompt || (keyword\n  ? `Professional travel marketing photo illustrating \"${keyword}\", ${m.en}, landscape 4:3, golden hour, photorealistic, no text, no watermark`\n  : `Professional travel marketing photo of ${m.en}, ${m.code}, mountain skyline, golden hour, photorealistic, no text, no watermark`);\n\nreturn [{ json: {\n  destination: m.en,\n  dest_code: m.code,\n  destination_ar: destAr,\n  keyword,\n  prompt,\n  image_alt: keyword || m.alt,\n  skip_image: skipImage,\n  prep: body.prep || null\n}}];"
      },
      "id": "build-article-request",
      "name": "Build Article Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "skip-img",
              "leftValue": "={{ $json.skip_image }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-generate",
      "name": "Generate Image?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fal.run/fal-ai/flux/schnell",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": {{ JSON.stringify($json.prompt) }},\n  \"image_size\": \"landscape_4_3\",\n  \"num_images\": 1,\n  \"enable_safety_checker\": true\n}",
        "options": {}
      },
      "id": "fal-generate",
      "name": "Fal Generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wvIvnVPgtK6IANGR",
          "name": "Arcadia Fal API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Build Article Request').first().json;\nconst fal = $input.first().json;\nconst url = fal.images?.[0]?.url;\nif (!url) throw new Error('No image URL from Fal');\nreturn [{ json: { ...prev, image_url: url } }];"
      },
      "id": "resolve-fal-url",
      "name": "Resolve Fal URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wvIvnVPgtK6IANGR",
          "name": "Arcadia Fal API Key"
        }
      }
    },
    {
      "parameters": {
        "url": "={{ $json.image_url }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "download-image",
      "name": "Download Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1340,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Resolve Fal URL').first().json;\nconst item = $input.first();\nconst binary = item.binary?.data;\nif (!binary) throw new Error('No binary image');\nconst slug = (prev.keyword || prev.destination).toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40);\nreturn [{ json: { ...prev, file_name: `seo-${slug}-${Date.now()}.jpg` }, binary: { data: binary } }];"
      },
      "id": "prep-media",
      "name": "Prep Media Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1560,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://arcadia-tour.com/wp-json/wp/v2/media",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Disposition",
              "value": "=attachment; filename=\"{{ $json.file_name }}\""
            },
            {
              "name": "Content-Type",
              "value": "image/jpeg"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "wp-upload-media",
      "name": "WP Upload Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "isvpER3ODuxP1Usn",
          "name": "WordPress Arcadia"
        }
      },
      "notes": "Use existing WordPress Arcadia credential. Add Host header if WP behind Easypanel."
    },
    {
      "parameters": {
        "jsCode": "const prep = $('Prep Media Upload').first().json;\nconst media = $input.first().json;\nreturn [{ json: {\n  ok: true,\n  featuredMediaId: media.id || 0,\n  image_url: prep.image_url,\n  imageAlt: prep.image_alt,\n  wp_media_url: media.source_url,\n  destination: prep.destination,\n  keyword: prep.keyword,\n  model: 'fal-ai/flux/schnell'\n}}];"
      },
      "id": "format-with-image",
      "name": "Format With Image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Build Article Request').first().json;\nreturn [{ json: {\n  ok: true,\n  featuredMediaId: 0,\n  image_url: null,\n  imageAlt: prev.image_alt,\n  skipped: true,\n  reason: 'with_image:false or skip_image:true'\n}}];"
      },
      "id": "format-skip",
      "name": "Format Skip",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        180
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2220,
        300
      ]
    }
  ],
