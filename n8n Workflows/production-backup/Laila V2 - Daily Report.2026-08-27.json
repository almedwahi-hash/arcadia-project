    {
      "parameters": {
        "jsCode": "const newLeads = $('New Leads Today').all().map(i => i.json);\nconst closedWon = $('Closed Won Today').all().map(i => i.json);\nconst waiting = $('Waiting for Manager').all().map(i => i.json);\n\nconst today = new Date().toLocaleDateString('ar-SA');\n\n// Calculate totals\nconst totalRevenue = closedWon.reduce((sum, l) => sum + (parseFloat(l.offer_amount_usd) || 0), 0);\n\n// Count by stage\nconst offered = newLeads.filter(l => l.stage === 'offered').length;\nconst followup = newLeads.filter(l => ['follow_1','follow_2','follow_3'].includes(l.stage)).length;\nconst lost = newLeads.filter(l => l.stage === 'closed_lost').length;\n\n// Most common objection\nconst objections = newLeads.filter(l => l.objection_type).map(l => l.objection_type);\nconst topObjection = objections.length > 0 ? objections.sort((a,b) => objections.filter(v => v===a).length - objections.filter(v => v===b).length).pop() : 'لا يوجد';\n\n// Most requested destination\nconst destinations = newLeads.filter(l => l.destination).map(l => l.destination);\nconst topDest = destinations.length > 0 ? destinations.sort((a,b) => destinations.filter(v => v===a).length - destinations.filter(v => v===b).length).pop() : 'لا يوجد';\n\n// Conversion rate\nconst convRate = newLeads.length > 0 ? ((closedWon.length / newLeads.length) * 100).toFixed(1) : '0';\n\n// Waiting list details\nlet waitingList = '';\nif (waiting.length > 0) {\n  waitingList = '\\n\\n📋 عملاء ينتظرون ردك:';\n  waiting.forEach(w => {\n    waitingList += `\\n• ${w.name || w.phone} — ${w.destination || 'غير محدد'} — ${w.notes || ''}`;\n  });\n}\n\nconst report = `📊 تقرير اليوم — ${today}\\n\\n` +\n  `👥 عملاء جدد: ${newLeads.length}\\n` +\n  `📋 عروض مرسلة: ${offered}\\n` +\n  `🔄 متابعات: ${followup}\\n` +\n  `✅ صفقات مقفلة: ${closedWon.length}` + (totalRevenue > 0 ? ` — بقيمة $${totalRevenue}` : '') + `\\n` +\n  `❌ خسرنا: ${lost}\\n` +\n  `⏳ ينتظرون ردك: ${waiting.length}\\n\\n` +\n  `📈 معدل التحويل: ${convRate}%\\n` +\n  `🔴 أكثر اعتراض: ${topObjection}\\n` +\n  `🌍 أكثر وجهة: ${topDest}` +\n  waitingList;\n\nreturn [{ json: { report: report } }];"
      },
