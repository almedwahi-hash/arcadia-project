    {
      "parameters": {
        "jsCode": "const CAT_MAP = {\n  'كازاخستان': ['كازاخستان','Kazakhstan','kazakhstan'],\n  'روسيا': ['روسيا','Russia','russia'],\n  'بولندا': ['بولندا','Poland','poland'],\n  'أوزبكستان': ['أوزبكستان','Uzbekistan'],\n  'الصين': ['الصين','China','china'],\n};\n\nfunction stripHtml(s) { return String(s||'').replace(/<[^>]+>/g,'').trim(); }\nfunction matchCat(categories, country) {\n  const names = CAT_MAP[country] || [country];\n  for (const c of categories) for (const n of names)\n    if (c.name.toLowerCase()===n.toLowerCase()||c.slug.toLowerCase()===n.toLowerCase()) return c;\n  for (const c of categories) for (const n of names)\n    if (c.name.toLowerCase().includes(n.toLowerCase())) return c;\n  return null;\n}\n\nconst categoriesRaw = $('Fetch Categories').all().map(i => i.json);\nconst categories = Array.isArray(categoriesRaw[0]) ? categoriesRaw[0] : categoriesRaw;\nconst keepMeta = {};\nfor (const item of $('Plan Get Keep').all()) keepMeta[item.json.id] = item.json.country;\n\nconst updates = [];\nconst alts = [];\nconst russia = { id: 4372, keep: false, reason: '', words_est: 0, slug: '' };\n\nfor (const item of $input.all()) {\n  const post = item.json;\n  const pid = post.id;\n  const country = keepMeta[pid];\n  if (!country) continue;\n\n  if (pid === 4372) {\n    const words = stripHtml(post.content?.rendered||'').split(/\\s+/).filter(Boolean).length;\n    const isDup = /-\\d+$/.test(post.slug||'');\n    russia.words_est = words;\n    russia.slug = post.slug;\n    russia.keep = !isDup && words > 1500;\n    russia.reason = russia.keep ? 'محتوى SEO روسي قوي بدون تكرار' : 'ضعيف أو مكرر';\n    if (!russia.keep) continue;\n  }\n\n  const title = stripHtml(post.title?.rendered);\n  const cat = matchCat(categories, country);\n  const body = {};\n  const applied = [];\n\n  if (cat && !(post.categories||[]).includes(cat.id)) {\n    body.categories = [cat.id, ...(post.categories||[]).filter(c=>c!==cat.id)];\n    applied.push('category→'+cat.name);\n  } else if (cat) applied.push('category_ok:'+cat.name);\n\n  if (post.status !== 'publish') { body.status = 'publish'; applied.push('status→publish'); }\n\n  if (Object.keys(body).length) updates.push({ json: { post_id: pid, body, title, country, applied, url: post.link } });\n\n  const mediaId = post.featured_media || 0;\n  if (mediaId) {\n    const desired = title.includes(country) ? title : title + ' — ' + country;\n    alts.push({ json: { media_id: mediaId, alt_text: desired, post_id: pid } });\n  }\n}\n\nreturn [\n  { json: { phase: 'updates', items: updates.map(u => u.json) } },\n  { json: { phase: 'alts', items: alts.map(a => a.json) } },\n  { json: { phase: 'meta', russia_weather_decision: russia } },\n];"
      },
