        "url": "=https://187.77.64.14/wp-json/wp/v2/posts/{{ $json.id }}?_embed=wp:featuredmedia,wp:term",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
