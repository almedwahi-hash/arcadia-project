        "jsCode": "const KEEP = [\n  { id: 4381, country: 'كازاخستان' },\n  { id: 4372, country: 'روسيا' },\n  { id: 4151, country: 'روسيا' },\n  { id: 3993, country: 'كازاخستان' },\n  { id: 3986, country: 'بولندا' },\n];\nreturn KEEP.map(k => ({ json: k }));"
