    {
      "parameters": {
        "jsCode": "function stripHtml(s) { return String(s||'').replace(/<[^>]+>/g,'').trim(); }\n\nconst trashed = [];\nfor (const item of $('Trash Post').all()) {\n  const p = item.json;\n  trashed.push({ id: p.id, success: p.status === 'trash', status: p.status, title: stripHtml(p.title?.rendered) });\n}\n\nconst kept = [];\nfor (const item of $('Apply Post Update').all()) {\n  const p = item.json;\n  const plan = $('Plan Post Updates').all().find(x => x.json.post_id === p.id);\n  kept.push({\n    id: p.id,\n    url: p.link,\n    title: stripHtml(p.title?.rendered),\n    country: plan?.json.country,\n    applied: plan?.json.applied || [],\n  });\n}\n\n// posts that needed no post-level update but were fetched\nconst meta = $('Build Updates').all().find(i => i.json.phase === 'meta')?.json || {};\nconst russia = meta.russia_weather_decision || null;\n\nconst getKeep = $('Plan Get Keep').all().map(i => i.json.id);\nconst updatedIds = kept.map(k => k.id);\nfor (const item of $('Get Keep Post').all()) {\n  const p = item.json;\n  if (updatedIds.includes(p.id)) continue;\n  if (p.id === 4372 && russia && !russia.keep) continue;\n  if (!getKeep.includes(p.id)) continue;\n  kept.push({ id: p.id, url: p.link, title: stripHtml(p.title?.rendered), applied: ['no_post_update_needed'] });\n}\n\nconst altApplied = [];\nfor (const item of $('Apply Alt Text').all()) {\n  altApplied.push({ media_id: item.json.id, post_id: $('Apply Alt Text').all().find(x=>x.json.id===item.json.id)?.json?.post_id, alt_set: !!item.json.alt_text });\n}\n\nfor (const k of kept) {\n  const alt = altApplied.find(a => $('Plan Alt Updates').all().some(p => p.json.post_id === k.id && p.json.media_id === a.media_id));\n  if (alt) k.applied = [...(k.applied||[]), 'alt_text_set'];\n}\n\nreturn [{ json: {\n  credential: 'n8n:WordPress Arcadia',\n  trashed,\n  kept,\n  russia_weather_decision: russia,\n  originals_checked: [2254,2235,2248,2266,2244].map(id => ({ id, note: 'not touched' })),\n  errors: [],\n}}];"
      },
