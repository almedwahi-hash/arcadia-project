        "jsCode": "const created = Array.isArray($input.first().json) ? $input.first().json[0] : $input.first().json;\nconst ctx = $('Parse Lead Lookup').first().json;\nconst lead = created?.lead_id ? created : ctx.lead;\nreturn [{ json: { ...ctx, lead } }];"
