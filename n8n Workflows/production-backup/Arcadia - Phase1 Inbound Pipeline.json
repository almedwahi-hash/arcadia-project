    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json;\nconst p = j.phase1 || {};\nconst phone = String(p.phone || j.phone || '').trim();\nif (!phone) {\n  return [{ json: { proceed: false, stop_reason: 'missing_phone', phase1: p } }];\n}\nconst providerMessageId = p.provider_message_id ? String(p.provider_message_id).trim() : null;\nreturn [{ json: {\n  ...j,\n  phase1: {\n    phone,\n    channel: p.channel || j.channel || 'whatsapp',\n    provider_message_id: providerMessageId || null,\n    message_text: p.message_text ?? j.text ?? null,\n    message_type: p.message_type || 'text',\n    metadata: p.metadata || {}\n  },\n  has_provider_id: !!(providerMessageId && providerMessageId.length > 0)\n}}];"
      },
