    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const j = $input.first().json;\nconst lead = j.lead || {};\nlet conversationId = lead.conversation_id || null;\nlet patchLead = false;\nif (!conversationId) {\n  conversationId = crypto.randomUUID();\n  patchLead = true;\n}\nconst patchBody = {};\nif (patchLead) patchBody.conversation_id = conversationId;\nif (!lead.customer_id && j.customer_id) patchBody.customer_id = j.customer_id;\nreturn [{ json: {\n  ...j,\n  lead_id: lead.lead_id,\n  customer_id: j.customer_id || lead.customer_id,\n  conversation_id: conversationId,\n  patch_lead: patchLead || Object.keys(patchBody).length > 0,\n  patch_body: patchBody\n}}];"
      },
