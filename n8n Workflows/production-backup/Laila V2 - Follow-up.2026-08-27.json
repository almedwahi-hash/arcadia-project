      "id": "26a31940-5b5a-45da-881e-d0de1dd7c570",
      "name": "Get Pending Follow-ups",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        224,
        0
      ],
      "credentials": {
        "supabaseApi": {
          "id": "z3Tj165JyWLHjSYI",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const leads = $input.all().map(i => i.json);\nconst now = new Date();\nconst hour = now.getUTCHours();\n\n// Don't send between 11PM - 8AM\nif (hour >= 23 || hour < 8) {\n  return [];\n}\n\nconst results = [];\n\nfor (const lead of leads) {\n  if (!lead.phone || !lead.stage) continue;\n  \n  let message = '';\n  let newStage = '';\n  let nextFollowup = null;\n  const name = lead.name || 'عزيزي العميل';\n  const dest = lead.destination || '';\n  \n  switch (lead.stage) {\n    case 'offered':\n      message = `مرحباً ${name}، قدرت تشوف العرض؟ لو عندك أي سؤال أنا موجودة 😊`;\n      newStage = 'follow_1';\n      // Next follow-up in 1 day\n      nextFollowup = new Date(now.getTime() + 24 * 60 * 60 * 1000).toISOString();\n      break;\n      \n    case 'follow_1':\n      message = `أهلاً ${name}، العرض لا زال متاح حالياً. الأسعار تتغير حسب التوفر والموسم — تحب نثبت لك الحجز؟ 😊`;\n      newStage = 'follow_2';\n      // Next follow-up in 3 days\n      nextFollowup = new Date(now.getTime() + 3 * 24 * 60 * 60 * 1000).toISOString();\n      break;\n      \n    case 'follow_2':\n      message = `مرحباً ${name}، عندنا عرض خاص هالأسبوع${dest ? ' على ' + dest : ''}. تحب أعرض لك التفاصيل؟ 🎁`;\n      newStage = 'follow_3';\n      nextFollowup = null; // No more automatic follow-ups\n      break;\n  }\n  \n  if (message) {\n    results.push({\n      json: {\n        phone: lead.phone,\n        message: message,\n        newStage: newStage,\n        nextFollowup: nextFollowup,\n        lead_id: lead.lead_id\n      }\n    });\n  }\n}\n\nreturn results;"
      },
      "id": "63d8ac77-b4c1-41b2-8764-e358d92045d8",
