{
  "updatedAt": "2026-07-02T00:09:11.761Z",
  "createdAt": "2026-07-01T23:24:46.676Z",
  "id": "DC5Hkj1s0GNXc1dh",
  "name": "Arcadia - Fal Destination Video (import template)",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "arcadia-fal-video",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-fal-video",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "arcadia-fal-video"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst dest = body.destination || 'Almaty';\nconst code = (body.dest_code || 'KZ').toUpperCase();\nconst regions = { KZ: 'Kazakhstan', UZ: 'Uzbekistan', KG: 'Kyrgyzstan', TJ: 'Tajikistan' };\nconst region = regions[code] || 'Central Asia';\nconst imagePrompt = body.image_prompt || `Professional travel marketing photo of ${dest}, ${region}, golden hour, photorealistic, no text`;\nconst videoPrompt = body.prompt || body.video_prompt || `Cinematic travel video of ${dest}, ${region}, slow aerial pan, golden hour, smooth tourism promo motion, no text`;\nreturn [{ json: { destination: dest, dest_code: code, image_prompt: imagePrompt, video_prompt: videoPrompt, image_url: body.image_url || null } }];"
      },
      "id": "build-video-prompts",
      "name": "Build Prompts",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-image",
              "leftValue": "={{ $json.image_url }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-has-image",
      "name": "Has Image URL?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fal.run/fal-ai/flux/schnell",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": \"{{ $json.image_prompt }}\",\n  \"image_size\": \"landscape_4_3\",\n  \"num_images\": 1,\n  \"enable_safety_checker\": true\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "fal-hero-image",
      "name": "Fal Hero Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        420
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wvIvnVPgtK6IANGR",
          "name": "Arcadia Fal API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Build Prompts').first().json;\nconst fal = $input.first().json;\nconst imageUrl = fal.images?.[0]?.url;\nif (!imageUrl) throw new Error('Hero image generation failed');\nreturn [{ json: { ...prev, image_url: imageUrl } }];"
      },
      "id": "merge-hero-url",
      "name": "Set Hero URL",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        420
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nif (!item.image_url) throw new Error('image_url required for video');\nreturn [{ json: item }];"
      },
      "id": "prepare-video",
      "name": "Prepare Video Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://queue.fal.run/fal-ai/minimax/video-01/image-to-video",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": \"{{ $json.video_prompt }}\",\n  \"image_url\": \"{{ $json.image_url }}\"\n}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "fal-video-submit",
      "name": "Fal Submit Video",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wvIvnVPgtK6IANGR",
          "name": "Arcadia Fal API Key"
        }
      },
      "notes": "Returns request_id - poll in next nodes or use Wait + HTTP loop"
    },
    {
      "parameters": {
        "amount": 30,
        "unit": "seconds"
      },
      "id": "wait-video",
      "name": "Wait 30s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1780,
        300
      ],
      "webhookId": "arcadia-fal-video-wait"
    },
    {
      "parameters": {
        "url": "={{ $('Fal Submit Video').item.json.response_url }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 120000
        },
        "method": "GET"
      },
      "id": "fal-video-result",
      "name": "Fal Get Video Result",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2000,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wvIvnVPgtK6IANGR",
          "name": "Arcadia Fal API Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const prev = $('Prepare Video Input').first().json;\nconst fal = $input.first().json;\nconst videoUrl = fal.video?.url;\nif (!videoUrl) {\n  return [{ json: { ok: false, status: 'processing', message: 'Video still processing - retry webhook or extend Wait node', destination: prev.destination, image_url: prev.image_url } }];\n}\nreturn [{\n  json: {\n    ok: true,\n    destination: prev.destination,\n    dest_code: prev.dest_code,\n    video_url: videoUrl,\n    image_url: prev.image_url,\n    model: 'fal-ai/minimax/video-01/image-to-video',\n    local_hint: 'Use video_url in WhatsApp/social or upload to Supabase generated-media/videos/'\n  }\n}];"
      },
      "id": "format-video-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-video-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        2440,
        300
      ]
    }
  ],
