  "name": "Arcadia - Laila Destination Image (import template)",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "arcadia-laila-destination-image",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-laila-image",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "arcadia-laila-destination-image"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst rawText = (body.message || body.text || body.user_message || '').trim();\nconst phone = body.phone || body.from || null;\n\nlet dest = body.destination || null;\nlet code = (body.dest_code || body.destination_code || 'KZ').toUpperCase();\n\nconst CITY_MAP = {\n  'almaty': ['Almaty', 'KZ'],\n  'astana': ['Astana', 'KZ'], 'nursultan': ['Astana', 'KZ'],\n  'tashkent': ['Tashkent', 'UZ'],\n  'samarkand': ['Samarkand', 'UZ'],\n  'bishkek': ['Bishkek', 'KG']\n};\n\nif (!dest && rawText) {\n  const lower = rawText.toLowerCase();\n  for (const [key, [city, c]] of Object.entries(CITY_MAP)) {\n    if (lower.includes(key)) {\n      dest = city;\n      code = c;\n      break;\n    }\n  }\n}\n\nconst VISUAL_RE = /(picture|photo|image|show me|see|visual|\\u0635\\u0648\\u0631\\u0629|\\u0635\\u0648\\u0631|\\u0634\\u0648\\u0641|\\u0639\\u0631\\u0636)/iu;\nconst explicitToolCall = !!(body.destination && (body.dest_code || body.destination_code));\nconst wantsVisual = body.force === true || body.generate_image === true || explicitToolCall || VISUAL_RE.test(rawText);\n\nif (!dest) dest = 'Almaty';\n\nconst regions = { KZ: 'Kazakhstan', UZ: 'Uzbekistan', KG: 'Kyrgyzstan', TJ: 'Tajikistan' };\nconst region = regions[code] || 'Central Asia';\nconst prompt = body.prompt || `Professional travel marketing photo of ${dest}, ${region}, mountain skyline, golden hour, photorealistic tourism brochure, no text, no watermark`;\n\nreturn [{\n  json: {\n    phone,\n    destination: dest,\n    dest_code: code,\n    prompt,\n    wants_visual: wantsVisual,\n    user_message: rawText,\n    skip: !wantsVisual && !body.force\n  }\n}];"
      },
      "id": "parse-laila-request",
      "name": "Parse Laila Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
