    {
      "parameters": {
        "jsCode": "const fal = $input.first().json;\nconst prev = $('Parse Laila Request').first().json;\nconst url = fal.images?.[0]?.url;\nif (!url) throw new Error('No image URL from Fal');\n\nconst cityAr = { Almaty: '??????', Astana: '??????', Tashkent: '?????', Samarkand: '??????', Bishkek: '???kek' }[prev.destination] || prev.destination;\n\nreturn [{\n  json: {\n    ok: true,\n    destination: prev.destination,\n    destination_ar: cityAr,\n    dest_code: prev.dest_code,\n    image_url: url,\n    whatsapp_caption: `??? ${cityAr} - Arcadia Tours\\n${url}`,\n    laila_reply_hint: `???? ??????: \"???? ???? ${cityAr}!\" ?? ???? ?????? ?? ???? ??????`,\n    model: 'fal-ai/flux/schnell',\n    phone: prev.phone\n  }\n}];"
      },
