  "name": "Arcadia - Fal Destination Image (import template)",
  "active": true,
  "isArchived": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "arcadia-fal-image",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-fal-image",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "arcadia-fal-image"
    },
    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst dest = body.destination || 'Almaty';\nconst code = (body.dest_code || 'KZ').toUpperCase();\nconst regions = { KZ: 'Kazakhstan', UZ: 'Uzbekistan', KG: 'Kyrgyzstan', TJ: 'Tajikistan' };\nconst region = regions[code] || 'Central Asia';\nconst prompt = body.prompt || `Professional travel marketing photo of ${dest}, ${region}, mountain skyline, golden hour, photorealistic, no text, no watermark`;\nreturn [{ json: { destination: dest, dest_code: code, prompt } }];"
      },
      "id": "build-prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://fal.run/fal-ai/flux/schnell",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"prompt\": \"{{ $json.prompt }}\",\n  \"image_size\": \"landscape_4_3\",\n  \"num_images\": 1,\n  \"enable_safety_checker\": true\n}",
        "options": {}
      },
      "id": "fal-http",
      "name": "Fal Generate Image",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "wvIvnVPgtK6IANGR",
          "name": "Arcadia Fal API Key"
        }
      },
      "notes": "Create Header Auth credential: Name=Authorization, Value=Key <FAL_KEY from n8n env>"
    },
    {
      "parameters": {
        "jsCode": "const fal = $input.first().json;\nconst prev = $('Build Prompt').first().json;\nconst url = fal.images?.[0]?.url;\nif (!url) throw new Error('No image URL from Fal');\nreturn [{\n  json: {\n    ok: true,\n    destination: prev.destination,\n    dest_code: prev.dest_code,\n    image_url: url,\n    width: fal.images[0].width,\n    height: fal.images[0].height,\n    model: 'fal-ai/flux/schnell',\n    local_hint: 'Download server-side or use URL in WhatsApp/Laila reply'\n  }\n}];"
      },
      "id": "format-response",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        300
      ]
    }
  ],
