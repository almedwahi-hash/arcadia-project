      "id": "c9de00e9-e7d2-401f-a728-b96881be256f",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        -656,
        304
      ],
      "webhookId": "contract-trigger-hook",
      "credentials": {
        "telegramApi": {
          "id": "TU1NkHGYdUXtFy9Q",
          "name": "Telegram account 3"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst upd = $input.first().json;\nconst msg = upd.message || {};\nconst chatId = msg.chat?.id;\nconst text = (msg.text || '').trim();\n\n// Text approval commands: \"موافق UUID\" or \"رفض UUID\"\nif (text) {\n  const approveMatch = text.match(/^(موافق|approve)\\s+([a-f0-9-]{8,})/i);\n  const rejectMatch  = text.match(/^(رفض|reject)\\s+([a-f0-9-]{8,})/i);\n\n  if (approveMatch) {\n    return [{ json: { isApproval: true, action: 'approve', contractId: approveMatch[2], chatId, skip: false } }];\n  }\n  if (rejectMatch) {\n    return [{ json: { isApproval: true, action: 'reject', contractId: rejectMatch[2], chatId, skip: false } }];\n  }\n  return []; // ignore other texts\n}\n\n// Document upload\nif (!msg.document) return [];\n\nconst doc = msg.document;\nconst fileName = doc.file_name || 'contract.pdf';\nconst ext = fileName.split('.').pop().toLowerCase();\n\nif (!['pdf', 'xlsx', 'xls'].includes(ext)) {\n  return [{ json: {\n    isApproval: false, skip: true, chatId,\n    error: `❌ نوع الملف .${ext} غير مدعوم. أرسل PDF أو Excel فقط.`\n  }}];\n}\n\nreturn [{ json: {\n  isApproval: false, skip: false, chatId,\n  fileId: doc.file_id, fileName,\n  mimeType: doc.mime_type || 'application/pdf', ext\n}}];\n"
      },
