      "id": "dc6fccbd-1314-4078-b697-36fe63bb3f41",
      "name": "Download File",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst binaryData = $input.first().binary;\nconst checkFile = $('Check File Type').item.json;\nconst ext = (checkFile.ext || 'pdf').toLowerCase();\n\nconst mimeMap = {\n  'pdf':  'application/pdf',\n  'xlsx': 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',\n  'xls':  'application/vnd.ms-excel'\n};\n// Use TELEGRAM metadata mimeType (correct) — HTTP response always returns octet-stream\nconst mimeType = mimeMap[ext] || checkFile.mimeType || 'application/pdf';\n\nlet base64Data = '';\nif (binaryData) {\n  const firstKey = Object.keys(binaryData)[0];\n  if (firstKey) base64Data = binaryData[firstKey].data || '';\n}\nif (!base64Data) throw new Error('فشل تحميل الملف — binary data فارغ');\n\nconst prompt = `أنت خبير في تحليل عقود الفنادق السياحية. استخرج من هذا الملف المعلومات التالية بدقة تامة وأرجع JSON فقط.\n\nالشكل المطلوب:\n{\n  \"hotel_name\": \"اسم الفندق بالإنجليزي\",\n  \"hotel_name_ar\": \"اسم الفندق بالعربي أو null\",\n  \"destination\": \"اسم المدينة بالإنجليزي\",\n  \"star_rating\": 4,\n  \"contract_start\": \"YYYY-MM-DD\",\n  \"contract_end\": \"YYYY-MM-DD\",\n  \"currency\": \"RUB أو USD أو EUR\",\n  \"rooms\": [{\"room_type\":\"SNG/DBL/TRP\",\"room_name\":\"...\",\"max_adults\":2}],\n  \"seasons\": [\n    {\n      \"season_name\": \"اسم الموسم\",\n      \"start_date\": \"YYYY-MM-DD\",\n      \"end_date\": \"YYYY-MM-DD\",\n      \"rates\": [{\"room_type\":\"SNG\",\"meal_plan\":\"BB/RO/HB\",\"sgl_rate\":1000,\"dbl_rate\":1500,\"extra_adult\":300,\"extra_child\":150}]\n    }\n  ],\n  \"markup_percent\": 15,\n  \"commission_percent\": 10,\n  \"notes\": \"ملاحظات مهمة أو null\"\n}\n\nلا تضف أي نص قبل أو بعد JSON. قيم غير موجودة = null.`;\n\nreturn [{ json: { mimeType, base64Data, prompt, chatId: checkFile.chatId, fileName: checkFile.fileName, ext } }];\n"
      },
      "id": "a6c5d7df-327f-4b5c-aeb3-ae63d7c532d8",
      "name": "Prepare Gemini Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
