    {
      "parameters": {
        "method": "POST",
        "url": "=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={{ $env.GEMINI_API_KEY }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"contents\": [{\n    \"parts\": [\n      {\n        \"inline_data\": {\n          \"mime_type\": \"{{ $json.mimeType }}\",\n          \"data\": \"{{ $json.base64Data }}\"\n        }\n      },\n      {\n        \"text\": {{ JSON.stringify($json.prompt) }}\n      }\n    ]\n  }],\n  \"generationConfig\": {\n    \"temperature\": 0.1,\n    \"maxOutputTokens\": 65536\n  }\n}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "5c08e154-ad30-4dc9-a808-ecb318431f5b",
      "name": "Gemini Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1560,
        500
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst geminiResp = $input.first().json;\nconst prev = $('Prepare Gemini Request').item.json;\n\nlet rawText = '';\ntry {\n  rawText = geminiResp.candidates[0].content.parts[0].text;\n} catch(e) {\n  return [{ json: { success:false, chatId:prev.chatId, fileName:prev.fileName, error:'فشل قراءة Gemini: '+e.message } }];\n}\n\n// Clean markdown fences\nlet clean = rawText.trim().replace(/^```(?:json)?\\n?/, '').replace(/\\n?```$/, '').trim();\n\n// Try to fix truncated JSON by finding last valid closing brace\nfunction tryParse(str) {\n  try { return JSON.parse(str); } catch(e) { return null; }\n}\n\nlet data = tryParse(clean);\n\n// If failed, try trimming to last complete property\nif (!data) {\n  // Find last complete '}' at depth 0 of the outer object\n  let depth = 0, lastValid = -1;\n  for (let i = 0; i < clean.length; i++) {\n    if (clean[i] === '{') depth++;\n    else if (clean[i] === '}') { depth--; if (depth === 0) lastValid = i; }\n  }\n  if (lastValid > 0) {\n    data = tryParse(clean.slice(0, lastValid + 1));\n  }\n}\n\nif (!data) {\n  return [{ json: { success:false, chatId:prev.chatId, fileName:prev.fileName, error:'JSON غير صالح من Gemini' } }];\n}\n\nconst missing = ['hotel_name','destination','contract_start','contract_end'].filter(f=>!data[f]);\nif (missing.length) {\n  return [{ json: { success:false, chatId:prev.chatId, fileName:prev.fileName, error:'بيانات ناقصة: '+missing.join(', ') } }];\n}\n\nconst roomsCount = (data.rooms||[]).length;\nconst seasonsCount = (data.seasons||[]).length;\n\nlet summary = '📋 *تم استخراج بيانات العقد*\\n\\n';\nsummary += '🏨 *الفندق:* ' + data.hotel_name;\nif (data.hotel_name_ar) summary += ' (' + data.hotel_name_ar + ')';\nsummary += '\\n📍 *الوجهة:* ' + data.destination;\nsummary += '\\n⭐ *التصنيف:* ' + (data.star_rating||'—') + ' نجوم';\nsummary += '\\n📅 *العقد:* ' + data.contract_start + ' → ' + data.contract_end;\nsummary += '\\n💰 *العملة:* ' + (data.currency||'—');\nsummary += '\\n🛏 *الغرف:* ' + roomsCount;\nsummary += '\\n📆 *المواسم:* ' + seasonsCount;\nif (data.notes) summary += '\\n📝 ' + data.notes;\n\nreturn [{ json: {\n  success: true, chatId: prev.chatId, fileName: prev.fileName, summary,\n  raw_extracted: JSON.stringify(data),\n  hotel_name: data.hotel_name, hotel_name_ar: data.hotel_name_ar||null,\n  destination: data.destination, star_rating: data.star_rating||null,\n  contract_start: data.contract_start, contract_end: data.contract_end\n}}];\n"
      },
