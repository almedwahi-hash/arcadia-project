    {
      "parameters": {
        "jsCode": "const prev = $('Build Request').first().json;\nconst fal = $input.first().json;\nconst url = prev.image_url || fal.images?.[0]?.url;\nif (!url) throw new Error('No image URL');\nreturn [{ json: { ...prev, image_url: url, width: fal.images?.[0]?.width, height: fal.images?.[0]?.height } }];"
      },
