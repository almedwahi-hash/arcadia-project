    {
      "parameters": {
        "jsCode": "const prev = $('Resolve Image URL').first().json;\nconst item = $input.first();\nconst binary = item.binary?.data;\nif (!binary) throw new Error('No binary image data');\nconst slug = prev.destination.toLowerCase().replace(/[^a-z0-9]+/g, '-');\nconst fileName = `${slug}-hero.jpg`;\nreturn [{ json: { ...prev, supabase_object: `destinations/${fileName}` }, binary: { data: binary } }];"
      },
