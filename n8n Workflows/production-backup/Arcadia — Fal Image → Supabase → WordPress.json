    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst dest = body.destination || 'Almaty';\nconst code = (body.dest_code || 'KZ').toUpperCase();\n\n// Map to WP page IDs — keep in sync with config/destinations.json\nconst WP_MAP = {\n  almaty: { page_id: 755, alt_ar: 'جبال ألماتي كازاخستان - أركاديا السياحية', name: 'Almaty' },\n  astana: { page_id: 755, alt_ar: 'أبراج أستانا كازاخستان - أركاديا السياحية', name: 'Astana' },\n  kazakhstan: { page_id: 755, alt_ar: 'سياحة في كازاخستان ألماتي - أركاديا السياحية', name: 'Kazakhstan' },\n  tashkent: { page_id: 157, alt_ar: 'طشقند أوزبكستان - أركاديا السياحية', name: 'Tashkent' },\n  samarkand: { page_id: 157, alt_ar: 'ساحة ريجستان سمرقند - أركاديا السياحية', name: 'Samarkand' },\n  uzbekistan: { page_id: 157, alt_ar: 'سياحة في سمرقند وبخارى - أركاديا السياحية', name: 'Uzbekistan' },\n  russia: { page_id: 153, alt_ar: 'سياحة في موسكو وسانت بطرسبرغ - أركاديا السياحية', name: 'Russia' },\n  poland: { page_id: 155, alt_ar: 'سياحة في بولندا كراكوف ووارسو - أركاديا السياحية', name: 'Poland' },\n  china: { page_id: 3359, alt_ar: 'سياحة في الصين مع مرافق عربي - أركاديا السياحية', name: 'China' },\n};\n\nconst key = dest.toLowerCase().replace(/[^a-z]/g, '');\nconst mapped = WP_MAP[key] || WP_MAP.almaty;\nconst regions = { KZ: 'Kazakhstan', UZ: 'Uzbekistan', KG: 'Kyrgyzstan', RU: 'Russia', PL: 'Poland', CN: 'China' };\nconst region = regions[code] || 'Central Asia';\nconst prompt = body.prompt || `Professional travel marketing photo of ${mapped.name}, ${region}, golden hour, photorealistic, no text, no watermark`;\nconst skipWp = Boolean(body.skip_wp);\nconst skipSupabase = Boolean(body.skip_supabase);\n\nreturn [{ json: {\n  destination: mapped.name,\n  dest_code: code,\n  prompt,\n  wp_page_id: body.wp_page_id || mapped.page_id,\n  image_alt_ar: mapped.alt_ar,\n  skip_wp: skipWp,\n  skip_supabase: skipSupabase,\n  image_url: body.image_url || null\n}}];"
      },
