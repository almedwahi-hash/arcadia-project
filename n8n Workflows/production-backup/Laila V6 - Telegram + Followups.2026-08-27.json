        "body": "={{ $json.geminiBody }}",
        "options": {}
      },
      "id": "gemini",
      "name": "Gemini 1.5 Pro",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "var res = $input.item.json;\nvar parts = (res && res.candidates && res.candidates[0] && res.candidates[0].content && res.candidates[0].content.parts) || [];\nvar draft = parts.map(function(p){ return p.text || ''; }).join('');\nvar parsed = $node['Parse Telegram'].json;\nvar toolRegex = /TOOL:get_price:(\\{[^\\}]*\\})/;\nvar m = draft.match(toolRegex);\nvar needsPrice = false; var priceArgs = null;\nif (m) { try { priceArgs = JSON.parse(m[1]); needsPrice = true; } catch(e) {} }\nreturn [{ json: { phone: parsed.phone, chatId: parsed.chatId, draft: draft.replace(toolRegex,'').trim(), needsPrice: needsPrice, priceArgs: priceArgs } }];"
      },
      "id": "extract",
      "name": "Extract & Route",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1984,
