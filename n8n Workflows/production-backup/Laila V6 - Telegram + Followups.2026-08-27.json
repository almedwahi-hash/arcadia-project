          "name": "Arcadia Laila Sales Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "var msg = $input.item.json.message || {};\nvar chatId = msg.chat ? msg.chat.id : null;\nvar text = (msg.text || '').trim();\nvar from = msg.from || {};\nif (!chatId || !text) return [];\nreturn [{ json: { phone: 'tg:' + chatId, chatId: chatId, textContent: text, firstName: from.first_name || null, username: from.username || null } }];"
      },
      "id": "parse",
      "name": "Parse Telegram",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "var d = $input.item.json;\nvar SUPABASE_URL = 'https://xfibcjhshpmqkrhlpsoa.supabase.co';\nvar SUPABASE_KEY = 'eyJ-REDACTED-SERVICE-ROLE';\n\nfunction normalizePhone(p, chatId) {\n  let s = (p ?? '').toString().trim();\n  if (!s && chatId !== undefined && chatId !== null) s = String(chatId);\n  if (s.startsWith('tg:')) s = s.slice(3);\n  s = s.replace(/[^\\d]/g, '');\n  return s || null;\n}\n\nvar phone = normalizePhone(d.phone, d.chatId);\n\nvar body = {\n  phone,\n  source: 'telegram',\n  stage: 'new',\n  assigned_to: 'laila',\n  last_contact: new Date().toISOString(),\n  telegram_chat_id: d.chatId,\n  telegram_username: d.username || null,\n  name: d.fullName || d.firstName || null,\n};\n\nawait this.helpers.httpRequest({\n  method: 'POST',\n  url: SUPABASE_URL + '/rest/v1/leads?on_conflict=phone',\n  headers: {\n    apikey: SUPABASE_KEY,\n    Authorization: 'Bearer ' + SUPABASE_KEY,\n    'Content-Type': 'application/json',\n    Prefer: 'resolution=merge-duplicates,return=minimal',\n  },\n  body: JSON.stringify(body),\n});\n\nreturn [{ json: d }];"
      },
      "id": "build-lead",
      "name": "Upsert Lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "var d = $node['Parse Telegram'].json;\nvar SUPABASE_URL = 'https://xfibcjhshpmqkrhlpsoa.supabase.co';\nvar SUPABASE_KEY = 'eyJ-REDACTED-SERVICE-ROLE';\nawait this.helpers.httpRequest({\n  method: 'POST',\n  url: SUPABASE_URL + '/rest/v1/conversations',\n  headers: { apikey: SUPABASE_KEY, Authorization: 'Bearer ' + SUPABASE_KEY, 'Content-Type': 'application/json', Prefer: 'return=minimal' },\n  body: JSON.stringify({ phone: d.phone, channel: 'telegram', role: 'user', message: d.textContent })\n});\nreturn [{ json: { phone: d.phone, chatId: d.chatId, textContent: d.textContent, firstName: d.firstName } }];"
      },
