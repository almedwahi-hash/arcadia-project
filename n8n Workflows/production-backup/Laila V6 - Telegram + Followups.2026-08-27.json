      "id": "get-history",
      "name": "Get Chat History",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1328,
        304
      ]
    },
    {
      "parameters": {
        "jsCode": "var parsed = $node['Parse Telegram'].json;\nvar histRaw = $input.item.json;\nvar rows = Array.isArray(histRaw) ? histRaw : [];\nvar chatHistory = rows.map(function(m){ return (m.role==='user'?'العميل':'ليلى') + ': ' + m.message; }).join('\\n');\nvar SYSTEM = 'انتِ ليلى، موظفة مبيعات في اركاديا للسياحة. خليجية ودودة ذكية.\\nقواعد:\\n- سؤال واحد فقط في كل رسالة\\n- اذا احتجتِ سعر اكتبي في سطر منفصل: TOOL:get_price:{}\\n- ممنوع تخترعي اسعار\\n- الوجهات: كازاخستان(KZ) روسيا(RU) بولندا(PL) اوزبكستان(UZ)';\nvar userMsg = SYSTEM + '\\n\\nالمحادثة السابقة:\\n' + chatHistory + '\\n\\nرسالة العميل:\\n' + parsed.textContent;\nvar geminiBody = JSON.stringify({ contents: [{ role: 'user', parts: [{ text: userMsg }] }], generationConfig: { temperature: 0.6, maxOutputTokens: 800 } });\nreturn [{ json: { phone: parsed.phone, chatId: parsed.chatId, textContent: parsed.textContent, geminiBody: geminiBody } }];"
      },
      "id": "build-prompt",
      "name": "Build Gemini Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1552,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=AIzaSyAOJUNGg2rMsAOiIWi84g_d4nASuKRRH08",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
