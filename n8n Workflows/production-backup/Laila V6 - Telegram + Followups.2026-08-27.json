    {
      "parameters": {
        "jsCode": "var calc = $input.item.json;\nvar prev = $node['Extract & Route'].json;\nfunction findNum(o){ if(!o)return null; if(typeof o==='number')return o; if(Array.isArray(o)){for(var i=0;i<o.length;i++){var v=findNum(o[i]);if(v!=null)return v;}} if(typeof o==='object'){var ks=Object.keys(o);for(var i=0;i<ks.length;i++){var v=findNum(o[ks[i]]);if(v!=null)return v;}} return null; }\nvar price = findNum(calc && calc.data && calc.data.resultData);\nvar response = price ? (prev.draft||'') + '\\n\\n\\u{1F4B0} السعر التقريبي: $' + Math.round(price) + ' للشخص' : (prev.draft || 'تمام! خليني اتاكد من السعر وارجعلك');\nreturn [{ json: { phone: prev.phone, chatId: prev.chatId, response: response } }];"
      },
