      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Build Phase1 payload from scenario POST body (Evolution API or Meta WA format)\nconst body = $input.first().json.body || $input.first().json;\nconst scenario = body.scenario || 'custom';\nconst data = body.data || body;\nconst key = data.key || {};\nconst waMsg = body.entry?.[0]?.changes?.[0]?.value?.messages?.[0];\nconst phone = String(body.phone || key.remoteJid?.replace('@s.whatsapp.net','') || waMsg?.from || '').trim();\nconst providerMessageId = body.provider_message_id || key.id || waMsg?.id || null;\nconst text = body.text || body.textContent || waMsg?.text?.body || '';\nreturn [{ json: {\n  scenario,\n  phone,\n  textContent: text,\n  remoteJid: phone ? phone + '@s.whatsapp.net' : null,\n  phase1: {\n    phone,\n    provider_message_id: providerMessageId ? String(providerMessageId) : null,\n    channel: body.channel || 'whatsapp',\n    message_text: text,\n    message_type: body.message_type || 'text',\n    metadata: { scenario, test: true }\n  }\n}}];"
      },
