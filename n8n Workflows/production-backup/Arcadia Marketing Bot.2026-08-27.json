    {
      "parameters": {
        "jsCode": "const upd = $input.item.json;\nconst cbCountryMap = {\n  kz: 'كازاخستان', ru: 'روسيا', pl: 'بولندا', uz: 'أوزبكستان', cn: 'الصين',\n};\n\nif (upd.callback_query) {\n  const cb = upd.callback_query.data || '';\n  const msgId = upd.callback_query.message?.message_id;\n  const chatId = upd.callback_query.message?.chat?.id || 493831958;\n  const callbackId = upd.callback_query.id;\n\n  if (cb.startsWith('seo_approve_')) {\n    return [{ json: { cmd: 'seo_approve', postId: cb.replace('seo_approve_',''), chatId, msgId, callbackId } }];\n  }\n  if (cb.startsWith('seo_reject_')) {\n    return [{ json: { cmd: 'seo_reject', postId: cb.replace('seo_reject_',''), chatId, msgId, callbackId } }];\n  }\n\n  if (cb.startsWith('seo_pick_')) {\n    const code = cb.slice('seo_pick_'.length).toLowerCase();\n    const country = cbCountryMap[code];\n    if (country) {\n      return [{ json: { cmd: 'seo_country', country, chatId, msgId, callbackId } }];\n    }\n  }\n\n  if (cb.startsWith('seo_pick:')) {\n    const code = cb.slice('seo_pick:'.length).toLowerCase();\n    const country = cbCountryMap[code];\n    if (country) {\n      return [{ json: { cmd: 'seo_country', country, chatId, msgId, callbackId } }];\n    }\n  }\n\n  return [{ json: { cmd: 'unknown_callback', chatId, msgId, callbackId, raw: cb } }];\n}\n\nconst msg = upd.message || {};\nconst chatId = msg.chat?.id || 493831958;\nconst text = (msg.text || '').trim();\nconst msgId = msg.message_id;\nconst countryMap = {\n  'كازاخستان':'كازاخستان','kazakhstan':'كازاخستان','kz':'كازاخستان',\n  'روسيا':'روسيا','russia':'روسيا','ru':'روسيا',\n  'بولندا':'بولندا','poland':'بولندا','pl':'بولندا',\n  'أوزبكستان':'أوزبكستان','uzbekistan':'أوزبكستان','uz':'أوزبكستان',\n  'الصين':'الصين','china':'الصين','cn':'الصين','صين':'الصين',\n};\n\nconst posterMatch = text.match(/^(?:بوستر|poster|generate|\\/generate)\\s+(.+)$/i);\nif (posterMatch) {\n  const rawCountry = posterMatch[1].trim().toLowerCase();\n  const country = countryMap[rawCountry];\n  if (country) {\n    return [{ json: { cmd: 'poster_country', country, chatId, msgId, callbackId: '' } }];\n  }\n}\n\nconst seoMatch = text.match(/^(?:مقال[ةه]?|article|seo)\\s+(.+)$/iu);\nif (seoMatch) {\n  const rawCountry = seoMatch[1].trim();\n  const country = countryMap[rawCountry.toLowerCase()] || countryMap[rawCountry];\n  if (country) return [{ json: { cmd: 'seo_country', country, chatId, msgId, callbackId: '' } }];\n}\n\nconst plain = countryMap[text.toLowerCase()] || countryMap[text.trim()];\nif (plain) return [{ json: { cmd: 'seo_country', country: plain, chatId, msgId, callbackId: '' } }];\n\nconst cmd = text.startsWith('/') ? text.slice(1).toLowerCase().split(' ')[0] : text.toLowerCase().replace(/\\s+/g,'');\nreturn [{ json: { cmd, chatId, msgId, text } }];"
      },
